# I/O is four words over a namespace. Run with:
#   wack run examples/files.wack --mount ex=examples
: main ( -- )
  "/mnt/ex" ls drop
  "/mnt/ex/hello.wack" read-file
  0 i32.eq [ "--- hello.wack ---" println print ] [ drop "could not read" println ] if
  "elapsed check: " print
  now now i64.le_s [ "time moves forward" ] [ "time went backwards" ] if println ;
