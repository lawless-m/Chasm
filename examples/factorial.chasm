# n! for n in 0 to 20, as i64, recursively and iteratively.
# Rosetta Code: Factorial. Exercises: recursion with a declared effect,
# i64, widening an i32 with the `i64` word.
# Above 20, n! does not fit in i64 and i64.mul wraps silently, as wasm's
# does: 21! comes out negative and 66! onward is 0. Nothing traps.

: fact-rec ( i32 -- i64 )
  :> n
  n 2 i32.lt_s [ 1 i64 ] [ n 1 i32.sub fact-rec  n i64 i64.mul ] if ;
test fact-rec : 0 fact-rec -> 1 i64
test fact-rec : 5 fact-rec -> 120 i64
test fact-rec : 20 fact-rec -> 2432902008176640000 i64

: fact-iter ( i32 -- i64 )
  :> n
  1 i64 :> acc!
  n [ 1 i32.add i64 acc i64.mul acc! ] times   # times 1 to n
  acc ;
test fact-iter : 0 fact-iter -> 1 i64
test fact-iter : 5 fact-iter -> 120 i64
test fact-iter : 20 fact-iter -> 2432902008176640000 i64
test fact-iter : 21 fact-iter -> -4249290049419214848 i64   # wrapped: 21! mod 2^64

# The two agree everywhere in range.
: agree? ( -- i32 )
  1 :> ok!
  21 [ :> i  i fact-rec i fact-iter i64.ne [ 0 ok! ] when ] times
  ok ;
test agree? : agree? -> 1

: main ( -- )
  21 [ :> i  i i32.to-str print "! = " print i fact-iter i64.to-str println ] times ;
