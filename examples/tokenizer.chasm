# Tokenise a small expression language: integers, identifiers and
# + - * / ( ), each token with its kind, offset and length.
# Rosetta Code: none (Parsing/Lexical_analyzer is close). Exercises: a state
# machine over bytes, a predicate passed as a function value, trap with a
# position, a struct and an array of structs.

: digit? ( i32 -- i32 )  :> c  c 48 i32.ge_u  c 57 i32.le_u  i32.and ;
: alpha? ( i32 -- i32 )
  :> c
  c 65 i32.ge_u  c 90 i32.le_u  i32.and
  c 97 i32.ge_u  c 122 i32.le_u  i32.and  i32.or
  c 95 i32.eq  i32.or ;                        # _
: alnum? ( i32 -- i32 )  dup alpha? swap digit? i32.or ;
: op? ( i32 -- i32 )
  :> c
  c 43 i32.eq  c 45 i32.eq i32.or  c 42 i32.eq i32.or
  c 47 i32.eq i32.or  c 40 i32.eq i32.or  c 41 i32.eq i32.or ;

# The first offset from i whose byte fails pred.
: skip ( str i32 [ i32 -- i32 ] -- i32 )
  :> pred :> i! :> s
  [ i s str.len i32.lt_u [ s i str.byte-at pred call ] [ 0 ] if ] [ i 1 i32.add i! ] while
  i ;
test skip : "abc12+" 0 'alnum? skip -> 5

# Token kinds.
: NUM ( -- i32 ) 1 ;
: IDENT ( -- i32 ) 2 ;
: OP ( -- i32 ) 3 ;

# A token: its kind, and where it is in the source.
struct token  kind: i32  start: i32  len: i32

: tokenize ( str -- array token )
  :> s
  s str.len array.new ( array token ) :> toks     # at most one token per byte
  0 :> n!
  0 :> i!
  [ i s str.len i32.lt_u ]
  [ s i str.byte-at :> c
    i :> start
    c 32 i32.eq [ i 1 i32.add i!  0 ] [
    c digit?    [ s i 'digit? skip i!  NUM ] [
    c alpha?    [ s i 'alnum? skip i!  IDENT ] [
    c op?       [ i 1 i32.add i!  OP ]
                [ "unexpected character at " i i32.to-str str.concat trap ]
    if ] if ] if ] if :> kind
    kind
    [ toks n  kind start i start i32.sub token.new  array.at!
      n 1 i32.add n! ]
    when ]
  while
  toks 0 n array.slice ;

: describe ( str array token -- str )
  :> toks :> s
  "" :> out!
  0 :> k!
  toks
  [ :> t
    k [ out " " str.concat out! ] when
    out
    t token.kind NUM i32.eq [ "num " ] [ t token.kind IDENT i32.eq [ "ident " ] [ "op " ] if ] if str.concat
    s t token.start t token.len str.slice str.concat
    "@" str.concat  t token.start i32.to-str str.concat
    out!
    k 1 i32.add k! ]
  each
  out ;

test tokenize : "12 + foo*(3 - bar_2)" tokenize array.len -> 9
test describe : "12 + foo*(3 - bar_2)" dup tokenize describe
                -> "num 12@0 op +@3 ident foo@5 op *@8 op (@9 num 3@10 op -@12 ident bar_2@14 op )@19"
test describe : "" dup tokenize describe -> ""

: main ( -- )
  "count * (width + 2) / 10" :> e
  e e tokenize describe println ;
