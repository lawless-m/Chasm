# Byte buffers: `bytes` carries its length, so `host.read` fills at most
# that many bytes and `bytes.at` traps past the end. Run with:
#   chasm run examples/bytes.chasm --mount ex=examples

: filled ( i32 -- bytes )
  :> n
  n bytes.new :> b
  n [ :> i  b i i 65 i32.add bytes.at! ] times
  b ;
test filled : 3 filled bytes.to-str -> "ABC"
test filled : 4 filled bytes.len -> 4
test filled : 5 filled 1 3 bytes.slice bytes.to-str -> "BCD"
test filled : 2 filled 2 filled eq -> 1

# bytes.to-str copies: changing the buffer afterwards leaves the string alone.
: snapshot ( -- str )
  2 filled :> b
  b bytes.to-str :> s
  b 0 90 bytes.at!
  s ;
test snapshot : snapshot -> "AB"

# bytes.as-str shares the buffer: no copy, so a later write shows through.
: shared ( -- str )
  2 filled :> b
  b bytes.as-str :> s
  b 0 90 bytes.at!
  s ;
test shared : shared -> "ZB"

# Count the bytes of a file, 16 at a time.
: size ( str -- i32 )
  0 host.open :> h
  h 0 i32.lt_s
  [ h ]
  [ 16 bytes.new :> buf
    0 :> total!
    0 :> r!
    [ h buf host.read r!  r 0 i32.gt_s ]
    [ total r i32.add total! ]
    while
    h host.close drop
    r 0 i32.lt_s [ r ] [ total ] if ]
  if ;
test size : "/mnt/none/x" size -> -1

: main ( -- )
  "hello.chasm is " print
  "/mnt/ex/hello.chasm" size i32.to-str print
  " bytes" println ;
