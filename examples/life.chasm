# Conway's Game of Life on a fixed grid with dead edges.
# Rosetta Code: Conway's_Game_of_Life. Exercises: a struct holding an array
# and its width, a 2-D grid in a flat array i32, index arithmetic, a board
# written as text.
#
# A board's cells are 1 alive, 0 dead, row after row, w to a row. As text it
# is `.` and `#`, rows separated by a separator string.

struct board  cells: array i32  w: i32

# The cell at x y, 0 off the edge.
: cell ( board i32 i32 -- i32 )
  :> y :> x :> b
  b board.w :> w
  b board.cells :> g
  x 0 i32.lt_s  x w i32.ge_s  i32.or
  y 0 i32.lt_s  i32.or
  y  g array.len w i32.div_s  i32.ge_s  i32.or
  [ 0 ]
  [ g  y w i32.mul x i32.add  array.at ]
  if ;

: neighbours ( board i32 i32 -- i32 )
  :> y :> x :> b
  0 :> n!
  9 [ :> k                                  # k walks the 3 by 3 block
    k 4 i32.ne
    [ b  x k 3 i32.rem_u i32.add 1 i32.sub  y k 3 i32.div_u i32.add 1 i32.sub  cell
      n i32.add n! ]
    when
  ] times
  n ;

: step ( board -- board )
  :> b
  b board.w :> w
  b board.cells :> g
  g array.len array.new ( array i32 ) :> next
  g array.len [ :> i
    b  i w i32.rem_u  i w i32.div_u  neighbours :> n
    g i array.at
    [ n 2 i32.eq  n 3 i32.eq  i32.or ]      # a live cell survives with 2 or 3
    [ n 3 i32.eq ]                          # a dead one is born with exactly 3
    if :> alive
    next i alive array.at!
  ] times
  next w board.new ;

# Text to a board of width w: `#` alive, `.` dead, anything else (row
# separators) skipped.
: parse ( str i32 -- board )
  :> w :> s
  0 :> n!
  s str.len [ s swap str.byte-at :> c  c 35 i32.eq c 46 i32.eq i32.or [ n 1 i32.add n! ] when ] times
  n array.new ( array i32 ) :> g
  0 :> k!
  s str.len [ :> i
    s i str.byte-at :> ch
    ch 35 i32.eq  ch 46 i32.eq  i32.or
    [ g k  ch 35 i32.eq  array.at!  k 1 i32.add k! ]
    when
  ] times
  g w board.new ;

: show ( board str -- str )
  :> sep :> b
  b board.w :> w
  b board.cells :> g
  "" :> out!
  g array.len [ :> i
    i 0 i32.ne  i w i32.rem_u i32.eqz  i32.and [ out sep str.concat out! ] when
    out  g i array.at [ "#" ] [ "." ] if  str.concat out!
  ] times
  out ;

test parse : ".#./..#" 3 parse "/" show -> ".#./..#"
test step : ".../###/..." 3 parse step "/" show -> ".#./.#./.#."              # blinker turns
test step : ".../###/..." 3 parse step step "/" show -> ".../###/..."         # period 2
test step : "..../.##./.##./...." 4 parse step "/" show -> "..../.##./.##./...."  # block is stable
test step : ".#..../..#.../###.../....../....../......" 6 parse
            step step step step "/" show
            -> "....../..#.../...#../.###../....../......"                  # glider moves 1 down-right

: main ( -- )
  ".#......../..#......./###......./........../........../........../........../.........." 10 parse :> b!
  5 [ :> gen
    "generation " print gen i32.to-str println
    b "\n" show println
    b step b!
  ] times ;
