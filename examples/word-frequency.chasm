# The most frequent words in a text: lower-cased, split on anything that is
# not an ASCII letter, ties broken by first appearance.
# Rosetta Code: Word_frequency. Exercises: structs, a binary search tree of
# `option node` links matched with `none:`/`some:`, a map without a map
# type, selection of the top k. Non-ASCII letters count as separators.

: letter? ( i32 -- i32 )
  :> c
  c 65 i32.ge_u  c 90 i32.le_u  i32.and
  c 97 i32.ge_u  c 122 i32.le_u  i32.and
  i32.or ;

# A lower-case copy of n bytes of s from start.
: lower-slice ( str i32 i32 -- str )
  :> n :> start :> s
  n bytes.new :> buf
  n [ :> i
    s start i i32.add str.byte-at :> c
    buf i  c 65 i32.ge_u c 90 i32.le_u i32.and [ c 32 i32.add ] [ c ] if  bytes.at!
  ] times
  buf bytes.as-str ;
test lower-slice : "Hello World" 6 5 lower-slice -> "world"

# Byte-wise order: negative, zero or positive.
: str.cmp ( str str -- i32 )
  :> b :> a
  a str.len b str.len i32.lt_s [ a str.len ] [ b str.len ] if :> n
  0 :> i!
  0 :> d!
  [ i n i32.lt_s d i32.eqz i32.and ]
  [ a i str.byte-at  b i str.byte-at  i32.sub d!  i 1 i32.add i! ]
  while
  d i32.eqz [ a str.len b str.len i32.sub ] [ d ] if ;
test str.cmp : "cat" "cat" str.cmp -> 0
test str.cmp : "bat" "cat" str.cmp 0 i32.lt_s -> 1
test str.cmp : "cats" "cat" str.cmp 0 i32.gt_s -> 1

# A word, its count, when it first appeared, and the subtrees before and
# after it.
struct node  word: str  count: i32  first: i32  left: option node  right: option node

: none ( -- option node )  option.none ;

# Count a word under a non-empty tree; 1 if it is new, else 0.
: insert ( node str i32 -- i32 )
  :> seq :> w :> root
  root :> cur!
  -1 :> added!
  [ added 0 i32.lt_s ]
  [ w cur node.word str.cmp :> c
    c 0 i32.eq
    [ cur  cur node.count 1 i32.add  node.count!  0 added! ]
    [ c 0 i32.lt_s [ cur node.left ] [ cur node.right ] if
      none: [
        w 1 seq none none node.new option.some :> leaf
        c 0 i32.lt_s [ cur leaf node.left! ] [ cur leaf node.right! ] if
        1 added! ]
      some: [ cur! ]
      match ]
    if ]
  while
  added ;

# Store the nodes under a link into out from index at; the next free index.
: collect ( option node array node i32 -- i32 )
  :> at :> out
  none: [ at ]
  some: [ :> n
    n node.left out at collect :> at2
    out at2 n array.at!
    n node.right out at2 1 i32.add collect ]
  match ;

: top-words ( str i32 -- str )
  :> k :> s
  none :> root!
  0 :> used!
  0 :> i!
  [ i s str.len i32.lt_u ]
  [ s i str.byte-at letter?
    [ i :> start
      [ i s str.len i32.lt_u [ s i str.byte-at letter? ] [ 0 ] if ] [ i 1 i32.add i! ] while
      s start i start i32.sub lower-slice :> w
      root
      none: [ w 1 used none none node.new option.some root!  1 used! ]
      some: [ w used insert used i32.add used! ]
      match ]
    [ i 1 i32.add i! ]
    if ]
  while
  used array.new ( array node ) :> nodes
  root nodes 0 collect drop
  "" :> out!
  k used i32.gt_u [ used ] [ k ] if [ :> r
    0 :> best!
    used [ :> j
      nodes j array.at :> a
      nodes best array.at :> b
      a node.count b node.count i32.gt_s
      a node.count b node.count i32.eq  a node.first b node.first i32.lt_s  i32.and
      i32.or [ j best! ] when
    ] times
    nodes best array.at :> win
    r 0 i32.ne [ out " " str.concat out! ] when
    out  win node.word str.concat  ":" str.concat  win node.count i32.to-str str.concat  out!
    win -1 node.count!                          # taken
  ] times
  out ;
test top-words : "The cat and the hat; the BAT and a cat!" 3 top-words -> "the:3 cat:2 and:2"
test top-words : "x y" 10 top-words -> "x:1 y:1"
test top-words : "  ...  " 10 top-words -> ""
test top-words : "don't stop" 10 top-words -> "don:1 t:1 stop:1"

# The ten most frequent words of standard input.
: main ( -- )
  "" :> text!
  1 :> more!
  [ more ] [ read-line more! :> line  text " " str.concat line str.concat text! ] while
  text 10 top-words println ;
