# A Brainfuck interpreter: the eight commands over a 30,000-cell tape of
# bytes, with brackets matched up front.
# Rosetta Code: Execute_Brain****. Exercises: an interpreter loop, a jump
# table built with an array as a stack, trap with a built message.
# The interpreter takes the program and its input as str and returns the
# output, so it can be tested; main runs it against the console.

# For each bracket, the index of its partner.
: jumps ( str -- array i32 )
  :> p
  p str.len array.new ( array i32 ) :> jump
  p str.len array.new ( array i32 ) :> open
  0 :> sp!
  p str.len [ :> i
    p i str.byte-at :> c
    c 91 i32.eq [ open sp i array.at!  sp 1 i32.add sp! ] when      # [
    c 93 i32.eq                                                     # ]
    [ sp i32.eqz [ "unmatched ] at " i i32.to-str str.concat trap ] when
      sp 1 i32.sub sp!
      open sp array.at :> o
      jump o i array.at!
      jump i o array.at! ]
    when
  ] times
  sp [ "unmatched [" trap ] when
  jump ;

: byte>str ( i32 -- str )
  :> b
  1 mem.alloc :> a
  a b i32.store8
  a 1 str.from-raw ;

: bf ( str str -- str )
  :> in :> p
  p jumps :> jump
  30000 array.new ( array i32 ) :> tape
  0 :> ptr!  0 :> pc!  0 :> pos!
  "" :> out!
  [ pc p str.len i32.lt_u ]
  [ p pc str.byte-at :> c
    tape ptr array.at :> v
    c 62 i32.eq [ ptr 1 i32.add ptr! ] when                                  # >
    c 60 i32.eq [ ptr 1 i32.sub ptr! ] when                                  # <
    c 43 i32.eq [ tape ptr  v 1 i32.add 255 i32.and  array.at! ] when        # +
    c 45 i32.eq [ tape ptr  v 1 i32.sub 255 i32.and  array.at! ] when        # -
    c 46 i32.eq [ out v byte>str str.concat out! ] when                      # .
    c 44 i32.eq                                                              # , (0 at end)
    [ tape ptr  pos in str.len i32.lt_u [ in pos str.byte-at ] [ 0 ] if  array.at!
      pos 1 i32.add pos! ]
    when
    c 91 i32.eq  v i32.eqz     i32.and [ jump pc array.at pc! ] when        # [ on 0: skip
    c 93 i32.eq  v 0 i32.ne    i32.and [ jump pc array.at pc! ] when        # ] on non-0: back
    pc 1 i32.add pc! ]
  while
  out ;

: hello ( -- str )
  "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++." ;

test bf : hello "" bf -> "Hello World!\n"
test bf : ",[.,]" "cat" bf -> "cat"                      # echo the input
test bf : "-." "" bf str.addr i32.load8_u -> 255         # cells wrap at 256
test bf : "+[-]." "" bf str.addr i32.load8_u -> 0
test jumps : "[[]]" jumps 0 array.at -> 3

# Runs hello world, then a program that upper-cases one line of input.
: main ( -- )
  hello "" bf print
  read-line drop :> line
  ",[>++++[<-------->-]<.,]" line bf println ;
