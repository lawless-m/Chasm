# A 9p file server mounted into the namespace, and the directory records
# every directory read returns: u32 name length, the name, u64 size, u8
# is-dir, packed. Run against a 9P2000 server:
#   chasm run examples/ninep.chasm --mount p=9p://host:564

: record-len ( bytes i32 -- i32 )  bytes.u32-at 13 i32.add ;
: record-name ( bytes i32 -- str )
  :> r :> b  b r 4 i32.add b r bytes.u32-at bytes.slice bytes.to-str ;
: record-size ( bytes i32 -- i64 )
  :> r :> b  b r 4 i32.add b r bytes.u32-at i32.add bytes.u64-at ;
: record-dir? ( bytes i32 -- i32 )
  :> r :> b  b r 12 i32.add b r bytes.u32-at i32.add bytes.at ;

# One record built by hand, for the tests: name, size, is-dir.
: make-record ( str i64 i32 -- bytes )
  :> dir :> size :> name
  name str.len :> n
  n 13 i32.add bytes.new :> r
  r 0 n bytes.u32-at!
  r 4 name bytes.put
  r 4 n i32.add size bytes.u64-at!
  r 12 n i32.add dir bytes.at!
  r ;
test record-name : "abc" 42 i64 0 make-record 0 record-name -> "abc"
test record-size : "abc" 42 i64 0 make-record 0 record-size -> 42 i64
test record-dir? : "sub" 0 i64 1 make-record 0 record-dir? -> 1
test record-len : "hello.txt" 6 i64 0 make-record 0 record-len -> 22

# The number of entries in a directory, or the error from opening it.
: entries ( str -- i32 )
  :> path
  path 0 host.open :> h
  h 0 i32.lt_s
  [ h ]
  [ 4096 bytes.new :> buf
    0 :> count!
    1 :> r!
    [ r 0 i32.gt_s ]
    [ h buf host.read r!
      0 :> at!
      [ at r i32.lt_s ]
      [ buf at record-len at i32.add at!  count 1 i32.add count! ]
      while ]
    while
    h host.close drop
    count ]
  if ;
test entries : "/mnt/none" entries -> -1

: main ( -- )
  "/mnt/p has " print  "/mnt/p" entries i32.to-str print  " entries" println
  "/mnt/p" ls drop
  "/mnt/p/hello.txt" read-file
  0 i32.eq [ print ] [ drop "could not read" println ] if ;
