# The moves that take n discs from peg 1 to peg 3.
# Rosetta Code: Towers_of_Hanoi. Exercises: recursion with four inputs,
# building the move list with str.concat.

: move ( i32 i32 -- str )
  :> to :> from
  from i32.to-str "-" str.concat  to i32.to-str str.concat  "\n" str.concat ;

: hanoi ( i32 i32 i32 i32 -- str )
  :> via :> to :> from :> n
  n 0 i32.eq
  [ "" ]
  [
    n 1 i32.sub from via to hanoi
    from to move str.concat
    n 1 i32.sub via to from hanoi str.concat
  ]
  if ;
test hanoi : 1 1 3 2 hanoi -> "1-3\n"
test hanoi : 3 1 3 2 hanoi -> "1-3\n1-2\n3-2\n1-3\n2-1\n2-3\n1-3\n"
test hanoi : 10 1 3 2 hanoi str.len 4 i32.div_u -> 1023   # 2^10 - 1 moves, 4 bytes each

: main ( -- )  4 1 3 2 hanoi print ;
