# Temperature conversion: Kelvin to Celsius, Fahrenheit and Rankine.
# Rosetta Code: Temperature_conversion. Exercises: f64 arithmetic, rounding,
# formatting with f64.fixed.

: kelvin>celsius    ( f64 -- f64 )  273.15 f64.sub ;
: kelvin>rankine    ( f64 -- f64 )  1.8 f64.mul ;
: kelvin>fahrenheit ( f64 -- f64 )  kelvin>rankine 459.67 f64.sub ;

# Tests compare exactly, so results are compared as text rounded by the
# prelude's f64.fixed.
test f64.fixed : 2.5 2 f64.fixed -> "2.50"
test f64.fixed : -0.125 2 f64.fixed -> "-0.12"   # f64.nearest: ties to even
test f64.fixed : -0.001 2 f64.fixed -> "0.00"
test f64.fixed : 7.0 0 f64.fixed -> "7"

test kelvin>celsius    : 0.0 kelvin>celsius 2 f64.fixed -> "-273.15"
test kelvin>celsius    : 373.15 kelvin>celsius 2 f64.fixed -> "100.00"
test kelvin>fahrenheit : 0.0 kelvin>fahrenheit 2 f64.fixed -> "-459.67"
test kelvin>fahrenheit : 21.0 kelvin>fahrenheit 2 f64.fixed -> "-421.87"
test kelvin>rankine    : 21.0 kelvin>rankine 2 f64.fixed -> "37.80"

: report ( f64 -- )
  :> k
  "K  " print k 2 f64.fixed println
  "C  " print k kelvin>celsius 2 f64.fixed println
  "F  " print k kelvin>fahrenheit 2 f64.fixed println
  "R  " print k kelvin>rankine 2 f64.fixed println ;

: main ( -- )  21.0 report ;
