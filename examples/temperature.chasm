# Temperature conversion: Kelvin to Celsius, Fahrenheit and Rankine.
# Rosetta Code: Temperature_conversion. Exercises: f64 arithmetic, rounding,
# formatting a number with two decimals.
# Tests compare exactly, so they go through `hundredths`, which rounds.

: kelvin>celsius    ( f64 -- f64 )  273.15 f64.sub ;
: kelvin>rankine    ( f64 -- f64 )  1.8 f64.mul ;
: kelvin>fahrenheit ( f64 -- f64 )  kelvin>rankine 459.67 f64.sub ;

# Two digits, with a leading zero below 10.
: two-digits ( i64 -- str )
  dup 10i64 i64.lt_s [ i64.to-str "0" swap str.concat ] [ i64.to-str ] if ;
test two-digits : 5i64 two-digits -> "05"
test two-digits : 15i64 two-digits -> "15"

# An f64 rounded to two decimals, as text.
: hundredths ( f64 -- str )
  100.0 f64.mul f64.nearest i64.trunc_f64_s :> h
  h 0i64 i64.lt_s [ "-" ] [ "" ] if :> sign
  h 0i64 i64.lt_s [ 0i64 h i64.sub ] [ h ] if :> a
  sign  a 100i64 i64.div_s i64.to-str str.concat
  "." str.concat  a 100i64 i64.rem_s two-digits str.concat ;
test hundredths : 2.5 hundredths -> "2.50"
test hundredths : -0.125 hundredths -> "-0.12"   # nearest rounds half to even

test kelvin>celsius    : 0.0 kelvin>celsius hundredths -> "-273.15"
test kelvin>celsius    : 373.15 kelvin>celsius hundredths -> "100.00"
test kelvin>fahrenheit : 0.0 kelvin>fahrenheit hundredths -> "-459.67"
test kelvin>fahrenheit : 21.0 kelvin>fahrenheit hundredths -> "-421.87"
test kelvin>rankine    : 21.0 kelvin>rankine hundredths -> "37.80"

: report ( f64 -- )
  :> k
  "K  " print k hundredths println
  "C  " print k kelvin>celsius hundredths println
  "F  " print k kelvin>fahrenheit hundredths println
  "R  " print k kelvin>rankine hundredths println ;

: main ( -- )  21.0 report ;
