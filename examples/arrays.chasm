# Arrays, collection combinators and functions as values.

# array.new needs its element type fixed; the assertion does it.
: iota ( i32 -- array i32 )
  :> n
  n array.new ( array i32 ) :> a
  n [ :> i  a i i array.at! ] times
  a ;
test iota : 4 iota array.len -> 4
test iota : 4 iota 3 array.at -> 3

: sum ( array i32 -- i32 )  0 [ i32.add ] fold ;
test sum : 10 iota sum -> 45

: doubled ( array i32 -- array i32 )  [ 2 i32.mul ] map ;
test doubled : 5 iota doubled sum -> 20

: evens ( array i32 -- array i32 )  [ 2 i32.rem_u i32.eqz ] filter ;
test evens : 10 iota evens array.len -> 5

# The first index holding x, or -1.
: index-of ( array i32 i32 -- i32 )
  :> x :> a
  -1 :> found!
  a array.len [ :> i  a i array.at x i32.eq [ i found! leave ] when ] times
  found ;
test index-of : 10 iota 7 index-of -> 7
test index-of : 10 iota 70 index-of -> -1

# Functions as values: '\word takes an address, call calls it.
: twice ( i32 [ i32 -- i32 ] -- i32 )  :> f  f call f call ;
: inc ( i32 -- i32 )  1 i32.add ;
test twice : 5 'inc twice -> 7

: print-all ( array i32 -- )  [ i32.to-str println ] each ;

: main ( -- )
  "squares:" println
  8 iota [ dup i32.mul ] map print-all ;
