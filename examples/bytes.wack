# Byte buffers: `bytes` carries its length, so `host.read` fills at most
# that many bytes and `bytes.at` traps past the end. Run with:
#   wack run examples/bytes.wack --mount ex=examples

: filled ( i32 -- bytes )
  :> n
  n bytes.new :> b
  n [ :> i  b i i 65 i32.add bytes.at! ] times
  b ;
test filled : 3 filled bytes.to-str -> "ABC"
test filled : 4 filled bytes.len -> 4
test filled : 5 filled 1 3 bytes.slice bytes.to-str -> "BCD"
test filled : 2 filled 2 filled eq -> 1

# bytes.to-str copies: changing the buffer afterwards leaves the string alone.
: snapshot ( -- str )
  2 filled :> b
  b bytes.to-str :> s
  b 0 90 bytes.at!
  s ;
test snapshot : snapshot -> "AB"

# bytes.as-str shares the buffer: no copy, so a later write shows through.
: shared ( -- str )
  2 filled :> b
  b bytes.as-str :> s
  b 0 90 bytes.at!
  s ;
test shared : shared -> "ZB"

# Little-endian 16-bit numbers at a byte offset: 0xBEEF stored at offset 1
# is EF then BE.
: le16 ( -- bytes )
  4 bytes.new :> b
  b 1 0xBEEF bytes.u16-at!
  b ;
test le16 : le16 1 bytes.u16-at -> 0xBEEF
test le16 : le16 1 bytes.at -> 0xEF
test le16 : le16 2 bytes.at -> 0xBE
test le16 : le16 0 bytes.u16-at -> 0xEF00
test le16 : le16 3 bytes.u16-at -> trap
test le16 : le16 -1 bytes.u16-at -> trap
test le16 : 2 bytes.new dup 0 70000 bytes.u16-at! 0 bytes.u16-at -> 4464
test le16 : 1 bytes.new 0 1 bytes.u16-at! -> trap

# Count the bytes of a file, 16 at a time.
: size ( str -- i32 )
  host.OREAD host.open :> h
  h 0 i32.lt_s
  [ h ]
  [
    16 bytes.new :> buf
    0 :> total!
    0 :> r!
    [ h buf host.read r!  r 0 i32.gt_s ]
    [ total r i32.add total! ]
    while
    h host.close drop
    r 0 i32.lt_s [ r ] [ total ] if
  ]
  if ;
test size : "/mnt/none/x" size -> -1

: main ( -- )
  "hello.wack is " print
  "/mnt/ex/hello.wack" size i32.to-str print
  " bytes" println ;
