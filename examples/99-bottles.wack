# The 99 bottles of beer song, from 99 down to 0.
# Rosetta Code: 99_bottles_of_beer. Exercises: building strings with
# str.concat, nested if, singular and plural.

: bottles ( i32 -- str )
  :> n
  n 0 i32.eq
  [ "no more bottles" ]
  [ n 1 i32.eq [ "1 bottle" ] [ n i32.to-str " bottles" str.concat ] if ]
  if ;
test bottles : 0 bottles -> "no more bottles"
test bottles : 1 bottles -> "1 bottle"
test bottles : 2 bottles -> "2 bottles"

# 0 starts a fresh round with "No more"; any other verse leads with the count.
: verse ( i32 -- str )
  :> n
  n 0 i32.eq [ "No more bottles" ] [ n bottles ] if
  " of beer on the wall, " str.concat  n bottles str.concat  " of beer.\n" str.concat
  n 0 i32.eq
  [ "Go to the store and buy some more, " ]
  [ "Take one down and pass it around, " ]
  if str.concat
  n 0 i32.eq [ 99 ] [ n 1 i32.sub ] if bottles str.concat
  " of beer on the wall.\n" str.concat ;
test verse : 2 verse -> "2 bottles of beer on the wall, 2 bottles of beer.\nTake one down and pass it around, 1 bottle of beer on the wall.\n"
test verse : 1 verse -> "1 bottle of beer on the wall, 1 bottle of beer.\nTake one down and pass it around, no more bottles of beer on the wall.\n"
test verse : 0 verse -> "No more bottles of beer on the wall, no more bottles of beer.\nGo to the store and buy some more, 99 bottles of beer on the wall.\n"

: main ( -- )
  100 [ :> i  99 i i32.sub verse print  i 99 i32.lt_u [ "\n" print ] when ] times ;
