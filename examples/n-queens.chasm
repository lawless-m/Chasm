# Count the ways to place n queens on an n by n board, none attacking another.
# Rosetta Code: N-queens_problem. Exercises: recursion, backtracking,
# an array as the partial solution (column of the queen in each row).

# Can a queen go at row r, column c, given the queens in rows 0 to r-1?
: safe? ( array i32 i32 i32 -- i32 )
  :> c :> r :> q
  1 :> ok!
  r [ :> i
    q i array.at :> qc
    qc c i32.eq                              # same column
    qc c i32.sub  r i i32.sub  i32.eq  i32.or  # same diagonal
    c qc i32.sub  r i i32.sub  i32.eq  i32.or  # same anti-diagonal
    [ 0 ok! leave ] when
  ] times
  ok ;

# Completions of a board whose rows 0 to r-1 are already placed.
: solve ( array i32 i32 i32 -- i32 )
  :> n :> r :> q
  r n i32.eq
  [ 1 ]
  [ 0 :> count!
    n [ :> c
      q r c safe?
      [ q r c array.at!  q r 1 i32.add n solve  count i32.add count! ]
      when
    ] times
    count ]
  if ;

: queens ( i32 -- i32 )
  :> n
  n array.new ( array i32 ) 0 n solve ;

test queens : 1 queens -> 1
test queens : 2 queens -> 0
test queens : 3 queens -> 0
test queens : 4 queens -> 2
test queens : 5 queens -> 10
test queens : 6 queens -> 4
test queens : 7 queens -> 40
test queens : 8 queens -> 92

: main ( -- )
  10 [ 1 i32.add :> n  n i32.to-str print " queens: " print  n queens i32.to-str println ] times ;
