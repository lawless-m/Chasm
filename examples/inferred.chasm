# Words without written effects: each is inferred and then checked as if it
# had been written. `main` must still declare `( -- )`, and so must words
# that call themselves or each other, and `export` words.
# Exercises: inference through locals, loops, calls to other inferred words,
# quotations under `if`, and a word inferred generic.
#
# `chasm infer examples/inferred.chasm` prints these, each with its line:
#   c>f ( i32 -- i32 )
#   f>c ( i32 -- i32 )
#   describe ( i32 -- str )
#   sum-to ( i32 -- i32 )
#   report ( i32 -- str )
#   twice ( T -- T T )

: c>f  9 i32.mul 5 i32.div_s 32 i32.add ;
test c>f : 100 c>f -> 212
test c>f : -40 c>f -> -40

: f>c  32 i32.sub 5 i32.mul 9 i32.div_s ;
test f>c : 212 f>c -> 100

: describe
  :> t
  t 30 i32.gt_s [ "hot" ] [ t 10 i32.lt_s [ "cold" ] [ "mild" ] if ] if ;
test describe : 35 describe -> "hot"
test describe : 20 describe -> "mild"
test describe : 0 describe -> "cold"

: sum-to
  :> n
  0 :> s!
  n [ 1 i32.add s i32.add s! ] times
  s ;
test sum-to : 4 sum-to -> 10
test sum-to : 0 sum-to -> 0

: report  dup c>f i32.to-str " F is " str.concat swap describe str.concat ;
test report : 25 report -> "77 F is mild"

: twice  dup ;
test twice : 7 twice -> 7 7
test twice : "ab" twice str.concat -> "abab"

: main ( -- )
  25 report println
  10 sum-to i32.to-str println ;
