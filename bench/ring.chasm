# The ring's cost per operation: 200,000 one-byte reads, 200,000 one-byte
# writes and 200,000 calls of `now` (an open, a read and a close of
# /dev/time each), timed with `now`. Compare with bench/rust/ring.rs, the
# same system calls without the ring. Run:
#   mkdir -p tmp/ring
#   chasm run bench/ring.chasm --mount b=tmp/ring

: per-op ( i64 i32 -- str )  i64 i64.div_s i64.to-str ;

: main ( -- )
  200000 :> n
  n mem.alloc :> buf
  "/mnt/b/data" 1 host.open :> w
  w buf n host.write drop
  w host.close drop

  "/mnt/b/data" 0 host.open :> r
  now :> t0
  n [ drop  r buf 1 host.read drop ] times
  now t0 i64.sub :> reads
  r host.close drop

  "/mnt/b/out" 1 host.open :> o
  now :> t1
  n [ drop  o buf 1 host.write drop ] times
  now t1 i64.sub :> writes
  o host.close drop

  now :> t2
  n [ drop  now drop ] times
  now t2 i64.sub :> clocks

  "read-1B " print  reads n per-op println
  "write-1B " print  writes n per-op println
  "now " print  clocks n per-op println ;
