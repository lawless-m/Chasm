# Benchmark: total escape count over a 1200 x 800 grid of the Mandelbrot
# set, 200 iterations at most, with `escape` from examples/mandelbrot.chasm.
# Run as `chasm run examples/mandelbrot.chasm bench/mandelbrot.chasm`.
# Prints the checksum, then the nanoseconds the work took.

: grid-sum ( i32 i32 i32 -- i32 )
  :> max :> h :> w
  0 :> total!
  h [ :> r
    1.2 r f64.convert_i32_s 2.4 f64.mul h f64.convert_i32_s f64.div f64.sub :> cy
    w [ :> c
      -2.0 c f64.convert_i32_s 3.0 f64.mul w f64.convert_i32_s f64.div f64.add :> cx
      total cx cy max escape i32.add total!
    ] times
  ] times
  total ;

: main ( -- )
  now :> t0
  1200 800 200 grid-sum :> sum
  now t0 i64.sub :> ns
  sum i32.to-str print " " print ns i64.to-str println ;
