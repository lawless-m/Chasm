# Whackford prelude: library words written in Whackford, compiled with every program.
#
# Built on the primitives only. Strings and byte buffers are ( addr len )
# pairs; see
# LANGUAGE.md section 4. I/O is four host words over a namespace; see
# LANGUAGE.md section 10.

# ---------------------------------------------------------------- strings

: str.byte-at ( str i32 -- i32 )
  :> i :> s
  i s str.len i32.ge_u [ "str.byte-at: offset out of range" trap ] when
  s str.addr i i32.add i32.load8_u ;

# Is byte offset i a codepoint boundary of s? (i == length counts.)
: str.boundary? ( str i32 -- i32 )
  :> i :> s
  i s str.len i32.eq
  [ 1 ]
  [ i s str.len i32.lt_u
    [ s str.addr i i32.add i32.load8_u 0xC0 i32.and 0x80 i32.ne ]
    [ 0 ] if ]
  if ;

: str.slice ( str i32 i32 -- str )
  :> n :> start :> s
  start s str.len i32.gt_u
  n s str.len start i32.sub i32.gt_u i32.or
  [ "str.slice: range out of bounds" trap ] when
  s start str.boundary? i32.eqz
  s start n i32.add str.boundary? i32.eqz i32.or
  [ "str.slice: not on a codepoint boundary" trap ] when
  s str.addr start i32.add n str.from-raw ;

: str.eq ( str str -- i32 )
  :> b :> a
  a str.len b str.len i32.ne
  [ 0 ]
  [ 1 :> r!
    a str.len [
      :> i
      a str.addr i i32.add i32.load8_u
      b str.addr i i32.add i32.load8_u
      i32.ne [ 0 r! leave ] when
    ] times
    r ]
  if ;

: str.concat ( str str -- str )
  :> b :> a
  a str.len b str.len i32.add :> n
  n mem.alloc :> p
  p a str.addr a str.len memory.copy
  p a str.len i32.add b str.addr b str.len memory.copy
  p n str.from-raw ;

# Decode the codepoint at byte offset i: ( codepoint byte-length ).
: str.cp-at ( str i32 -- i32 i32 )
  :> i :> s
  i s str.len i32.ge_u [ "str.cp-at: offset out of range" trap ] when
  s str.addr i i32.add :> p
  p i32.load8_u :> b0
  b0 0x80 i32.lt_u
  [ b0 1 ]
  [ b0 0xC0 i32.and 0x80 i32.eq [ "str.cp-at: not on a codepoint boundary" trap ] when
    b0 0xF8 i32.ge_u [ "str.cp-at: invalid UTF-8" trap ] when
    b0 0xE0 i32.lt_u
    [ b0 0x1F i32.and 2 ]
    [ b0 0xF0 i32.lt_u [ b0 0x0F i32.and 3 ] [ b0 0x07 i32.and 4 ] if ]
    if
    :> n :> acc!
    i n i32.add s str.len i32.gt_u [ "str.cp-at: truncated UTF-8 sequence" trap ] when
    n 1 i32.sub [
      1 i32.add p i32.add i32.load8_u :> c
      c 0xC0 i32.and 0x80 i32.ne [ "str.cp-at: invalid UTF-8" trap ] when
      acc 6 i32.shl c 0x3F i32.and i32.or acc!
    ] times
    acc n ]
  if ;

# A one-byte string.
: str.from-byte ( i32 -- str )
  :> b
  1 mem.alloc :> a
  a b i32.store8
  a 1 str.from-raw ;

# ---------------------------------------------------------------- numbers

: i64.to-str ( i64 -- str )
  :> v
  24 mem.alloc :> buf
  24 :> pos!
  v 0 i64 i64.lt_s :> neg
  # Work with a non-positive magnitude so that the minimum i64 is exact.
  v :> u!
  neg i32.eqz [ 0 i64 u i64.sub u! ] when
  [ pos 1 i32.sub pos!
    buf pos i32.add
    0 i64 u 10 i64 i64.rem_s i64.sub i32.wrap_i64 48 i32.add
    i32.store8
    u 10 i64 i64.div_s u! ]
  [ u i64.eqz ] until
  neg [ pos 1 i32.sub pos!  buf pos i32.add 45 i32.store8 ] when
  buf pos i32.add 24 pos i32.sub str.from-raw ;

# Exact widening; lossy conversions keep their wasm names.
: i64 ( i32 -- i64 )  i64.extend_i32_s ;

: i32.to-str ( i32 -- str )  i64 i64.to-str ;

# The integer starting at byte offset i of s: an optional `-`, then one or
# more digits. Leaves its value and the offset just after it, or 0 and -1
# when no number starts there (an offset outside s included) or it does
# not fit. Digits are taken into a negative total, so the i64 minimum fits.
: str.i64-at ( str i32 -- i64 i32 )
  :> i :> s
  s str.len :> n
  i :> j!
  [ i n i32.lt_u ] [ s i str.byte-at 45 i32.eq ] and :> neg
  neg [ j 1 i32.add j! ] when
  j :> start
  0 i64 :> acc!
  1 :> fits!
  [ [ j n i32.lt_u ] [ s j str.byte-at 48 i32.sub 10 i32.lt_u ] and ]
  [
    s j str.byte-at 48 i32.sub i64 :> d
    acc -9223372036854775808 i64 d i64.add 10 i64 i64.div_s i64.lt_s
    [ 0 fits! ]
    [ acc 10 i64 i64.mul d i64.sub acc! ]
    if
    j 1 i32.add j!
  ]
  while
  # A digit was read, and a positive number is not the i64 minimum.
  [ [ fits ] [ j start i32.ne ] and ]
  [ [ neg ] [ acc -9223372036854775808 i64 i64.ne ] or ]
  and
  [ neg [ acc ] [ 0 i64 acc i64.sub ] if j ] [ 0 i64 -1 ] if ;

# As str.i64-at, for an i32: a number outside the i32 range is no number.
: str.i32-at ( str i32 -- i32 i32 )
  str.i64-at :> j :> v
  [ [ j 0 i32.ge_s ] [ v -2147483648 i64 i64.ge_s ] and ] [ v 2147483647 i64 i64.le_s ] and
  [ v i32.wrap_i64 j ] [ 0 -1 ] if ;

# The whole of s as an i64: the value and 1, or 0 and 0 if s is not
# exactly an optional `-` and digits, or does not fit.
: str.to-i64 ( str -- i64 i32 )
  :> s
  s 0 str.i64-at :> j :> v
  j s str.len i32.eq [ v 1 ] [ 0 i64 0 ] if ;

# As str.to-i64, for an i32.
: str.to-i32 ( str -- i32 i32 )
  :> s
  s 0 str.i32-at :> j :> v
  j s str.len i32.eq [ v 1 ] [ 0 0 ] if ;

# x rounded to d decimal places (f64.nearest: ties to even), as text.
# Traps when x * 10^d is beyond the i64 range.
: f64.fixed ( f64 i32 -- str )
  :> d :> x
  1 i64 :> unit!
  d [ drop  unit 10 i64 i64.mul unit! ] times
  x unit f64.convert_i64_s f64.mul f64.nearest i64.trunc_f64_s :> v
  v 0 i64 i64.lt_s [ 0 i64 v i64.sub ] [ v ] if :> a
  a unit i64.rem_s i64.to-str :> frac!
  [ frac str.len d i32.lt_s ] [ "0" frac str.concat frac! ] while
  v 0 i64 i64.lt_s [ "-" ] [ "" ] if
  a unit i64.div_s i64.to-str str.concat
  d [ "." str.concat frac str.concat ] when ;

# ---------------------------------------------------------------- arrays

# The elements in decimal, separated by single spaces.
: array.to-str ( array i32 -- str )
  :> a
  "" :> out!
  a array.len [ :> i
    i [ out " " str.concat out! ] when
    out a i array.at i32.to-str str.concat out!
  ] times
  out ;

# ---------------------------------------------------------------- bytes
# A byte buffer that knows its length, so a read cannot run past its end.

: bytes.new ( i32 -- bytes )
  :> n
  n 0 i32.lt_s [ "bytes.new: negative length" trap ] when
  n mem.alloc n bytes.from-raw ;

# Start and length; shares the buffer, no copy.
: bytes.slice ( bytes i32 i32 -- bytes )
  :> n :> start :> b
  start b bytes.len i32.gt_u
  n b bytes.len start i32.sub i32.gt_u i32.or
  [ "bytes.slice: range out of bounds" trap ] when
  b bytes.addr start i32.add n bytes.from-raw ;

# Copy a string into the buffer at an offset.
: bytes.put ( bytes i32 str -- )
  :> s :> at :> b
  at b bytes.len i32.gt_u
  s str.len b bytes.len at i32.sub i32.gt_u i32.or
  [ "bytes.put: does not fit" trap ] when
  b bytes.addr at i32.add s str.addr s str.len memory.copy ;

# A copy, so later writes to the buffer leave the string alone.
: bytes.to-str ( bytes -- str )
  :> b
  b bytes.len mem.alloc :> p
  p b bytes.addr b bytes.len memory.copy
  p b bytes.len str.from-raw ;

# The buffer itself as a string, no copy: for a buffer that is finished
# with. A later write to the buffer shows through the string.
: bytes.as-str ( bytes -- str )
  :> b
  b bytes.addr b bytes.len str.from-raw ;

# ---------------------------------------------------------------- I/O

# Modes for host.open, as layout.rs MODE_*.
: host.OREAD ( -- i32 )  0 ;
: host.OWRITE ( -- i32 )  1 ;  # truncates
: host.OAPPEND ( -- i32 )  2 ;
: host.ORDWR ( -- i32 )  3 ;

: print ( str -- )
  :> s
  "/dev/cons" host.OWRITE host.open :> h
  h s host.write drop
  h host.close drop ;

: println ( str -- )  print "\n" print ;

# Read one line from an open handle, without its newline.
# The flag is 1 if a line was read, 0 at end of input. One byte per
# read, so nothing past the newline is taken: the next call goes on
# from there. The handle stays open.
: host.read-line ( i32 -- str i32 )
  :> h
  256 :> cap!
  cap mem.alloc :> buf!
  0 :> n!
  0 :> eof!
  [ h buf n i32.add 1 bytes.from-raw host.read 1 i32.lt_s
    [ 1 eof! 0 ]
    [ buf n i32.add i32.load8_u 10 i32.ne ]
    if ]
  [ n 1 i32.add n!
    n cap i32.eq [
      cap 2 i32.mul mem.alloc :> nb
      nb buf n memory.copy
      nb buf!
      cap 2 i32.mul cap!
    ] when ]
  while
  buf n str.from-raw
  eof n i32.eqz i32.and i32.eqz ;

# Read one line from the console, as host.read-line.
: read-line ( -- str i32 )
  "/dev/cons" host.OREAD host.open :> h
  h host.read-line
  h host.close drop ;

# Read a whole file by namespace path, e.g. "/file/etc/hostname".
# Status is 0 on success or a negative error code.
: read-file ( str -- str i32 )
  :> path
  path host.OREAD host.open :> h
  h 0 i32.lt_s
  [ "" h ]
  [ 4096 :> cap!
    cap mem.alloc :> buf!
    0 :> n!
    0 :> r!
    [ h buf n i32.add cap n i32.sub bytes.from-raw host.read r!  r 0 i32.gt_s ]
    [ n r i32.add n!
      n cap i32.eq [
        cap 2 i32.mul mem.alloc :> nb
        nb buf n memory.copy
        nb buf!
        cap 2 i32.mul cap!
      ] when ]
    while
    h host.close drop
    buf n str.from-raw
    r 0 i32.lt_s [ r ] [ 0 ] if ]
  if ;

# Write a string to a namespace path, replacing what was there, e.g.
# "hello" "/local/greeting". Status is 0 on success or a negative error code.
: write-file ( str str -- i32 )
  :> path :> s
  path host.OWRITE host.open :> h
  h 0 i32.lt_s
  [ h ]
  [ 0 :> n!
    1 :> r!
    [ n s str.len i32.lt_u  r 0 i32.gt_s i32.and ]
    [ h s str.addr n i32.add s str.len n i32.sub str.from-raw host.write r!
      r 0 i32.gt_s [ n r i32.add n! ] when ]
    while
    h host.close drop
    r 0 i32.lt_s [ r ] [ r 0 i32.eq [ -4 ] [ 0 ] if ] if ]
  if ;

# Copy one namespace path to another, e.g.
# "/net/https/example.com/input" "/local/input". Status as read-file.
: copy ( str str -- i32 )
  :> to
  read-file :> r
  r 0 i32.lt_s [ drop r ] [ to write-file ] if ;

# Print the entries of a directory, one per line (directories get a
# trailing "/"). Status is 0 on success or a negative error code.
: ls ( str -- i32 )
  :> path
  path host.OREAD host.open :> h
  h 0 i32.lt_s
  [ h ]
  [ 4096 mem.alloc :> buf
    0 :> r!
    [ h buf 4096 bytes.from-raw host.read r!  r 0 i32.gt_s ]
    [ 0 :> off!
      [ off r i32.lt_s ]
      [ buf off i32.add :> rec
        rec i32.load :> nlen
        rec 4 i32.add nlen str.from-raw :> name
        rec 4 i32.add nlen i32.add 8 i32.add i32.load8_u :> isdir
        name print
        isdir [ "/" print ] when
        "\n" print
        off 13 nlen i32.add i32.add off! ]
      while ]
    while
    h host.close drop
    r 0 i32.lt_s [ r ] [ 0 ] if ]
  if ;

# Current time in nanoseconds since the Unix epoch.
: now ( -- i64 )
  "/dev/time" host.OREAD host.open :> h
  8 mem.alloc :> buf
  h buf 8 bytes.from-raw host.read drop
  h host.close drop
  buf i64.load ;

# ---------------------------------------------------------------- unions
# An optional value: `option.none` or `x option.some`, matched with
# `none: [ ... ] some: [ ... ] match`.
union option T | none | some  v: T

# ---------------------------------------------------------------- collections
# A growable array: chunks of 1, 2, 4, ... elements, so storage never moves.
# Element i is in chunk 31 - clz(i + 1), at offset i + 1 - 2^chunk.
struct chunk T  items: array T
struct vec T  chunks: array chunk T  count: i32

: vec.make ( -- vec T )  32 array.new ( array chunk T ) 0 vec.new ;
: vec.len ( vec T -- i32 )  vec.count ;
: vec.clear ( vec T -- )  0 vec.count! ;

: vec.push ( vec T T -- )
  :> x :> v
  v vec.count 1 i32.add :> j
  31 j i32.clz i32.sub :> c
  j 1 c i32.shl i32.sub :> o
  o i32.eqz [
    1 c i32.shl array.new ( array T ) :> items
    v vec.chunks c items chunk.new array.at! ] when
  v vec.chunks c array.at chunk.items o x array.at!
  v j vec.count! ;

: vec.at ( vec T i32 -- T )
  :> i :> v
  i v vec.count i32.ge_u [ "vec.at: index out of range" trap ] when
  i 1 i32.add :> j
  31 j i32.clz i32.sub :> c
  v vec.chunks c array.at chunk.items  j 1 c i32.shl i32.sub  array.at ;

: vec.at! ( vec T i32 T -- )
  :> x :> i :> v
  i v vec.count i32.ge_u [ "vec.at!: index out of range" trap ] when
  i 1 i32.add :> j
  31 j i32.clz i32.sub :> c
  v vec.chunks c array.at chunk.items  j 1 c i32.shl i32.sub  x array.at! ;

: vec.pop ( vec T -- option T )
  :> v
  v vec.count i32.eqz
  [ option.none ]
  [ v vec.count 1 i32.sub :> i  v i vec.at  v i vec.count!  option.some ]
  if ;

: vec.to-array ( vec T -- array T )
  :> v
  v vec.count array.new ( array T ) :> a
  v vec.count [ :> i  a i  v i vec.at  array.at! ] times
  a ;

: vec.each ( vec T [ T -- ] -- )
  :> f :> v
  v vec.count [ :> i  v i vec.at f call ] times ;

: vec.fold ( vec T A [ A T -- A ] -- A )
  :> f :> acc :> v
  acc  v vec.count [ :> i  v i vec.at f call ] times ;

# A hash map: open addressing with linear probing over `hash` and `eq`.
# `used` is 0 for an empty slot, 1 for a live one, 2 for a removed one; the
# capacity is a power of two, doubled before half the slots are filled.
struct map K V  ks: array K  vs: array V  used: array i32  count: i32  filled: i32

: map.make ( -- map K V )
  8 array.new ( array K ) :> ks
  8 array.new ( array V ) :> vs
  8 array.new ( array i32 ) :> used
  ks vs used 0 0 map.new ;

: map.len ( map K V -- i32 )  map.count ;

# The slot holding k, or -1.
: map.find ( map K V K -- i32 )
  :> k :> m
  m map.used array.len 1 i32.sub :> mask
  k hash mask i32.and :> i!
  -1 :> r!
  [ 1 ] [
    m map.used i array.at :> u
    u i32.eqz [ leave ] when
    u 1 i32.eq [ m map.ks i array.at k eq [ i r! leave ] when ] when
    i 1 i32.add mask i32.and i! ]
  while
  r ;

# Store a key that is not present, in a map with room for it.
: map.put ( map K V K V -- )
  :> v :> k :> m
  m map.used array.len 1 i32.sub :> mask
  k hash mask i32.and :> i!
  [ m map.used i array.at 1 i32.eq ] [ i 1 i32.add mask i32.and i! ] while
  m map.used i array.at i32.eqz [ m  m map.filled 1 i32.add  map.filled! ] when
  m map.ks i k array.at!
  m map.vs i v array.at!
  m map.used i 1 array.at!
  m  m map.count 1 i32.add  map.count! ;

# Move every live entry into arrays twice as large.
: map.rehash ( map K V -- )
  :> m
  m map.ks :> oks
  m map.vs :> ovs
  m map.used :> oused
  oused array.len 2 i32.mul :> cap
  cap array.new ( array K ) :> ks
  cap array.new ( array V ) :> vs
  cap array.new ( array i32 ) :> used
  m ks map.ks!  m vs map.vs!  m used map.used!
  m 0 map.count!  m 0 map.filled!
  oused array.len [ :> i
    oused i array.at 1 i32.eq [ m  oks i array.at  ovs i array.at  map.put ] when ]
  times ;

: map.set ( map K V K V -- )
  :> v :> k :> m
  m k map.find :> at
  at 0 i32.ge_s
  [ m map.vs at v array.at! ]
  [ m map.filled 1 i32.add 2 i32.mul  m map.used array.len  i32.gt_s [ m map.rehash ] when
    m k v map.put ]
  if ;

: map.get ( map K V K -- option V )
  :> k :> m
  m k map.find :> i
  i 0 i32.lt_s [ option.none ] [ m map.vs i array.at option.some ] if ;

: map.has ( map K V K -- i32 )  map.find 0 i32.ge_s ;

: map.remove ( map K V K -- )
  :> k :> m
  m k map.find :> i
  i 0 i32.ge_s [ m map.used i 2 array.at!  m  m map.count 1 i32.sub  map.count! ] when ;

: map.keys ( map K V -- vec K )
  :> m
  vec.make ( vec K ) :> out
  m map.used array.len [ :> i
    m map.used i array.at 1 i32.eq [ out  m map.ks i array.at  vec.push ] when ]
  times
  out ;

: map.each ( map K V [ K V -- ] -- )
  :> f :> m
  m map.used array.len [ :> i
    m map.used i array.at 1 i32.eq [ m map.ks i array.at  m map.vs i array.at  f call ] when ]
  times ;

# ---------------------------------------------------------------- channels
# A channel: the host counts its senders and parks processes; the values
# never leave wasm, they wait in `q` from `head` on. The opcodes are the
# ring's (`layout.rs`).
struct chan T  id: i32  q: vec T  head: i32

: chan.make ( -- chan T )  vec.make ( vec T )  0 0 0 6 ring.submit  swap 0 chan.new ;  # OP_CHAN_MAKE

: chan.sender ( chan T -- )  chan.id 0 0 7 ring.submit drop ;  # OP_CHAN_SENDER

: chan.close ( chan T -- )  # OP_CHAN_CLOSE
  chan.id 0 0 10 ring.submit 0 i32.lt_s
  [ "chan.close: closed more times than it has senders" trap ]
  when ;

: chan.send ( chan T T -- )  # OP_CHAN_SEND
  :> x :> c
  c chan.q x vec.push
  c chan.id 0 0 8 ring.submit 0 i32.lt_s
  [ "chan.send: the channel is closed" trap ]
  when ;

# The front value of the queue; the queue is emptied once all are taken.
: chan.take ( chan T -- T )
  :> c
  c chan.q :> q
  c chan.head :> h
  h q vec.len i32.ge_s [ "chan.take: nothing queued" trap ] when
  q h vec.at
  h 1 i32.add :> n
  n q vec.len i32.eq
  [
    q vec.clear
    c 0 chan.head!
  ]
  [ c n chan.head! ]
  if ;

: chan.recv ( chan T -- option T )  # OP_CHAN_RECV
  :> c
  c chan.id 0 0 9 ring.submit
  [ c chan.take option.some ]
  [ option.none ]
  if ;

# What an `alt` arm receives: a value when the bit is 1, else none.
: chan.taken ( chan T i32 -- option T )
  [ chan.take option.some ]
  [ drop option.none ]
  if ;

# ---------------------------------------------------------------- timers

: time.sleep ( i32 -- )  0 0 12 ring.submit drop ;  # OP_SLEEP

# A channel that receives v once, ms milliseconds from now, and is then
# closed: an `alt` arm on it is a timeout. Nobody receiving leaves its
# process parked on the send.
: time.after ( T i32 -- chan T )
  :> ms :> v
  chan.make ( chan T ) :> c
  [ ms time.sleep  c v chan.send  c chan.close ] spawn
  c ;
