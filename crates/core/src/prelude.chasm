# Chasm prelude: library words written in Chasm, compiled with every program.
#
# Built on the primitives only. Strings are ( addr len ) pairs; see
# LANGUAGE.md section 4. I/O is four host words over a namespace; see
# LANGUAGE.md section 10.

# ---------------------------------------------------------------- strings

: str.byte-at ( str i32 -- i32 )
  :> i :> s
  i s str.len i32.ge_u [ "str.byte-at: offset out of range" trap ] when
  s str.addr i i32.add i32.load8_u ;

# Is byte offset i a codepoint boundary of s? (i == length counts.)
: str.boundary? ( str i32 -- i32 )
  :> i :> s
  i s str.len i32.eq
  [ 1 ]
  [ i s str.len i32.lt_u
    [ s str.addr i i32.add i32.load8_u 0xC0 i32.and 0x80 i32.ne ]
    [ 0 ] if ]
  if ;

: str.slice ( str i32 i32 -- str )
  :> n :> start :> s
  start s str.len i32.gt_u
  n s str.len start i32.sub i32.gt_u i32.or
  [ "str.slice: range out of bounds" trap ] when
  s start str.boundary? i32.eqz
  s start n i32.add str.boundary? i32.eqz i32.or
  [ "str.slice: not on a codepoint boundary" trap ] when
  s str.addr start i32.add n str.from-raw ;

: str.eq ( str str -- i32 )
  :> b :> a
  a str.len b str.len i32.ne
  [ 0 ]
  [ 1 :> r!
    a str.len [
      :> i
      a str.addr i i32.add i32.load8_u
      b str.addr i i32.add i32.load8_u
      i32.ne [ 0 r! leave ] when
    ] times
    r ]
  if ;

: str.concat ( str str -- str )
  :> b :> a
  a str.len b str.len i32.add :> n
  n mem.alloc :> p
  p a str.addr a str.len memory.copy
  p a str.len i32.add b str.addr b str.len memory.copy
  p n str.from-raw ;

# Decode the codepoint at byte offset i: ( codepoint byte-length ).
: str.cp-at ( str i32 -- i32 i32 )
  :> i :> s
  i s str.len i32.ge_u [ "str.cp-at: offset out of range" trap ] when
  s str.addr i i32.add :> p
  p i32.load8_u :> b0
  b0 0x80 i32.lt_u
  [ b0 1 ]
  [ b0 0xC0 i32.and 0x80 i32.eq [ "str.cp-at: not on a codepoint boundary" trap ] when
    b0 0xF8 i32.ge_u [ "str.cp-at: invalid UTF-8" trap ] when
    b0 0xE0 i32.lt_u
    [ b0 0x1F i32.and 2 ]
    [ b0 0xF0 i32.lt_u [ b0 0x0F i32.and 3 ] [ b0 0x07 i32.and 4 ] if ]
    if
    :> n :> acc!
    i n i32.add s str.len i32.gt_u [ "str.cp-at: truncated UTF-8 sequence" trap ] when
    n 1 i32.sub [
      1 i32.add p i32.add i32.load8_u :> c
      c 0xC0 i32.and 0x80 i32.ne [ "str.cp-at: invalid UTF-8" trap ] when
      acc 6 i32.shl c 0x3F i32.and i32.or acc!
    ] times
    acc n ]
  if ;

# A one-byte string.
: str.from-byte ( i32 -- str )
  :> b
  1 mem.alloc :> a
  a b i32.store8
  a 1 str.from-raw ;

# ---------------------------------------------------------------- numbers

: i64.to-str ( i64 -- str )
  :> v
  24 mem.alloc :> buf
  24 :> pos!
  v 0 i64 i64.lt_s :> neg
  # Work with a non-positive magnitude so that the minimum i64 is exact.
  v :> u!
  neg i32.eqz [ 0 i64 u i64.sub u! ] when
  [ pos 1 i32.sub pos!
    buf pos i32.add
    0 i64 u 10 i64 i64.rem_s i64.sub i32.wrap_i64 48 i32.add
    i32.store8
    u 10 i64 i64.div_s u! ]
  [ u i64.eqz ] until
  neg [ pos 1 i32.sub pos!  buf pos i32.add 45 i32.store8 ] when
  buf pos i32.add 24 pos i32.sub str.from-raw ;

# Exact widening; lossy conversions keep their wasm names.
: i64 ( i32 -- i64 )  i64.extend_i32_s ;

: i32.to-str ( i32 -- str )  i64 i64.to-str ;

# x rounded to d decimal places (f64.nearest: ties to even), as text.
# Traps when x * 10^d is beyond the i64 range.
: f64.fixed ( f64 i32 -- str )
  :> d :> x
  1 i64 :> unit!
  d [ drop  unit 10 i64 i64.mul unit! ] times
  x unit f64.convert_i64_s f64.mul f64.nearest i64.trunc_f64_s :> v
  v 0 i64 i64.lt_s [ 0 i64 v i64.sub ] [ v ] if :> a
  a unit i64.rem_s i64.to-str :> frac!
  [ frac str.len d i32.lt_s ] [ "0" frac str.concat frac! ] while
  v 0 i64 i64.lt_s [ "-" ] [ "" ] if
  a unit i64.div_s i64.to-str str.concat
  d [ "." str.concat frac str.concat ] when ;

# ---------------------------------------------------------------- arrays

# The elements in decimal, separated by single spaces.
: array.to-str ( array i32 -- str )
  :> a
  "" :> out!
  a array.len [ :> i
    i [ out " " str.concat out! ] when
    out a i array.at i32.to-str str.concat out!
  ] times
  out ;

# ---------------------------------------------------------------- I/O

: print ( str -- )
  :> s
  "/dev/cons" 1 host.open :> h
  h s str.addr s str.len host.write drop
  h host.close drop ;

: println ( str -- )  print "\n" print ;

# Read one line from the console, without its newline.
# The flag is 1 if a line was read, 0 at end of input.
: read-line ( -- str i32 )
  "/dev/cons" 0 host.open :> h
  256 :> cap!
  cap mem.alloc :> buf!
  0 :> n!
  0 :> eof!
  [ h buf n i32.add 1 host.read 1 i32.lt_s
    [ 1 eof! 0 ]
    [ buf n i32.add i32.load8_u 10 i32.ne ]
    if ]
  [ n 1 i32.add n!
    n cap i32.eq [
      cap 2 i32.mul mem.alloc :> nb
      nb buf n memory.copy
      nb buf!
      cap 2 i32.mul cap!
    ] when ]
  while
  h host.close drop
  buf n str.from-raw
  eof n i32.eqz i32.and i32.eqz ;

# Read a whole file by namespace path, e.g. "/file/etc/hostname".
# Status is 0 on success or a negative error code.
: read-file ( str -- str i32 )
  :> path
  path 0 host.open :> h
  h 0 i32.lt_s
  [ "" h ]
  [ 4096 :> cap!
    cap mem.alloc :> buf!
    0 :> n!
    0 :> r!
    [ h buf n i32.add cap n i32.sub host.read r!  r 0 i32.gt_s ]
    [ n r i32.add n!
      n cap i32.eq [
        cap 2 i32.mul mem.alloc :> nb
        nb buf n memory.copy
        nb buf!
        cap 2 i32.mul cap!
      ] when ]
    while
    h host.close drop
    buf n str.from-raw
    r 0 i32.lt_s [ r ] [ 0 ] if ]
  if ;

# Print the entries of a directory, one per line (directories get a
# trailing "/"). Status is 0 on success or a negative error code.
: ls ( str -- i32 )
  :> path
  path 0 host.open :> h
  h 0 i32.lt_s
  [ h ]
  [ 4096 mem.alloc :> buf
    0 :> r!
    [ h buf 4096 host.read r!  r 0 i32.gt_s ]
    [ 0 :> off!
      [ off r i32.lt_s ]
      [ buf off i32.add :> rec
        rec i32.load :> nlen
        rec 4 i32.add nlen str.from-raw :> name
        rec 4 i32.add nlen i32.add 8 i32.add i32.load8_u :> isdir
        name print
        isdir [ "/" print ] when
        "\n" print
        off 13 nlen i32.add i32.add off! ]
      while ]
    while
    h host.close drop
    r 0 i32.lt_s [ r ] [ 0 ] if ]
  if ;

# Current time in nanoseconds since the Unix epoch.
: now ( -- i64 )
  "/dev/time" 0 host.open :> h
  8 mem.alloc :> buf
  h buf 8 host.read drop
  h host.close drop
  buf i64.load ;

# ---------------------------------------------------------------- unions
# An optional value: `option.none` or `x option.some`, matched with
# `none: [ ... ] some: [ ... ] match`.
union option T | none | some  v: T

# ---------------------------------------------------------------- collections
# A growable array: chunks of 1, 2, 4, ... elements, so storage never moves.
# Element i is in chunk 31 - clz(i + 1), at offset i + 1 - 2^chunk.
struct chunk T  items: array T
struct vec T  chunks: array chunk T  count: i32

: vec.make ( -- vec T )  32 array.new ( array chunk T ) 0 vec.new ;
: vec.len ( vec T -- i32 )  vec.count ;
: vec.clear ( vec T -- )  0 vec.count! ;

: vec.push ( vec T T -- )
  :> x :> v
  v vec.count 1 i32.add :> j
  31 j i32.clz i32.sub :> c
  j 1 c i32.shl i32.sub :> o
  o i32.eqz [
    1 c i32.shl array.new ( array T ) :> items
    v vec.chunks c items chunk.new array.at! ] when
  v vec.chunks c array.at chunk.items o x array.at!
  v j vec.count! ;

: vec.at ( vec T i32 -- T )
  :> i :> v
  i v vec.count i32.ge_u [ "vec.at: index out of range" trap ] when
  i 1 i32.add :> j
  31 j i32.clz i32.sub :> c
  v vec.chunks c array.at chunk.items  j 1 c i32.shl i32.sub  array.at ;

: vec.at! ( vec T i32 T -- )
  :> x :> i :> v
  i v vec.count i32.ge_u [ "vec.at!: index out of range" trap ] when
  i 1 i32.add :> j
  31 j i32.clz i32.sub :> c
  v vec.chunks c array.at chunk.items  j 1 c i32.shl i32.sub  x array.at! ;

: vec.pop ( vec T -- option T )
  :> v
  v vec.count i32.eqz
  [ option.none ]
  [ v vec.count 1 i32.sub :> i  v i vec.at  v i vec.count!  option.some ]
  if ;

: vec.to-array ( vec T -- array T )
  :> v
  v vec.count array.new ( array T ) :> a
  v vec.count [ :> i  a i  v i vec.at  array.at! ] times
  a ;

: vec.each ( vec T [ T -- ] -- )
  :> f :> v
  v vec.count [ :> i  v i vec.at f call ] times ;

: vec.fold ( vec T A [ A T -- A ] -- A )
  :> f :> acc :> v
  acc  v vec.count [ :> i  v i vec.at f call ] times ;

# A hash map: open addressing with linear probing over `hash` and `eq`.
# `used` is 0 for an empty slot, 1 for a live one, 2 for a removed one; the
# capacity is a power of two, doubled before half the slots are filled.
struct map K V  ks: array K  vs: array V  used: array i32  count: i32  filled: i32

: map.make ( -- map K V )
  8 array.new ( array K ) :> ks
  8 array.new ( array V ) :> vs
  8 array.new ( array i32 ) :> used
  ks vs used 0 0 map.new ;

: map.len ( map K V -- i32 )  map.count ;

# The slot holding k, or -1.
: map.find ( map K V K -- i32 )
  :> k :> m
  m map.used array.len 1 i32.sub :> mask
  k hash mask i32.and :> i!
  -1 :> r!
  [ 1 ] [
    m map.used i array.at :> u
    u i32.eqz [ leave ] when
    u 1 i32.eq [ m map.ks i array.at k eq [ i r! leave ] when ] when
    i 1 i32.add mask i32.and i! ]
  while
  r ;

# Store a key that is not present, in a map with room for it.
: map.put ( map K V K V -- )
  :> v :> k :> m
  m map.used array.len 1 i32.sub :> mask
  k hash mask i32.and :> i!
  [ m map.used i array.at 1 i32.eq ] [ i 1 i32.add mask i32.and i! ] while
  m map.used i array.at i32.eqz [ m  m map.filled 1 i32.add  map.filled! ] when
  m map.ks i k array.at!
  m map.vs i v array.at!
  m map.used i 1 array.at!
  m  m map.count 1 i32.add  map.count! ;

# Move every live entry into arrays twice as large.
: map.rehash ( map K V -- )
  :> m
  m map.ks :> oks
  m map.vs :> ovs
  m map.used :> oused
  oused array.len 2 i32.mul :> cap
  cap array.new ( array K ) :> ks
  cap array.new ( array V ) :> vs
  cap array.new ( array i32 ) :> used
  m ks map.ks!  m vs map.vs!  m used map.used!
  m 0 map.count!  m 0 map.filled!
  oused array.len [ :> i
    oused i array.at 1 i32.eq [ m  oks i array.at  ovs i array.at  map.put ] when ]
  times ;

: map.set ( map K V K V -- )
  :> v :> k :> m
  m k map.find :> at
  at 0 i32.ge_s
  [ m map.vs at v array.at! ]
  [ m map.filled 1 i32.add 2 i32.mul  m map.used array.len  i32.gt_s [ m map.rehash ] when
    m k v map.put ]
  if ;

: map.get ( map K V K -- option V )
  :> k :> m
  m k map.find :> i
  i 0 i32.lt_s [ option.none ] [ m map.vs i array.at option.some ] if ;

: map.has ( map K V K -- i32 )  map.find 0 i32.ge_s ;

: map.remove ( map K V K -- )
  :> k :> m
  m k map.find :> i
  i 0 i32.ge_s [ m map.used i 2 array.at!  m  m map.count 1 i32.sub  map.count! ] when ;

: map.keys ( map K V -- vec K )
  :> m
  vec.make ( vec K ) :> out
  m map.used array.len [ :> i
    m map.used i array.at 1 i32.eq [ out  m map.ks i array.at  vec.push ] when ]
  times
  out ;

: map.each ( map K V [ K V -- ] -- )
  :> f :> m
  m map.used array.len [ :> i
    m map.used i array.at 1 i32.eq [ m map.ks i array.at  m map.vs i array.at  f call ] when ]
  times ;
