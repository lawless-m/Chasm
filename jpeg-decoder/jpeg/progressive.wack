# libjpeg's decode_mcu_DC_first for one block: scanner, store, ci (the
# predictor), td (the DC table slot), Al and the block's coefficient index.
# The difference is decoded and extended as in a sequential scan, added to
# the predictor (an int that wraps), and stored shifted left by Al, as
# (JCOEF)(s << Al), overwriting block[0].
declare prog.dc-first ( scanner coeffs i32 i32 i32 i32 -- )

# libjpeg's decode_mcu_DC_refine: scanner, store, Al, the block's index.
# One bit; when set, block[0] |= 1 << Al.
declare prog.dc-refine ( scanner coeffs i32 i32 -- )

: prog.dc-first ( scanner coeffs i32 i32 i32 i32 -- )
  :> off :> al :> td :> ci :> store :> sc
  sc scanner.br :> br
  br  sc scanner.tabs td array.at  huffman.decode :> s0
  s0 [ br s0 huffman.receive-extend ] [ 0 ] if  sc scanner.pred ci array.at  i32.add :> dc
  sc scanner.pred ci dc array.at!
  store off  dc al i32.shl  coeffs.set ;

: prog.dc-refine ( scanner coeffs i32 i32 -- )
  :> off :> al :> store :> sc
  sc scanner.br 1 bits.get
  [ store off  store off coeffs.get  1 al i32.shl  i32.or  coeffs.set ]
  when ;

# Test fixtures: a two-block 16x8 store; DC first over n blocks with the K.3
# tables, returning the store or the scanner; DC refine over n blocks whose
# DC was preset, returning the store or the scanner.
: fx.store2 ( -- coeffs )  8 16 8 1 1 0 fx.one 1 coeffs.make ;
: fx.dcf-run ( str i32 i32 i32 -- scanner coeffs )
  :> pre :> n :> al :> h
  h fx.lum-tabs 0 n fx.scanner :> sc
  sc scanner.pred 0 pre array.at!
  fx.store2 :> st
  n [ :> b  sc st 0 0 al b 64 i32.mul prog.dc-first ] times
  sc st ;
: fx.dcf ( str i32 i32 -- coeffs )  0 fx.dcf-run nip ;
: fx.dcf-sc ( str i32 i32 -- scanner )  0 fx.dcf-run drop ;
: fx.dcr-run ( str i32 i32 i32 -- scanner coeffs )
  :> n :> pre :> al :> h
  h fx.lum-tabs 0 n fx.scanner :> sc
  fx.store2 :> st
  st 0 pre coeffs.set
  st 64 pre coeffs.set
  n [ :> b  sc st al b 64 i32.mul prog.dc-refine ] times
  sc st ;
: fx.dcr ( str i32 i32 i32 -- coeffs )  fx.dcr-run nip ;

