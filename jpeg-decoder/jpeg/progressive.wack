# libjpeg's decode_mcu_AC_first for one block: scanner, store, ta (the AC
# table is slot 4 + ta), Ss, Se, Al and the block's coefficient index. A
# pending EOB run skips the block; otherwise coefficients Ss..Se are decoded
# with ZRL and EOBn (a run of 2^r blocks plus r extra bits, this block
# included), each stored as (JCOEF)(value << Al) at its natural position.
# A nonzero coefficient whose run carries it past Se is BAD_ENTROPY_DATA
# (strict; libjpeg writes through its safety entries); a ZRL past Se, or an
# EOB run left over at the end of a scan, is not an error.
declare prog.ac-first ( scanner coeffs i32 i32 i32 i32 i32 -- )

: prog.ac-first ( scanner coeffs i32 i32 i32 i32 i32 -- )
  :> off :> al :> se :> ss :> ta :> store :> sc
  sc scanner.eobrun :> run
  run 0 i32.gt_s
  [ sc run 1 i32.sub scanner.eobrun! ]
  [
    sc scanner.br :> br
    sc scanner.tabs 4 ta i32.add array.at :> tab
    sc scanner.natural :> nat
    ss :> k!
    [ k se i32.le_s ]
    [
      br tab huffman.decode :> rs
      rs 4 i32.shr_u :> r
      rs 15 i32.and :> sz
      sz
      [
        k r i32.add k!
        k se i32.gt_s [ BAD_ENTROPY_DATA "coefficient run past the end of the band" refusal trap ] when
        store  off nat k array.at i32.add  br sz huffman.receive-extend al i32.shl  coeffs.set
        k 1 i32.add k!
      ]
      [
        r 15 i32.eq
        [ k 16 i32.add k! ]
        [
          1 r i32.shl  r [ br r bits.get ] [ 0 ] if  i32.add 1 i32.sub :> eob
          sc eob scanner.eobrun!
          se 1 i32.add k!
        ]
        if
      ]
      if
    ]
    while
  ]
  if ;

# Test fixtures: an AC table of three 2-bit codes and one 3-bit code (00 is
# 0x01, 01 is EOB, 10 is EOB2, 110 is ZRL); tables with it in slot 4; one
# AC first block decoded into a fresh two-block store at offset 0.
: fx.ac-eob ( -- hufftable )  "000301" "00" 13 fx.rep str.concat "010020F0" str.concat hex 0 0 huffman.build ;
: fx.eob-tabs ( -- array hufftable )
  8 array.new ( array hufftable ) :> t
  t 0 fx.dc-lum array.at!
  t 4 fx.ac-eob array.at!
  t ;
: fx.acf ( str array hufftable i32 i32 i32 i32 -- scanner coeffs )
  :> al :> se :> ss :> pre :> tabs :> h
  h tabs 0 2 fx.scanner :> sc
  sc pre scanner.eobrun!
  fx.store2 :> st
  sc st 0 ss se al 0 prog.ac-first
  sc st ;

test fx.ac-eob : fx.ac-eob hufftable.nsymbols -> 4
test fx.ac-eob : "00" hex 0 bits.open fx.ac-eob huffman.decode -> 1
test fx.ac-eob : "40" hex 0 bits.open fx.ac-eob huffman.decode -> 0
