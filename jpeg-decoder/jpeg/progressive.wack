# Block smoothing (libjpeg-turbo 3.2.0's smoothing_ok and
# decompress_smooth_data in jdcoefct.c). djpeg applies it by default to a
# progressive file whose coefficients are not all known when output is
# produced; no flag turns it off. All scans are consumed before output and
# strict mode refuses a scan that ends early, so only the final coef_bits
# are used (libjpeg's last_good_iMCU_row case never arises).

struct smoother  store: coeffs  prog: progress  quants: array i32  dcs: array i32

# The store, the progression state and the latched quantisation tables
# (natural order, component ci at ci*64): the 25-entry DC workspace is
# allocated once here.
declare prog.smoother ( coeffs progress array i32 -- smoother )

# smoothing_ok: every component's table is nonzero at natural positions 0 1
# 8 16 9 2 3 10 17 24 and its DC has been scanned, and some coefficient 1..9
# (zigzag) of some component is not known exactly (coef_bits not 0).
declare prog.smooth? ( smoother -- i32 )

# One block: smoother, ci, bw (width_in_blocks), bx, row (the absolute block
# row in the padded grid), ibr and ibrs (libjpeg's image_block_row and
# image_block_rows, which use the reduced block_rows of the last iMCU row),
# and the 64-entry block, modified in place. The 25 DCs are rows row-2 to
# row+2 by columns bx-2 to bx+2; libjpeg's sliding registers with their
# first- and last-column cases equal clamping the column to 0..bw-1, and its
# rows are chosen by ibr as the C does. Each still-zero coefficient among the
# first nine AC ones whose Al is not 0 gets an estimate, clamped to
# (1 << Al) - 1 when Al > 0; with no AC data at all (change_dc) four more
# and the DC itself are estimated too. num is a JLONG (i64).
declare prog.smooth ( smoother i32 i32 i32 i32 i32 i32 array i32 -- )

# One estimate: Q00, the kernel sum, Qk and Al (0 for no clamp): the
# (JCOEF) prediction.
declare prog.pred ( i64 i32 i64 i32 -- i32 )

: prog.smoother ( coeffs progress array i32 -- smoother )
  :> qs :> p :> st
  25 array.new ( array i32 ) :> d
  st p qs d smoother.new ;

: prog.smooth? ( smoother -- i32 )
  :> sm
  sm smoother.prog :> p
  p progress.bits :> b
  sm smoother.quants :> qs
  "000108100902030A1118" hex :> pos
  1 :> ok!
  0 :> useful!
  p progress.ncomp
  [
    :> ci
    ci 64 i32.mul :> qb
    10 [ :> qz  qs  qb  pos qz bytes.at  i32.add  array.at i32.eqz [ 0 ok! ] when ] times
    b qb array.at 0 i32.lt_s [ 0 ok! ] when
    9 [ :> z  b qb z i32.add 1 i32.add array.at [ 1 useful! ] when ] times
  ]
  times
  ok useful i32.and ;

: prog.pred ( i64 i32 i64 i32 -- i32 )
  :> al :> q :> sum :> q00
  q00 sum i64 i64.mul :> num
  q 7 i64 i64.shl :> half
  q 8 i64 i64.shl :> den
  num 0 i64 i64.ge_s
  [
    half num i64.add den i64.div_s i32.wrap_i64 :> pp
    al 0 i32.gt_s  pp 1 al i32.shl i32.ge_s  i32.and [ 1 al i32.shl 1 i32.sub ] [ pp ] if
  ]
  [
    half num i64.sub den i64.div_s i32.wrap_i64 :> pn
    al 0 i32.gt_s  pn 1 al i32.shl i32.ge_s  i32.and [ 1 al i32.shl 1 i32.sub ] [ pn ] if
    0 swap i32.sub
  ]
  if
  i32.extend16_s ;

: prog.smooth ( smoother i32 i32 i32 i32 i32 i32 array i32 -- )
  :> blk :> ibrs :> ibr :> row :> bx :> bw :> ci :> sm
  sm smoother.store :> st
  sm smoother.prog progress.bits :> pb
  sm smoother.quants :> qs
  sm smoother.dcs :> dcs
  ci 64 i32.mul :> cb
  ibr 0 i32.gt_s [ row 1 i32.sub ] [ row ] if :> prev
  ibr 1 i32.gt_s [ row 2 i32.sub ] [ prev ] if :> pprev
  ibr ibrs 1 i32.sub i32.lt_s [ row 1 i32.add ] [ row ] if :> next
  ibr ibrs 2 i32.sub i32.lt_s [ row 2 i32.add ] [ next ] if :> nnext
  5
  [
    :> rr
    rr 0 i32.eq [ pprev ] [ rr 1 i32.eq [ prev ] [ rr 2 i32.eq [ row ] [ rr 3 i32.eq [ next ] [ nnext ] if ] if ] if ] if :> r
    5
    [
      :> cc
      bx cc i32.add 2 i32.sub 0 imax :> c0
      c0 bw 1 i32.sub i32.gt_s [ bw 1 i32.sub ] [ c0 ] if :> col
      dcs  rr 5 i32.mul cc i32.add  st  st ci col r coeffs.block  coeffs.get  array.at!
    ]
    times
  ]
  times
  dcs 0 array.at :> d01
  dcs 1 array.at :> d02
  dcs 2 array.at :> d03
  dcs 3 array.at :> d04
  dcs 4 array.at :> d05
  dcs 5 array.at :> d06
  dcs 6 array.at :> d07
  dcs 7 array.at :> d08
  dcs 8 array.at :> d09
  dcs 9 array.at :> d10
  dcs 10 array.at :> d11
  dcs 11 array.at :> d12
  dcs 12 array.at :> d13
  dcs 13 array.at :> d14
  dcs 14 array.at :> d15
  dcs 15 array.at :> d16
  dcs 16 array.at :> d17
  dcs 17 array.at :> d18
  dcs 18 array.at :> d19
  dcs 19 array.at :> d20
  dcs 20 array.at :> d21
  dcs 21 array.at :> d22
  dcs 22 array.at :> d23
  dcs 23 array.at :> d24
  dcs 24 array.at :> d25
  1 :> cd!
  9 [ :> z  pb cb z i32.add 1 i32.add array.at -1 i32.ne [ 0 cd! ] when ] times
  qs cb array.at i64 :> q00
  pb cb 1 i32.add array.at :> a1
  a1 0 i32.ne  blk 1 array.at i32.eqz  i32.and
  [ blk 1  q00  cd [ d01 -1 i32.mul d02 -1 i32.mul i32.add d04 i32.add d05 i32.add d06 -3 i32.mul i32.add d07 13 i32.mul i32.add d09 -13 i32.mul i32.add d10 3 i32.mul i32.add d11 -3 i32.mul i32.add d12 38 i32.mul i32.add d14 -38 i32.mul i32.add d15 3 i32.mul i32.add d16 -3 i32.mul i32.add d17 13 i32.mul i32.add d19 -13 i32.mul i32.add d20 3 i32.mul i32.add d21 -1 i32.mul i32.add d22 -1 i32.mul i32.add d24 i32.add d25 i32.add ] [ d11 -7 i32.mul d12 50 i32.mul i32.add d14 -50 i32.mul i32.add d15 7 i32.mul i32.add ] if  qs cb 1 i32.add array.at i64  a1  prog.pred  array.at! ]
  when
  pb cb 2 i32.add array.at :> a8
  a8 0 i32.ne  blk 8 array.at i32.eqz  i32.and
  [ blk 8  q00  cd [ d01 -1 i32.mul d02 -3 i32.mul i32.add d03 -3 i32.mul i32.add d04 -3 i32.mul i32.add d05 -1 i32.mul i32.add d06 -1 i32.mul i32.add d07 13 i32.mul i32.add d08 38 i32.mul i32.add d09 13 i32.mul i32.add d10 -1 i32.mul i32.add d16 i32.add d17 -13 i32.mul i32.add d18 -38 i32.mul i32.add d19 -13 i32.mul i32.add d20 i32.add d21 i32.add d22 3 i32.mul i32.add d23 3 i32.mul i32.add d24 3 i32.mul i32.add d25 i32.add ] [ d03 -7 i32.mul d08 50 i32.mul i32.add d18 -50 i32.mul i32.add d23 7 i32.mul i32.add ] if  qs cb 8 i32.add array.at i64  a8  prog.pred  array.at! ]
  when
  pb cb 3 i32.add array.at :> a16
  a16 0 i32.ne  blk 16 array.at i32.eqz  i32.and
  [ blk 16  q00  cd [ d03 d07 2 i32.mul i32.add d08 7 i32.mul i32.add d09 2 i32.mul i32.add d12 -5 i32.mul i32.add d13 -14 i32.mul i32.add d14 -5 i32.mul i32.add d17 2 i32.mul i32.add d18 7 i32.mul i32.add d19 2 i32.mul i32.add d23 i32.add ] [ d03 -1 i32.mul d08 13 i32.mul i32.add d13 -24 i32.mul i32.add d18 13 i32.mul i32.add d23 -1 i32.mul i32.add ] if  qs cb 16 i32.add array.at i64  a16  prog.pred  array.at! ]
  when
  pb cb 4 i32.add array.at :> a9
  a9 0 i32.ne  blk 9 array.at i32.eqz  i32.and
  [ blk 9  q00  cd [ d01 -1 i32.mul d05 i32.add d07 9 i32.mul i32.add d09 -9 i32.mul i32.add d17 -9 i32.mul i32.add d19 9 i32.mul i32.add d21 i32.add d25 -1 i32.mul i32.add ] [ d10 d16 i32.add d17 -10 i32.mul i32.add d19 10 i32.mul i32.add d02 -1 i32.mul i32.add d20 -1 i32.mul i32.add d22 i32.add d24 -1 i32.mul i32.add d04 i32.add d06 -1 i32.mul i32.add d07 10 i32.mul i32.add d09 -10 i32.mul i32.add ] if  qs cb 9 i32.add array.at i64  a9  prog.pred  array.at! ]
  when
  pb cb 5 i32.add array.at :> a2
  a2 0 i32.ne  blk 2 array.at i32.eqz  i32.and
  [ blk 2  q00  cd [ d07 2 i32.mul d08 -5 i32.mul i32.add d09 2 i32.mul i32.add d11 i32.add d12 7 i32.mul i32.add d13 -14 i32.mul i32.add d14 7 i32.mul i32.add d15 i32.add d17 2 i32.mul i32.add d18 -5 i32.mul i32.add d19 2 i32.mul i32.add ] [ d11 -1 i32.mul d12 13 i32.mul i32.add d13 -24 i32.mul i32.add d14 13 i32.mul i32.add d15 -1 i32.mul i32.add ] if  qs cb 2 i32.add array.at i64  a2  prog.pred  array.at! ]
  when
  cd
  [
    pb cb 6 i32.add array.at :> a3
    a3 0 i32.ne  blk 3 array.at i32.eqz  i32.and
    [ blk 3  q00  d07 d09 -1 i32.mul i32.add d12 2 i32.mul i32.add d14 -2 i32.mul i32.add d17 i32.add d19 -1 i32.mul i32.add  qs cb 3 i32.add array.at i64  a3  prog.pred  array.at! ]
    when
    pb cb 7 i32.add array.at :> a10
    a10 0 i32.ne  blk 10 array.at i32.eqz  i32.and
    [ blk 10  q00  d07 d08 -3 i32.mul i32.add d09 i32.add d17 -1 i32.mul i32.add d18 3 i32.mul i32.add d19 -1 i32.mul i32.add  qs cb 10 i32.add array.at i64  a10  prog.pred  array.at! ]
    when
    pb cb 8 i32.add array.at :> a17
    a17 0 i32.ne  blk 17 array.at i32.eqz  i32.and
    [ blk 17  q00  d07 d09 -1 i32.mul i32.add d12 -3 i32.mul i32.add d14 3 i32.mul i32.add d17 i32.add d19 -1 i32.mul i32.add  qs cb 17 i32.add array.at i64  a17  prog.pred  array.at! ]
    when
    pb cb 9 i32.add array.at :> a24
    a24 0 i32.ne  blk 24 array.at i32.eqz  i32.and
    [ blk 24  q00  d07 d08 2 i32.mul i32.add d09 i32.add d17 -1 i32.mul i32.add d18 -2 i32.mul i32.add d19 -1 i32.mul i32.add  qs cb 24 i32.add array.at i64  a24  prog.pred  array.at! ]
    when
    blk 0  q00  d01 -2 i32.mul d02 -6 i32.mul i32.add d03 -8 i32.mul i32.add d04 -6 i32.mul i32.add d05 -2 i32.mul i32.add d06 -6 i32.mul i32.add d07 6 i32.mul i32.add d08 42 i32.mul i32.add d09 6 i32.mul i32.add d10 -6 i32.mul i32.add d11 -8 i32.mul i32.add d12 42 i32.mul i32.add d13 152 i32.mul i32.add d14 42 i32.mul i32.add d15 -8 i32.mul i32.add d16 -6 i32.mul i32.add d17 6 i32.mul i32.add d18 42 i32.mul i32.add d19 6 i32.mul i32.add d20 -6 i32.mul i32.add d21 -2 i32.mul i32.add d22 -6 i32.mul i32.add d23 -8 i32.mul i32.add d24 -6 i32.mul i32.add d25 -2 i32.mul i32.add  q00  0  prog.pred  array.at!
  ]
  when ;

# Test fixtures: a progress for one component with coef_bits[0] = 0 and 1..9
# from a hex list of bytes (FF for -1); a 3x1-block store with three DCs;
# one smoothed block of it; a 1x5-block store with DCs 0 0 100 0 0 down the
# column, smoothed at block row r.
: fx.bits ( str -- progress )
  :> h
  1 prog.make :> p
  p progress.bits 0 0 array.at!
  h hex :> b
  9 [ :> i  p progress.bits i 1 i32.add  b i bytes.at i32.extend8_s  array.at! ] times
  p ;
: fx.dc-only ( -- progress )  "FFFFFFFFFFFFFFFFFF" fx.bits ;
: fx.sm-row ( progress array i32 i32 i32 i32 i32 i32 -- array i32 )
  :> pre :> bx :> c2 :> c1 :> c0 :> qs :> p
  8 24 8 1 1 0 fx.one 1 coeffs.make :> st
  st 0 c0 coeffs.set
  st 64 c1 coeffs.set
  st 128 c2 coeffs.set
  64 array.new ( array i32 ) :> blk
  st bx 64 i32.mul blk coeffs.get-block
  blk 1 pre array.at!
  st p qs prog.smoother 0 3 bx 0 0 1 blk prog.smooth
  blk ;
: fx.sm-a ( i32 -- array i32 )  :> bx  fx.dc-only fx.ones 10 20 40 bx 0 fx.sm-row ;
: fx.sm-b ( i32 -- array i32 )  :> bx  fx.dc-only fx.ready 0 idct.quant -40 100 30 bx 0 fx.sm-row ;
: fx.sm-c ( i32 -- array i32 )  :> pre  "0101010101FFFFFFFF" fx.bits fx.ones 0 200 0 1 pre fx.sm-row ;
: fx.sm-d ( i32 -- array i32 )
  :> r
  8 8 40 1 1 0 fx.one 1 coeffs.make :> st
  st  st 0 0 2 coeffs.block  100 coeffs.set
  64 array.new ( array i32 ) :> blk
  st  st 0 0 r coeffs.block  blk coeffs.get-block
  st fx.dc-only fx.ones prog.smoother 0 1 0 r r 5 blk prog.smooth
  blk ;
: fx.sm? ( progress array i32 -- i32 )
  :> qs :> p
  fx.grey 1 coeffs.make p qs prog.smoother prog.smooth? ;

test prog.smooth : 0 fx.sm-a 0 array.at -> 9
test prog.smooth : 0 fx.sm-a 1 array.at -> -1
test prog.smooth : 0 fx.sm-a 2 array.at -> 1
test prog.smooth : 1 fx.sm-a 0 array.at -> 21
test prog.smooth : 1 fx.sm-a 1 array.at -> -6
test prog.smooth : 1 fx.sm-a 2 array.at -> 0
test prog.smooth : 2 fx.sm-a 0 array.at -> 40
test prog.smooth : 2 fx.sm-a 1 array.at -> -4
test prog.smooth : 2 fx.sm-a 2 array.at -> -1
test prog.smooth : 0 fx.sm-b 0 array.at -> -24
test prog.smooth : 0 fx.sm-b 1 array.at -> -45
test prog.smooth : 0 fx.sm-b 2 array.at -> 10
test prog.smooth : 0 fx.sm-b 3 array.at -> -2
test prog.smooth : 0 fx.sm-b 16 array.at -> -1
test prog.smooth : 0 fx.sm-b 17 array.at -> 1
test prog.smooth : 1 fx.sm-b 0 array.at -> 85
test prog.smooth : 1 fx.sm-b 1 array.at -> -20
test prog.smooth : 1 fx.sm-b 2 array.at -> -16
test prog.smooth : 1 fx.sm-b 3 array.at -> -1
test prog.smooth : 1 fx.sm-b 16 array.at -> 1
test prog.smooth : 2 fx.sm-b 0 array.at -> 48
test prog.smooth : 2 fx.sm-b 1 array.at -> 29
test prog.smooth : 2 fx.sm-b 2 array.at -> 4
test prog.smooth : 2 fx.sm-b 3 array.at -> 1
test prog.smooth : 0 fx.sm-c 0 array.at -> 200
test prog.smooth : 0 fx.sm-c 2 array.at -> -1
test prog.smooth : 0 fx.sm-c 1 array.at -> 0
test prog.smooth : 5 fx.sm-c 1 array.at -> 5
test prog.smooth : 5 fx.sm-c 2 array.at -> -1
test prog.smooth : 0 fx.sm-d 0 array.at -> -9
test prog.smooth : 0 fx.sm-d 8 array.at -> 4
test prog.smooth : 1 fx.sm-d 0 array.at -> 16
test prog.smooth : 1 fx.sm-d 8 array.at -> -24
test prog.smooth : 1 fx.sm-d 16 array.at -> 4
test prog.smooth : 1 fx.sm-d 24 array.at -> -2
test prog.smooth : 2 fx.sm-d 0 array.at -> 86
test prog.smooth : 2 fx.sm-d 2 array.at -> 1
test prog.smooth : 2 fx.sm-d 16 array.at -> -9
test prog.smooth : 2 fx.sm-d 1 array.at -> 0
test prog.smooth : 3 fx.sm-d 0 array.at -> 16
test prog.smooth : 3 fx.sm-d 8 array.at -> 24
test prog.smooth : 3 fx.sm-d 16 array.at -> 4
test prog.smooth : 3 fx.sm-d 24 array.at -> 2
test prog.smooth : 4 fx.sm-d 0 array.at -> -9
test prog.smooth : 4 fx.sm-d 8 array.at -> -4
test prog.smooth? : fx.dc-only fx.ones fx.sm? -> 1
test prog.smooth? : fx.dc-only dup progress.bits 0 -1 array.at! fx.ones fx.sm? -> 0
test prog.smooth? : "000000000000000000" fx.bits fx.ones fx.sm? -> 0
test prog.smooth? : "000000000100000000" fx.bits fx.ones fx.sm? -> 1
test prog.smooth? : fx.dc-only fx.ones dup 1 0 array.at! fx.sm? -> 0
: fx.ones128 ( -- array i32 )
  128 array.new ( array i32 ) :> a
  128 [ :> i  a i 1 array.at! ] times
  a ;
test prog.smooth? : 2 prog.make dup progress.bits 0 0 array.at! fx.ones128 fx.sm? -> 0
