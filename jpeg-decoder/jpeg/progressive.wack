test prog.ac-first : "C500" fx.lum-tabs 0 1 63 0 fx.acf nip 8 coeffs.get -> -1
test prog.ac-first : "C500" fx.lum-tabs 0 1 63 0 fx.acf drop scanner.eobrun -> 0
test prog.ac-first : "C500" fx.lum-tabs 0 1 63 0 fx.acf drop scanner.br bitreader.nbits -> 7
test prog.ac-first : "C500" fx.lum-tabs 0 1 1 0 fx.acf -> trap
test prog.ac-first : "2F" fx.eob-tabs 0 1 63 0 fx.acf nip 64 coeffs.get -> 0

# A correction bit for the coefficient at an index, if it is nonzero:
# reader, store, index, p1 = 1 << Al, m1 = -1 << Al. A 1 adds p1 (or m1 for
# a negative coefficient) unless that bit is already set. libjpeg's
# decode_mcu_AC_refine does this in two places; both use this word.
declare prog.correct ( bitreader coeffs i32 i32 i32 -- )

# libjpeg's decode_mcu_AC_refine for one block (G.1.2.3): scanner, store,
# ta, Ss, Se, Al and the block's index. Each symbol places one new +-1 << Al
# coefficient after skipping r zero coefficients, sending a correction bit
# for every nonzero coefficient passed on the way; an EOB run sends
# correction bits for the nonzero coefficients left in the band. Strict: a
# new coefficient of size other than 1 (libjpeg warns JWRN_HUFF_BAD_CODE),
# or one placed past Se, is BAD_ENTROPY_DATA. libjpeg's newnz_pos undo list
# serves input suspension only and is not needed.
declare prog.ac-refine ( scanner coeffs i32 i32 i32 i32 i32 -- )

: prog.correct ( bitreader coeffs i32 i32 i32 -- )
  :> m1 :> p1 :> idx :> store :> br
  store idx coeffs.get :> v
  v
  [
    br 1 bits.get  v p1 i32.and i32.eqz  i32.and
    [ store idx  v  v 0 i32.ge_s [ p1 ] [ m1 ] if  i32.add  coeffs.set ]
    when
  ]
  when ;

: prog.ac-refine ( scanner coeffs i32 i32 i32 i32 i32 -- )
  :> off :> al :> se :> ss :> ta :> store :> sc
  sc scanner.br :> br
  sc scanner.natural :> nat
  1 al i32.shl :> p1
  -1 al i32.shl :> m1
  ss :> k!
  sc scanner.eobrun i32.eqz
  [
    sc scanner.tabs 4 ta i32.add array.at :> tab
    1 :> go!
    [ go  k se i32.le_s  i32.and ]
    [
      br tab huffman.decode :> rs
      rs 4 i32.shr_u :> r!
      rs 15 i32.and :> sz
      0 :> s!
      sz
      [
        sz 1 i32.ne [ BAD_ENTROPY_DATA "refinement coefficient size not 1" sz refusal-n trap ] when
        br 1 bits.get [ p1 ] [ m1 ] if s!
      ]
      [
        r 15 i32.ne
        [
          sc  1 r i32.shl  r [ br r bits.get ] [ 0 ] if  i32.add  scanner.eobrun!
          0 go!
        ]
        when
      ]
      if
      go
      [
        1 :> more!
        [ more ]
        [
          off nat k array.at i32.add :> idx
          store idx coeffs.get
          [ br store idx p1 m1 prog.correct ]
          [ r 1 i32.sub r!  r 0 i32.lt_s [ 0 more! ] when ]
          if
          more [ k 1 i32.add k!  k se i32.gt_s [ 0 more! ] when ] when
        ]
        while
        s
        [
          k se i32.gt_s [ BAD_ENTROPY_DATA "coefficient run past the end of the band" refusal trap ] when
          store  off nat k array.at i32.add  s coeffs.set
        ]
        when
        k 1 i32.add k!
      ]
      when
    ]
    while
  ]
  when
  sc scanner.eobrun 0 i32.gt_s
  [
    se k i32.sub 1 i32.add 0 imax
    [ :> j  br store  off nat k j i32.add array.at i32.add  p1 m1 prog.correct ]
    times
    sc  sc scanner.eobrun 1 i32.sub  scanner.eobrun!
  ]
  when ;

# Test fixture: hex data, tables, eobrun preset, presets for store indexes
# 1 and 8, Al and Se: one AC refinement block (ta 0, Ss 1) at offset 0 of a
# fresh two-block store.
: fx.acr ( str array hufftable i32 i32 i32 i32 i32 -- scanner coeffs )
  :> se :> al :> p8 :> p1 :> pre :> tabs :> h
  h tabs 0 2 fx.scanner :> sc
  sc pre scanner.eobrun!
  fx.store2 :> st
  st 1 p1 coeffs.set
  st 8 p8 coeffs.set
  sc st 0 1 se al 0 prog.ac-refine
  sc st ;

