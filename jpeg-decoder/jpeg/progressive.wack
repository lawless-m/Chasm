# Progressive decoding (libjpeg's jdphuff.c): the progression state and its
# checks here; the four entropy routines and block smoothing follow.
#
# The progression state is libjpeg's coef_bits: per frame component and
# zigzag coefficient, -1 until the coefficient is first scanned, then the Al
# of the latest scan that carried it. prog.check runs before any entropy
# decoding of a scan. Where libjpeg warns (JWRN_BOGUS_PROGRESSION) strict
# mode refuses BAD_PROGRESSION. libjpeg's prev_coef_bits serves output from
# a scan that ended early, which strict mode refuses, so it is not kept.

struct progress  bits: array i32  ncomp: i32

# Frame component count: every entry -1.
declare prog.make ( i32 -- progress )

# The scan and a flag, 1 for a progressive frame, 0 for sequential.
# Progressive, as start_pass_phuff_decoder: an AC scan before the component's
# DC scan, or an Ah that is not the coefficient's latest Al (0 if unsent), is
# refused. Sequential: a component in a second scan is refused (stricter than
# libjpeg, which merges silently; its own encoder refuses such a script,
# jcmaster.c validate_script), and a scanned component is marked Al 0. A
# component never scanned is not an error: its coefficients stay zero.
declare prog.check ( progress scan i32 -- )

: prog.make ( i32 -- progress )
  :> n
  n 64 i32.mul array.new ( array i32 ) :> b
  n 64 i32.mul [ :> i  b i -1 array.at! ] times
  b n progress.new ;

: prog.check ( progress scan i32 -- )
  :> prog :> sc :> p
  p progress.bits :> b
  sc scan.ss :> ss
  sc scan.se :> se
  sc scan.ah :> ah
  sc scan.al :> al
  sc scan.ncomp
  [
    :> k
    sc scan.comps k array.at :> ci
    ci 64 i32.mul :> at
    prog
    [
      ss 0 i32.gt_s  b at array.at 0 i32.lt_s  i32.and
      [ BAD_PROGRESSION "AC scan before the DC scan of component" ci refusal-n trap ]
      when
      se ss i32.sub 1 i32.add
      [
        :> j
        ss j i32.add :> coefi
        b at coefi i32.add array.at :> was
        was 0 i32.lt_s [ 0 ] [ was ] if :> expected
        ah expected i32.ne
        [ BAD_PROGRESSION "inconsistent successive approximation, coefficient" coefi refusal-n trap ]
        when
        b at coefi i32.add al array.at!
      ]
      times
    ]
    [
      b at array.at 0 i32.ge_s
      [ BAD_PROGRESSION "component scanned twice" ci refusal-n trap ]
      when
      64 [ :> q  b at q i32.add 0 array.at! ] times
    ]
    if
  ]
  times ;

# Test fixtures: a scan of n components c0, c0+1, ... with the given
# spectral selection and successive approximation; one such scan checked
# against a progress, which is returned; libjpeg's standard script.
: fx.scan-of ( i32 i32 i32 i32 i32 i32 -- scan )
  :> al :> ah :> se :> ss :> n :> c0
  n array.new ( array i32 ) :> cs
  n array.new ( array i32 ) :> td
  n array.new ( array i32 ) :> ta
  n [ :> i  cs i c0 i i32.add array.at! ] times
  n cs td ta ss se ah al 0 scan.new ;
: fx.pc ( progress i32 i32 i32 i32 i32 i32 i32 -- progress )
  :> flag :> al :> ah :> se :> ss :> n :> c0 :> p
  p  c0 n ss se ah al fx.scan-of  flag prog.check
  p ;
: fx.std3 ( -- progress )
  3 prog.make
  0 3 0 0 0 1 1 fx.pc  0 1 1 5 0 2 1 fx.pc  2 1 1 63 0 1 1 fx.pc ;
: fx.std ( -- progress )
  fx.std3
  1 1 1 63 0 1 1 fx.pc  0 1 6 63 0 2 1 fx.pc  0 1 1 63 2 1 1 fx.pc
  0 3 0 0 1 0 1 fx.pc  2 1 1 63 1 0 1 fx.pc  1 1 1 63 1 0 1 fx.pc
  0 1 1 63 1 0 1 fx.pc ;

