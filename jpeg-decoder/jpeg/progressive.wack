test prog.check : 3 prog.make 0 1 0 63 0 0 0 fx.pc 1 1 0 63 0 0 0 fx.pc 2 1 0 63 0 0 0 fx.pc progress.bits 64 array.at -> 0
test prog.check : 3 prog.make 0 1 0 63 0 0 0 fx.pc 1 1 0 63 0 0 0 fx.pc 2 1 0 63 0 0 0 fx.pc progress.bits 128 array.at -> 0
test prog.check : 3 prog.make 0 1 0 63 0 0 0 fx.pc 1 1 0 63 0 0 0 fx.pc 2 1 0 63 0 0 0 fx.pc progress.bits 191 array.at -> 0
