# The PGM/PPM writer, as djpeg's wrppm.c writes it: a P5 (one component) or
# P6 (three) header with maxval (1 << precision) - 1, 255 or 4095, then raw
# samples row by row (two big-endian bytes a sample at 12 bits, written so
# by the row producer). ppm.row is the decoder program's row sink; the
# encoder's clean.wack has its own.
#
# The header is written straight to the file. Rows are collected in the
# shared out sink's 1 MiB buffer (jpeg-shared/out.wack, one fixed
# allocation a decode, not counted by frame.need, which counts the decode's
# own buffers) and written when the next row does not fit, at out.close, or
# directly when a row is longer than the whole buffer (a row is at most
# 16384 x 3 x 2 = 98304 bytes, so only with a smaller buffer). A refusal
# mid-decode loses the rows still buffered.
#
# Failures here are plain traps, deliberately not refusals: the output path
# is the host's business, not the input's.

declare ppm.header ( i32 i32 i32 i32 -- str )
test ppm.header : 1 1 1 8 ppm.header -> "P5\n1 1\n255\n"
test ppm.header : 227 149 3 8 ppm.header -> "P6\n227 149\n255\n"
test ppm.header : 800 280 1 8 ppm.header str.len -> 15
test ppm.header : 16384 16384 3 8 ppm.header -> "P6\n16384 16384\n255\n"
test ppm.header : 1 1 1 12 ppm.header -> "P5\n1 1\n4095\n"
test ppm.header : 227 149 3 12 ppm.header -> "P6\n227 149\n4095\n"

# Path, width, height, ncomp, precision: the output, with the header written.
declare ppm.open ( str i32 i32 i32 i32 -- out )
test ppm.open : "/nonexistent-dir-for-ppm-test/x.pgm" 1 1 1 8 ppm.open -> trap

# One output row of width x ncomp samples, copied into the buffer (the
# caller reuses the row after each call).
declare ppm.row ( out bytes -- )
test ppm.row : 16 fx.out dup "414243" hex ppm.row out.fill -> 3
test ppm.row : 16 fx.out dup "414243" hex ppm.row dup "444546" hex ppm.row out.fill -> 6
test ppm.row : 16 fx.out dup "414243" hex ppm.row dup "444546" hex ppm.row out.buf 0 6 bytes.slice bytes.to-str -> "ABCDEF"
test ppm.row : fx.out-null dup "414243" hex ppm.row dup "444546" hex ppm.row out.fill -> 3
test ppm.row : fx.out-null dup "414243" hex ppm.row dup "444546" hex ppm.row out.buf 0 3 bytes.slice bytes.to-str -> "DEF"
test ppm.row : fx.out-null dup "4142434445" hex ppm.row out.fill -> 0
test ppm.row : 4 fx.out dup "414243" hex ppm.row dup "444546" hex ppm.row out.fill -> trap
test ppm.row : 4 fx.out dup "4142434445" hex ppm.row out.fill -> trap

: ppm.header ( i32 i32 i32 i32 -- str )
  :> prec :> n :> ht :> wd
  n 1 i32.eq [ "P5\n" ] [ "P6\n" ] if
  wd i32.to-str str.concat " " str.concat ht i32.to-str str.concat "\n" str.concat
  1 prec i32.shl 1 i32.sub i32.to-str str.concat "\n" str.concat ;

: ppm.open ( str i32 i32 i32 i32 -- out )
  :> prec :> n :> ht :> wd :> path
  path out.open :> o
  wd ht n prec ppm.header :> head
  o out.h head host.write head str.len i32.ne [ "short write" trap ] when
  o ;

: ppm.row ( out bytes -- )
  :> row :> p
  row bytes.len :> n
  p out.buf bytes.len :> cap
  p out.fill n i32.add cap i32.gt_s [ p out.flush ] when
  n cap i32.gt_s
  [ p out.h row bytes.as-str host.write n i32.ne [ "short write" trap ] when ]
  [
    p out.buf  p out.fill  row bytes.as-str bytes.put
    p  p out.fill n i32.add  out.fill!
  ]
  if ;
