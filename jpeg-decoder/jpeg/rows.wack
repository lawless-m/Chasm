# The MCU-row driver: from the parsed headers to output rows.
#
# Every frame the walker parses is decoded here.

# Test fixtures: the 1x1 greyscale fixture with frame and scan parsed; the
# fixture with its frame's kind or precision changed.
: fx.tiny-jpeg ( -- jpeg )  fx.tiny hex markers.open dup markers.walk ;
: fx.jpeg-kind ( i32 -- jpeg )
  :> k
  fx.tiny-jpeg :> j
  j jpeg.frame none: [ ] some: [ k frame.kind! ] match
  j ;
: fx.jpeg-kind-precision ( i32 i32 -- jpeg )
  :> p :> k
  k fx.jpeg-kind :> j
  j jpeg.frame none: [ ] some: [ p frame.precision! ] match
  j ;
: fx.jpeg-precision ( i32 -- jpeg )
  :> p
  fx.tiny-jpeg :> j
  j jpeg.frame none: [ ] some: [ p frame.precision! ] match
  j ;

# Everything the decode needs, allocated once.
struct decoder
  f: frame  sc: scanner  tabs: array hufftable  idct: idct  colour: colour  space: i32
  planes: array plane  ups: bytes  out: bytes  coef: array i32  quants: array i32
  width: i32  height: i32  ncomp: i32  mw: i32  mh: i32  hmax: i32  vmax: i32  interleaved: i32
  scn: scan  fancy: i32  methods: array i32
  j: jpeg  store: coeffs  prog: progress  sm: smoother  latched: array i32  multi: i32  smooth: i32
  ar: arith  acoded: i32  wide: i32  ups12: array i32

# The jpeg (frame and scan parsed) and the scan's
# tables. This is the only allocation point of the decode: one plane per
# component (three MCU rows of its blocks, a ring), every component upsampled to one MCU
# row at full width, one output row, one coefficient block, the components'
# natural-order quantisation tables side by side (component ci at ci*64),
# and the scanner. markers.sof checked the budget with frame.need, which
# counts exactly these buffers. A scan with one component walks that
# component's own block grid (non-interleaved), so its MCU count is the
# grid's block count. The flag selects fancy upsampling (1, libjpeg's
# default) or plain replication (0, djpeg -nosmooth) (M3); methods holds
# each component's upsampler, libjpeg's choice: in fancy mode h2v1 and h2v2
# are fancy only when the downsampled width exceeds 2, h1v2 always, and
# everything else is replication. A progressive frame, or one whose first
# scan carries fewer components than the frame (libjpeg's
# has_multiple_scans), is decoded through the whole-image store (multi): the
# store, the progression state, the smoother and a latched flag per
# component (quant tables are latched at a component's first scan) are
# allocated here too; frame.need counts the store for every frame and its
# 8 MiB fixed term covers the Huffman tables rebuilt for each scan. smooth
# is set by the scan loop once every scan is in. An arithmetic frame (SOF9 or
# SOF10, acoded) always takes the store path, with an arithmetic decoder of
# 1281 bytes of statistics, the 114-entry state table, a 64-entry block and
# per-component predictors and contexts (all within frame.need's fixed term);
# a Huffman frame carries an empty one. A 12-bit frame (wide) keeps its
# samples in array i32 buffers (plane.wide and ups12, the 8-bit ones empty),
# has a 2-byte-a-sample output row and the 12-bit IDCT and colour tables;
# frame.need counts exactly these. A 4-component frame (CMYK or YCCK) keeps
# all four planes in ups and writes 3 samples a pixel to the output row.
declare rows.setup ( jpeg array hufftable i32 -- decoder )

: rows.setup ( jpeg array hufftable i32 -- decoder )
  :> fancy :> tabs :> j
  j jpeg.frame none: [ NO_FRAME "decode before SOF" refusal trap ] some: [ ] match :> f
  j jpeg.scan none: [ NO_FRAME "decode before SOS" refusal trap ] some: [ ] match :> scn
  j colour.space :> space
  f frame.width :> width
  f frame.height :> height
  f frame.ncomp :> ncomp
  f frame.mcus-wide :> mw
  f frame.mcus-high :> mh
  f frame.hmax :> hmax
  f frame.vmax :> vmax
  scn scan.ncomp 1 i32.gt_s :> interleaved
  f frame.precision 12 i32.eq :> wide
  ncomp array.new ( array plane ) :> planes
  ncomp
  [
    :> ci
    f frame.comps ci array.at :> c
    mw c component.h i32.mul 8 i32.mul :> stride
    stride c component.v 8 i32.mul i32.mul 3 i32.mul :> nsamp
    wide [ 0 ] [ nsamp ] if bytes.new :> pd
    wide [ nsamp ] [ 0 ] if :> nw
    nw array.new ( array i32 ) :> pw
    planes ci  pd 0 stride  c component.v 8 i32.mul  hmax c component.h i32.div_u  vmax c component.v i32.div_u  pw plane.new  array.at!
  ]
  times
  ncomp array.new ( array i32 ) :> methods
  ncomp
  [
    :> mi
    f frame.comps mi array.at :> mc
    hmax mc component.h i32.div_u :> mhx
    vmax mc component.v i32.div_u :> mvx
    methods mi  fancy mhx mvx  width mhx ceil-div  upsample.method  array.at!
  ]
  times
  ncomp vmax 8 i32.mul i32.mul width i32.mul :> nups
  wide [ 0 ] [ nups ] if bytes.new :> ups
  wide [ nups ] [ 0 ] if :> nups12
  nups12 array.new ( array i32 ) :> ups12
  width  ncomp 4 i32.eq [ 3 ] [ ncomp ] if  i32.mul  wide [ 2 ] [ 1 ] if  i32.mul bytes.new :> out
  64 array.new ( array i32 ) :> coef
  ncomp 64 i32.mul array.new ( array i32 ) :> quants
  ncomp
  [
    :> qi
    j  f frame.comps qi array.at component.tq  idct.quant :> q
    64 [ :> k  quants qi 64 i32.mul k i32.add  q k array.at  array.at! ] times
  ]
  times
  wide [ idct.make12 ] [ idct.make ] if :> t
  interleaved [ mw mh i32.mul ] [ f 0 frame.comp-blocks-wide  f 0 frame.comp-blocks-high  i32.mul ] if :> total
  j jpeg.data  scn scan.data-at  tabs  t idct.natural  ncomp  j jpeg.restart  total  scan.open :> sc
  f frame.kind 0xC9 i32.eq  f frame.kind 0xCA i32.eq  i32.or :> acoded
  f frame.progressive?  scn scan.ncomp ncomp i32.lt_s  i32.or  acoded i32.or :> multi
  j t idct.natural acoded arith.make :> ar
  f multi coeffs.make :> store
  ncomp prog.make :> prog
  store prog quants prog.smoother :> sm
  ncomp array.new ( array i32 ) :> latched
  wide [ colour.make12 ] [ colour.make ] if :> ctab
  f sc tabs t ctab space planes ups out coef quants width height ncomp mw mh hmax vmax interleaved
  scn fancy methods j store prog sm latched multi 0 ar acoded wide ups12 decoder.new ;

: fx.dec ( -- decoder )  fx.tiny-jpeg dup huffman.scan-tables 1 rows.setup ;

test rows.setup : fx.dec decoder.width -> 1
test rows.setup : fx.dec decoder.fancy -> 1
test rows.setup : fx.dec decoder.methods array.len -> 1
test rows.setup : fx.dec decoder.methods 0 array.at -> 0
test rows.setup : fx.tiny-jpeg dup huffman.scan-tables 0 rows.setup decoder.fancy -> 0
test rows.setup : fx.dec decoder.height -> 1
test rows.setup : fx.dec decoder.ncomp -> 1
test rows.setup : fx.dec decoder.mw -> 1
test rows.setup : fx.dec decoder.interleaved -> 0
test rows.setup : fx.dec decoder.space -> 0
test rows.setup : fx.dec decoder.planes array.len -> 1
test rows.setup : fx.dec decoder.planes 0 array.at plane.stride -> 8
test rows.setup : fx.dec decoder.planes 0 array.at plane.data bytes.len -> 192
test rows.setup : fx.dec decoder.planes 0 array.at plane.hexp -> 1
test rows.setup : fx.dec decoder.ups bytes.len -> 8
test rows.setup : fx.dec decoder.out bytes.len -> 1
test rows.setup : fx.dec decoder.coef array.len -> 64
test rows.setup : fx.dec decoder.quants 0 array.at -> 16
test rows.setup : fx.dec decoder.quants 63 array.at -> 99
test rows.setup : fx.dec decoder.sc scanner.total -> 1
test rows.setup : fx.dec decoder.sc scanner.br bitreader.pos -> 156

# Each component of the scan not yet latched gets its quant table from the
# jpeg as it stands now, in natural order (libjpeg's latch_quant_tables): a
# DQT between scans changes nothing for components already seen.
declare rows.latch ( decoder scan -- )

: rows.latch ( decoder scan -- )
  :> scn :> d
  d decoder.idct idct.natural :> nat
  d decoder.j jpeg.qt :> qt
  d decoder.quants :> qs
  scn scan.ncomp
  [
    :> k
    scn scan.comps k array.at :> ci
    d decoder.latched ci array.at i32.eqz
    [
      d decoder.f frame.comps ci array.at component.tq 64 i32.mul :> qb
      64 [ :> z  qs  ci 64 i32.mul nat z array.at i32.add  qt qb z i32.add array.at  array.at! ] times
      d decoder.latched ci 1 array.at!
    ]
    when
  ]
  times ;

# The whole image, one output row at a time to the sink (out: width x ncomp
# bytes, reused, so the sink consumes it before returning). The sink is the
# row interface a future encoder consumes too.
#
# An interleaved scan decodes MCUs in raster order; inside an MCU, for each
# scan component, v rows of h blocks (libjpeg's decompress_onepass). A
# single-component scan walks that component's own block grid, which is not
# padded to whole MCUs (libjpeg's per_scan_setup): a 16x24 image with 2x2
# sampling has 3 block rows where the MCU grid has 4. Either way an MCU row
# fills the planes, which are upsampled and converted row by row; the last
# MCU row is clipped to the image height. An MCU row's upsampling needs the
# first sample row of the next MCU row, so emission trails decoding by one
# MCU row, and the ring holds rows my-1, my and my+1 when row my is emitted.
declare rows.decode ( decoder [ bytes -- ] -- )

# A file decoded through the store (decoder.multi): every scan in turn into
# the store, then the output pass. One loop serves both coders: each scan
# has its progression checked, latches the quant tables of its new
# components, is decoded by the Huffman scanner (its tables built anew per
# scan) or by the arithmetic decoder (its statistics reset per scan and per
# restart), and is followed by the markers up to the next SOS or the EOI
# (libjpeg consumes all input before output, jdapistd.c). Every scan moves
# pos forward and MAX_SCANS caps their count, so the loop ends. A missing
# EOI after a complete last scan at the end of the data is allowed. A marker
# met inside arithmetic data is legal and feeds zeros, as in libjpeg, so a
# scan cut short and closed with a marker decodes exactly as djpeg decodes
# it; running out of input, extraneous bytes and restart faults are refused
# where libjpeg warns.
declare rows.multi ( decoder [ bytes -- ] -- )

# The output pass from the store (libjpeg's decompress_data and
# decompress_smooth_data): per MCU row, every component's real blocks, which
# are width_in_blocks columns by block_rows rows (v, or what is left of the
# component's height in the last MCU row), smoothed when decoder.smooth,
# IDCTed into the plane ring, then emitted as the streaming path does.
declare rows.output ( decoder [ bytes -- ] -- )

# MCU row i of the planes, upsampled, converted and handed to the sink. A
# fancy component takes its context rows from the ring (the previous and
# next MCU rows' slots, or itself at the top and bottom of the image) and
# only its real rows; plain mode is the -nosmooth output.
declare rows.emit ( decoder [ bytes -- ] i32 -- )
# After MCU row my is decoded: emit row my-1, and at the last MCU row my too.
declare rows.mcu-done ( decoder [ bytes -- ] i32 -- )
declare rows.interleaved ( decoder [ bytes -- ] -- )
declare rows.single ( decoder [ bytes -- ] -- )

: rows.emit ( decoder [ bytes -- ] i32 -- )
  :> i :> sink :> d
  d decoder.vmax 8 i32.mul :> rr
  d decoder.width :> width
  d decoder.ups :> ups
  d decoder.out :> out
  # Plain YCbCr with chroma halved across (h2v1 or h2v2): colour.row-h2 reads
  # the chroma planes directly, so they are not replicated first.
  d decoder.wide i32.eqz  d decoder.space 1 i32.eq i32.and  d decoder.ncomp 3 i32.eq i32.and
  [
    d decoder.methods :> ms
    d decoder.planes :> ps
    ms 0 array.at ms 1 array.at i32.or ms 2 array.at i32.or i32.eqz
    ps 0 array.at plane.hexp 1 i32.eq i32.and  ps 0 array.at plane.vexp 1 i32.eq i32.and
    ps 1 array.at plane.hexp 2 i32.eq i32.and  ps 2 array.at plane.hexp 2 i32.eq i32.and
  ]
  [ 0 ]
  if :> merged
  d decoder.ncomp
  [
    :> ci
    d decoder.planes ci array.at :> p
    p  p i plane.slot  plane.base!
    d decoder.methods ci array.at :> method
    ci rr i32.mul width i32.mul :> at
    merged ci 0 i32.gt_s i32.and
    [ ]
    [
      method i32.eqz
      [ d decoder.wide [ p d decoder.ups12 at width rr upsample.plain12 ] [ p ups at width rr upsample.plain ] if ]
      [
        i 0 i32.gt_s [ p i 1 i32.sub plane.slot ] [ -1 ] if :> prev
        i 1 i32.add d decoder.mh i32.lt_s [ p i 1 i32.add plane.slot ] [ -1 ] if :> next
        d decoder.height p plane.vexp ceil-div  i p plane.rows i32.mul  i32.sub :> left-rows
        left-rows p plane.rows i32.lt_s [ left-rows ] [ p plane.rows ] if :> real
        d decoder.wide
        [ p method prev next real d decoder.ups12 at width upsample.fancy12 ]
        [ p method prev next real ups at width upsample.fancy ]
        if
      ]
      if
    ]
    if
  ]
  times
  d decoder.height i rr i32.mul i32.sub :> left
  left rr i32.lt_s [ left ] [ rr ] if
  [
    :> r
    d decoder.wide
    [ d decoder.colour d decoder.space d decoder.ups12 rr r out width colour.row12 ]
    [
      merged
      [
        d decoder.planes 1 array.at :> pb
        d decoder.planes 2 array.at :> pc
        pb plane.base  r pb plane.vexp i32.div_u pb plane.stride i32.mul  i32.add :> cbo
        pc plane.base  r pc plane.vexp i32.div_u pc plane.stride i32.mul  i32.add :> cro
        d decoder.colour ups r width i32.mul  pb plane.data cbo  pc plane.data cro  out width colour.row-h2
      ]
      [ d decoder.colour d decoder.space ups rr r out width colour.row ]
      if
    ]
    if
    out sink call
  ]
  times ;

: rows.mcu-done ( decoder [ bytes -- ] i32 -- )
  :> my :> sink :> d
  my 0 i32.gt_s [ d sink my 1 i32.sub rows.emit ] when
  my d decoder.mh 1 i32.sub i32.eq [ d sink my rows.emit ] when ;

: rows.interleaved ( decoder [ bytes -- ] -- )
  :> sink :> d
  d decoder.sc :> sc
  d decoder.idct :> t
  d decoder.coef :> coef
  d decoder.quants :> quants
  d decoder.f frame.comps :> comps
  d decoder.scn :> scn
  d decoder.mh
  [
    :> my
    d decoder.mw
    [
      :> mx
      scn scan.ncomp
      [
        :> k
        scn scan.comps k array.at :> ci
        comps ci array.at :> c
        d decoder.planes ci array.at :> p
        p plane.stride :> stride
        c component.v
        [
          :> by
          c component.h
          [
            :> bx
            sc ci  scn scan.td k array.at  scn scan.ta k array.at  coef scan.block
            p my plane.slot  by 8 i32.mul stride i32.mul i32.add  mx c component.h i32.mul bx i32.add 8 i32.mul  i32.add :> boff
            d decoder.wide
            [ t coef quants ci 64 i32.mul  p plane.wide  boff stride idct.block12 ]
            [ t coef quants ci 64 i32.mul  p plane.data  boff stride idct.block ]
            if
          ]
          times
        ]
        times
      ]
      times
      sc scan.end-mcu
    ]
    times
    d sink my rows.mcu-done
  ]
  times ;

: rows.single ( decoder [ bytes -- ] -- )
  :> sink :> d
  d decoder.sc :> sc
  d decoder.idct :> t
  d decoder.coef :> coef
  d decoder.quants :> quants
  d decoder.scn :> scn
  d decoder.planes 0 array.at :> p
  p plane.stride :> stride
  d decoder.f frame.comps 0 array.at component.v :> v
  d decoder.f 0 frame.comp-blocks-wide :> bw
  d decoder.f 0 frame.comp-blocks-high :> bh
  scn scan.td 0 array.at :> td
  scn scan.ta 0 array.at :> ta
  bh
  [
    :> by
    p by v i32.div_u plane.slot  by v i32.rem_u 8 i32.mul stride i32.mul  i32.add :> rowat
    bw
    [
      :> bx
      sc 0 td ta coef scan.block
      d decoder.wide
      [ t coef quants 0 p plane.wide  rowat bx 8 i32.mul i32.add  stride idct.block12 ]
      [ t coef quants 0 p plane.data  rowat bx 8 i32.mul i32.add  stride idct.block ]
      if
      sc scan.end-mcu
    ]
    times
    by 1 i32.add v i32.rem_u i32.eqz  by bh 1 i32.sub i32.eq  i32.or
    [ d sink by v i32.div_u rows.mcu-done ]
    when
  ]
  times ;

: rows.decode ( decoder [ bytes -- ] -- )
  :> sink :> d
  d decoder.multi
  [ d sink rows.multi ]
  [
    d decoder.interleaved [ d sink rows.interleaved ] [ d sink rows.single ] if
    d decoder.sc scan.finish
  ]
  if ;

# Test fixtures: a sink that collects every row into one buffer, and a
# whole-image decode through it.
struct sinkbuf  buf: bytes  n: i32
: fx.collect ( sinkbuf bytes -- )
  :> row :> sb
  sb sinkbuf.buf  sb sinkbuf.n row bytes.len i32.mul row bytes.as-str bytes.put
  sb  sb sinkbuf.n 1 i32.add  sinkbuf.n! ;
: fx.decode-mode ( jpeg i32 -- bytes )
  :> mode :> j
  j huffman.scan-tables :> tabs
  j tabs mode rows.setup :> d
  d decoder.out bytes.len d decoder.height i32.mul bytes.new 0 sinkbuf.new :> sb
  d [ ( bytes -- ) sb swap fx.collect ] rows.decode
  sb sinkbuf.buf ;
: fx.decode-all ( jpeg -- bytes )  1 fx.decode-mode ;
: fx.decode-plain ( jpeg -- bytes )  0 fx.decode-mode ;
# A 1x1 red pixel, YCbCr 4:2:0 (cjpeg -optimize -quality 50 -sample 2x2);
# the oracle decodes it to 254 0 2.
: fx.ycc1 ( -- str )
  "ffd8ffe000104a46494600010100000100010000ffdb004300100b0c0e0c0a100e0d0e1211101318281a181616183123251d283a333d3c3933383740485c4e404457453738506d51575f626768673e4d71797064785c656763"
  "ffdb0043011112121815182f1a1a2f634238426363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363"
  str.concat
  "ffc00011080001000103012200021101031101ffc4001500010100000000000000000000000000000005ffc40014100100000000000000000000000000000000ffc4001501010100000000000000000000000000000506ffc40014110100000000000000000000000000000000"
  str.concat
  "ffda000c03010002110311003f008a00b5e3ffd9"
  str.concat ;
# A 2x2 greyscale image of 10 80 160 240 (cjpeg -optimize -quality 50); the
# oracle decodes it to 1 82 165 246. Entropy data at 166..177, EOI at 178.
: fx.grey2 ( -- str )
  "ffd8ffe000104a46494600010100000100010000ffdb004300100b0c0e0c0a100e0d0e1211101318281a181616183123251d283a333d3c3933383740485c4e404457453738506d51575f626768673e4d71797064785c656763"
  "ffc0000b080002000201011100ffc40014000100000000000000000000000000000006ffc4001e10000101090000000000000000000000000402000305142432435171ffda0008010100003f00522c3409573443589c49d71bffd9"
  str.concat ;

test rows.decode : fx.tiny-jpeg fx.decode-all bytes.len -> 1
test rows.decode : fx.tiny-jpeg fx.decode-all 0 bytes.at -> 128
test rows.decode : fx.ycc1 hex markers.open dup markers.walk fx.decode-all bytes.len -> 3
test rows.decode : fx.ycc1 hex markers.open dup markers.walk fx.decode-all 0 bytes.at -> 254
test rows.decode : fx.ycc1 hex markers.open dup markers.walk fx.decode-all 1 bytes.at -> 0
test rows.decode : fx.ycc1 hex markers.open dup markers.walk fx.decode-all 2 bytes.at -> 2
test rows.decode : fx.grey2 hex markers.open dup markers.walk fx.decode-all bytes.len -> 4
test rows.decode : fx.grey2 hex markers.open dup markers.walk fx.decode-all 0 bytes.at -> 1
test rows.decode : fx.grey2 hex markers.open dup markers.walk fx.decode-all 1 bytes.at -> 82
test rows.decode : fx.grey2 hex markers.open dup markers.walk fx.decode-all 2 bytes.at -> 165
test rows.decode : fx.grey2 hex markers.open dup markers.walk fx.decode-all 3 bytes.at -> 246
test rows.decode : fx.grey2 0 336 str.slice hex markers.open dup markers.walk fx.decode-all -> trap
test rows.decode : fx.grey2 0 356 str.slice "00ffd9" str.concat hex markers.open dup markers.walk fx.decode-all -> trap
test rows.decode : fx.grey2 0 356 str.slice hex markers.open dup markers.walk fx.decode-all 3 bytes.at -> 246
test rows.decode : fx.grey2 "0102" str.concat hex markers.open dup markers.walk fx.decode-all 3 bytes.at -> 246
test rows.decode : fx.grey2 0 332 str.slice "ffd0" str.concat fx.grey2 332 28 str.slice str.concat hex markers.open dup markers.walk fx.decode-all -> trap
test rows.setup : fx.ycc1 hex markers.open dup markers.walk dup huffman.scan-tables 1 rows.setup decoder.methods 1 array.at -> 0

# Fancy-upsampling regression fixtures from corpus/synthetic-m3 (cjpeg
# -dct int -optimize, crops of testorig at offset 100,60), with the
# oracle's pixels in both modes (djpeg -dct int -pnm and -nosmooth, header
# removed).
# 6x20 4:2:0, -sample 2x2: h2v2 fancy (downsampled width 3), two MCU rows,
# a partial last MCU row: the top edge, the cross-MCU-row context and the
# bottom duplication all matter. 348 bytes.
: fx.ycc6x20 ( -- str )
  "FFD8FFE000104A46494600010100000100010000FFDB004300080606070605080707070909080A0C140D0C0B0B0C1912130F141D1A1F1E1D1A1C1C20242E2720222C231C1C28"
  "37292C30313434341F27393D38323C2E333432FFDB0043010909090C0B0C180D0D1832211C213232323232323232323232323232323232323232323232323232323232323232" str.concat
  "323232323232323232323232323232323232FFC00011080014000603012200021101031101FFC400160001010100000000000000000000000000000504FFC400201000020300" str.concat
  "00070100000000000000000001020003110412142131416181FFC40017010003010000000000000000000000000002040507FFC4001A11010100020300000000000000000000" str.concat
  "0001000204213141FFDA000C03010002110311003F008CD61F2C542FDC894BA0A5AA1B7D82D1DB6A1CC300FC892032B4F7607CB2706CCCF612C4E67B8888675223C5FFD9" str.concat ;
: fx.ycc6x20-fancy ( -- str )
  "F92E41F92E41F82F41F72E40F32C3FF0293CFF3347FF3445FE3346FE3346FC3345FB3244F8293BF72838F42537F32436F12435F22536FB2B39F92937F52533F22230F12131F2"
  "2333FA2835F82633F62431F2222FF22230F42432F1222CF0222CF0222CF1232DF3252FF32730F52C32F52E33F73035F93237F83136F43034E82A2AEA2C2CEB2D2FEA2E2FE729" str.concat
  "2BE02425DC2827FA4645EB3736DE2C2AE83435EA3838DD3431F44B48E23936D72E2BD9302DD22926CF2D2AE2403DDB3936E03E3BDF403CCF302CDE4341EB504EEE5351FF6462" str.concat
  "FC615FE04644CE3436D93F41E74D4FFF6F71FF787AFF6F71FF696EFC6366F65D62FF676CF55C61E64D52FA5F67F2575DEA4F57F0555DE34850DE434BE1484DDF464BE2494EF0" str.concat
