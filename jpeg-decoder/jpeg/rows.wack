test rows.setup : fx.dec decoder.smooth -> 0
test rows.setup : fx.dec decoder.latched array.len -> 1
test rows.setup : fx.dec decoder.prog progress.bits 0 array.at -> -1
test rows.setup : 0xC2 fx.jpeg-kind dup huffman.scan-tables 1 rows.setup decoder.multi -> 1
test rows.setup : 0xC2 fx.jpeg-kind dup huffman.scan-tables 1 rows.setup decoder.store coeffs.data bytes.len -> 128

# Test fixtures: the fixture decoder latched once, with jpeg.qt[0] set to a
# value before the latch, or after it and latched again.
: fx.latched ( -- decoder )
  fx.dec :> d
  d d decoder.scn rows.latch
  d ;
: fx.latch-after ( i32 -- decoder )
  :> v
  fx.dec :> d
  d decoder.j jpeg.qt 0 v array.at!
  d d decoder.scn rows.latch
  d ;
: fx.relatch ( i32 -- decoder )
  :> v
  fx.latched :> d
  d decoder.j jpeg.qt 0 v array.at!
  d d decoder.scn rows.latch
  d ;
test rows.latch : fx.latched decoder.quants 0 array.at -> 16
test rows.latch : fx.latched decoder.quants 63 array.at -> 99
test rows.latch : fx.latched decoder.latched 0 array.at -> 1
test rows.latch : 5 fx.latch-after decoder.quants 0 array.at -> 5
test rows.latch : 5 fx.relatch decoder.quants 0 array.at -> 16

# One block of a scan into the store: decoder, scanner, scan, k (the
# component's index within the scan) and the block's coefficient index. A
# sequential frame decodes the whole block (scan.block or arith.block) and
# stores it, zeros included, as libjpeg's pre-zeroed arrays hold; a
# progressive frame picks DC first, DC refine, AC first or AC refine by Ss
# and Ah, from the Huffman or the arithmetic coder by the frame's kind.
declare rows.block-store ( decoder scanner scan i32 i32 -- )

# One scan into the store (libjpeg's consume_data and per_scan_setup): an
# interleaved scan walks the MCUs, each component's v rows of h blocks into
# the padded arrays, so the padding blocks are decoded too; a
# single-component scan walks that component's own unpadded block grid, one
# block per MCU, leaving the padding zero. scan.end-mcu follows every MCU.
# The caller opens the scanner with the scan's tables and MCU count.
declare rows.scan-store ( decoder scanner scan -- )

: rows.block-store ( decoder scanner scan i32 i32 -- )
  :> off :> k :> scn :> sc :> d
  d decoder.store :> st
  scn scan.comps k array.at :> ci
  scn scan.td k array.at :> td
  scn scan.ta k array.at :> ta
  scn scan.ss :> ss
  scn scan.ah :> ah
  scn scan.al :> al
  d decoder.f frame.progressive? :> prog
  d decoder.acoded
  [
    d decoder.ar :> ar
    prog
    [
      ss 0 i32.eq
      [ ah [ ar st al off arith.dc-refine ] [ ar st ci td al off arith.dc-first ] if ]
      [ ah [ ar st ta ss scn scan.se al off arith.ac-refine ] [ ar st ta ss scn scan.se al off arith.ac-first ] if ]
      if
    ]
    [ ar st ci td ta off arith.block ]
    if
  ]
  [
    prog
    [
      ss 0 i32.eq
      [ ah [ sc st al off prog.dc-refine ] [ sc st ci td al off prog.dc-first ] if ]
      [ ah [ sc st ta ss scn scan.se al off prog.ac-refine ] [ sc st ta ss scn scan.se al off prog.ac-first ] if ]
      if
    ]
    [
      d decoder.coef :> coef
      sc ci td ta coef scan.block
      st off coef coeffs.put-block
    ]
    if
  ]
  if ;

: rows.scan-store ( decoder scanner scan -- )
  :> scn :> sc :> d
  d decoder.store :> st
  d decoder.f :> f
  scn scan.ncomp 1 i32.gt_s
  [
    d decoder.mh
    [
      :> my
      d decoder.mw
      [
        :> mx
        scn scan.ncomp
        [
          :> k
          scn scan.comps k array.at :> ci
          f frame.comps ci array.at :> c
          c component.v
          [
            :> by
            c component.h
            [
              :> bx
              d sc scn k  st ci  mx c component.h i32.mul bx i32.add  my c component.v i32.mul by i32.add  coeffs.block  rows.block-store
            ]
            times
          ]
          times
        ]
        times
        d decoder.acoded [ d decoder.ar arith.end-mcu ] [ sc scan.end-mcu ] if
      ]
      times
    ]
    times
  ]
  [
    scn scan.comps 0 array.at :> ci1
    f ci1 frame.comp-blocks-wide :> bw
    f ci1 frame.comp-blocks-high :> bh
    bh
    [
      :> by1
      bw
      [
        :> bx1
        d sc scn 0  st ci1 bx1 by1 coeffs.block  rows.block-store
        d decoder.acoded [ d decoder.ar arith.end-mcu ] [ sc scan.end-mcu ] if
      ]
      times
    ]
    times
  ]
  if ;

# Test fixtures: a decoder given a store even for a single-scan file; the
# first block's pixels after storing the scan and an IDCT of the block.
: fx.dec-store ( jpeg -- decoder )
  :> j
  j  j huffman.scan-tables  1 rows.setup :> d
  d  d decoder.f 1 coeffs.make  decoder.store!
  d ;
: fx.stored-pixels ( jpeg -- bytes )
  fx.dec-store :> d
  d d decoder.sc d decoder.scn rows.scan-store
  d decoder.store 0 d decoder.coef coeffs.get-block
  64 bytes.new :> px
  d decoder.idct d decoder.coef d decoder.quants 0 px 0 8 idct.block
  px ;
: fx.ycc1-stored ( -- decoder )
  fx.ycc1 hex markers.open dup markers.walk fx.dec-store :> d
  d d decoder.sc d decoder.scn rows.scan-store
  d ;

test rows.scan-store : fx.grey2 hex markers.open dup markers.walk fx.stored-pixels 0 bytes.at -> 1
test rows.scan-store : fx.grey2 hex markers.open dup markers.walk fx.stored-pixels 1 bytes.at -> 82
test rows.scan-store : fx.grey2 hex markers.open dup markers.walk fx.stored-pixels 8 bytes.at -> 165
test rows.scan-store : fx.grey2 hex markers.open dup markers.walk fx.stored-pixels 9 bytes.at -> 246
test rows.scan-store : fx.tiny-jpeg fx.stored-pixels 0 bytes.at -> 128
test rows.scan-store : fx.grey2 0 336 str.slice hex markers.open dup markers.walk fx.stored-pixels -> trap
test rows.scan-store : fx.ycc1-stored decoder.sc scanner.mcu -> 1
test rows.scan-store : fx.grey2 hex markers.open dup markers.walk fx.dec-store decoder.store coeffs.data bytes.len -> 128

: rows.multi ( decoder [ bytes -- ] -- )
  :> sink :> d
  d decoder.j :> j
  d decoder.sc :> sc
  d decoder.f :> f
  f frame.progressive? :> prog
  d decoder.scn :> cur!
  d decoder.tabs :> ctabs!
  1 :> go!
  [ go ]
  [
    d decoder.prog cur prog prog.check
    d cur rows.latch
    cur scan.comps 0 array.at :> c0
    cur scan.ncomp 1 i32.gt_s
    [ d decoder.mw d decoder.mh i32.mul ]
    [ f c0 frame.comp-blocks-wide  f c0 frame.comp-blocks-high  i32.mul ]
    if :> total
    d decoder.acoded
    [ d decoder.ar  cur prog cur scan.data-at  j jpeg.restart  total  arith.reopen ]
    [ sc  j jpeg.data  cur scan.data-at  ctabs  j jpeg.restart  total  scan.reopen ]
    if
    d sc cur rows.scan-store
    d decoder.acoded [ d decoder.ar arith.end ] [ sc scan.end ] if :> m
    m -1 i32.eq  m 0xD9 i32.eq  i32.or
    [ 0 go! ]
    [
      j  d decoder.acoded [ d decoder.ar arith.pos ] [ sc scanner.br bitreader.pos ] if 2 i32.sub  jpeg.pos!
      j markers.next-scan
      [
        j jpeg.scan none: [ NO_FRAME "scan lost after SOS" refusal trap ] some: [ ] match cur!
        d decoder.acoded i32.eqz [ j huffman.scan-tables ctabs! ] when
      ]
      [ 0 go! ]
      if
    ]
    if
  ]
  while
  d  prog d decoder.sm prog.smooth? i32.and  decoder.smooth!
  d sink rows.output ;

: rows.output ( decoder [ bytes -- ] -- )
  :> sink :> d
  d decoder.store :> st
  d decoder.coef :> coef
  d decoder.quants :> qs
  d decoder.idct :> t
  d decoder.sm :> sm
  d decoder.f :> f
  d decoder.mh :> mh
  d decoder.smooth :> smooth
  mh
  [
    :> my
    d decoder.ncomp
    [
      :> ci
      f frame.comps ci array.at component.v :> v
      f ci frame.comp-blocks-wide :> bw
      f ci frame.comp-blocks-high :> bh
      my mh 1 i32.sub i32.lt_s [ v ] [ bh v i32.rem_u :> left  left [ left ] [ v ] if ] if :> brows
      d decoder.planes ci array.at :> p
      p plane.stride :> stride
      p my plane.slot :> slot
      brows
      [
        :> br
        my v i32.mul br i32.add :> row
        bw
        [
          :> bx
          st ci bx row coeffs.block :> off
          st off coef coeffs.get-block
          smooth [ sm ci bw bx row  my brows i32.mul br i32.add  brows mh i32.mul  coef prog.smooth ] when
          slot br 8 i32.mul stride i32.mul i32.add bx 8 i32.mul i32.add :> boff
          d decoder.wide
          [ t coef qs ci 64 i32.mul  p plane.wide  boff stride idct.block12 ]
          [ t coef qs ci 64 i32.mul  p plane.data  boff stride idct.block ]
          if
        ]
        times
      ]
      times
    ]
    times
    d sink my rows.mcu-done
  ]
  times ;

# Progressive and multi-scan fixtures, made with the oracle's cjpeg.
# 2x2 grey 10 80 160 240, -grayscale -progressive -quality 50: SOF2, six
# scans, complete; the oracle gives 1 82 165 246.
: fx.grey2p ( -- str )
  "FFD8FFE000104A46494600010100000100010000FFDB004300100B0C0E0C0A100E0D0E1211101318281A181616183123251D283A333D3C3933383740485C4E40445745373850"
  "6D51575F626768673E4D71797064785C656763FFC2000B080002000201011100FFC40014000100000000000000000000000000000005FFDA000801010000000153FFC4001610" str.concat
  "01010100000000000000000000000000020312FFDA00080101000105023319FFC4001810000203000000000000000000000000000001022291FFDA0008010100063F02548E1F" str.concat
  "FFC40017100003010000000000000000000000000000014161FFDA0008010100013F21CF8A0FFFDA0008010100000010FF00FFC4001610000300000000000000000000000000" str.concat
  "000071F1FFDA0008010100013F1084E91FFFD9" str.concat ;
# 1x1 red, -sample 2x2 -progressive -quality 50: ten scans; the oracle
