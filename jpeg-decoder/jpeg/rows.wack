: fx.red1p ( -- str )
  "FFD8FFE000104A46494600010100000100010000FFDB004300100B0C0E0C0A100E0D0E1211101318281A181616183123251D283A333D3C3933383740485C4E40445745373850"
  "6D51575F626768673E4D71797064785C656763FFDB0043011112121815182F1A1A2F634238426363636363636363636363636363636363636363636363636363636363636363" str.concat
  "636363636363636363636363636363636363FFC20011080001000103012200021101031101FFC4001500010100000000000000000000000000000004FFC40015010101000000" str.concat
  "00000000000000000000000405FFDA000C030100021003100000018816F7FFC40014100100000000000000000000000000000000FFDA00080101000105027FFFC40014110100" str.concat
  "000000000000000000000000000000FFDA0008010301013F017FFFC40014110100000000000000000000000000000000FFDA0008010201013F017FFFC4001410010000000000" str.concat
  "0000000000000000000000FFDA0008010100063F027FFFC40014100100000000000000000000000000000000FFDA0008010100013F217FFFDA000C0301000200030000001003" str.concat
  "FFC40014110100000000000000000000000000000000FFDA0008010301013F107FFFC40014110100000000000000000000000000000000FFDA0008010201013F107FFFC40014" str.concat
  "100100000000000000000000000000000000FFDA0008010100013F107FFFD9" str.concat ;
# 1x1 red, -sample 2x2 -optimize -quality 50 with three one-component
# sequential scans: SOF0; the oracle gives 254 0 2.
: fx.red1s ( -- str )
  "FFD8FFE000104A46494600010100000100010000FFDB004300100B0C0E0C0A100E0D0E1211101318281A181616183123251D283A333D3C3933383740485C4E40445745373850"
  "6D51575F626768673E4D71797064785C656763FFDB0043011112121815182F1A1A2F634238426363636363636363636363636363636363636363636363636363636363636363" str.concat
  "636363636363636363636363636363636363FFC00011080001000103012200021101031101FFC40014000100000000000000000000000000000005FFC4001410010000000000" str.concat
  "0000000000000000000000FFDA0008010100003F0015FFC40014010100000000000000000000000000000005FFC40014110100000000000000000000000000000000FFDA0008" str.concat
  "010211003F002DFFC40014010100000000000000000000000000000006FFC40014110100000000000000000000000000000000FFDA0008010311003F0078FFD9" str.concat ;
# 16x8 grey, each row eight 10s then eight 200s, -grayscale -quality 50
# with a single DC scan: djpeg smooths it, DC interpolation included.
: fx.grey16x8dc ( -- str )
  "FFD8FFE000104A46494600010100000100010000FFDB004300100B0C0E0C0A100E0D0E1211101318281A181616183123251D283A333D3C3933383740485C4E40445745373850"
  "6D51575F626768673E4D71797064785C656763FFC2000B080008001001011100FFC4001500010100000000000000000000000000000607FFDA0008010100000000095FFFD9" str.concat ;
: fx.grey16x8dc-out ( -- str )  "00000004162F495B7789A3BCCEDAE2E6" 8 fx.rep ;

