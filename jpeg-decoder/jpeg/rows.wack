# Test fixtures: a file's arithmetic scan decoded into a store (the
# decoder's arith reopened for the parsed scan), and a Huffman one through
# its scanner, to compare coefficients.
: fx.astored ( jpeg -- coeffs )
  fx.dec-store :> d
  d decoder.scn :> scn
  d decoder.f frame.mcus-wide d decoder.f frame.mcus-high i32.mul :> total
  d decoder.ar  scn 0 scn scan.data-at  d decoder.j jpeg.restart  total  arith.reopen
  d d decoder.sc scn rows.scan-store
  d decoder.store ;
: fx.hstored ( jpeg -- coeffs )
  fx.dec-store :> d
  d d decoder.sc d decoder.scn rows.scan-store
  d decoder.store ;
: fx.afile ( str -- bytes )  hex markers.open dup markers.walk fx.decode-all ;
: fx.afile-plain ( str -- bytes )  hex markers.open dup markers.walk fx.decode-plain ;

