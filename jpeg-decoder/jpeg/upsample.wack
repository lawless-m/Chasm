# One output row of libjpeg's h1v2_fancy_upsample: src, the offsets of the
# nearest input row (cur) and the next nearest (other), the bias, dst, its
# offset and the width. The upper output row of each pair takes the row
# above with bias 1, the lower the row below with bias 2; cur and other are
# the same row where an edge row is duplicated.
declare upsample.h1v2-row ( bytes i32 i32 i32 bytes i32 i32 -- )

: upsample.h1v2-row ( bytes i32 i32 i32 bytes i32 i32 -- )
  :> width :> doff :> dst :> bias :> other :> cur :> src
  width
  [ :> x  dst doff x i32.add  src cur x i32.add bytes.at 3 i32.mul  src other x i32.add bytes.at  i32.add bias i32.add 2 i32.shr_s  bytes.at! ]
  times ;

# Test fixture: hex input, cur, other, bias, destination length, dst offset,
# width.
: fx.h1v2 ( str i32 i32 i32 i32 i32 i32 -- bytes )
  :> width :> doff :> n :> bias :> other :> cur :> h
  n bytes.new :> d
  h hex cur other bias d doff width upsample.h1v2-row
  d ;

