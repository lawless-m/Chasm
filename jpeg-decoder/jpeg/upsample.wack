# upsample.fancy for a 12-bit plane: the same context-row logic over
# plane.wide, through the row12 filters, into an array i32.
declare upsample.fancy12 ( plane i32 i32 i32 i32 array i32 i32 i32 -- )

: upsample.fancy12 ( plane i32 i32 i32 i32 array i32 i32 i32 -- )
  :> width :> doff :> dst :> real :> next :> prev :> method :> p
  p plane.wide :> src
  p plane.stride :> stride
  p plane.rows :> rows
  p plane.base :> base
  width p plane.hexp ceil-div :> dw
  real
  [
    :> r
    base r stride i32.mul i32.add :> cur
    r 0 i32.gt_s
    [ cur stride i32.sub ]
    [ prev 0 i32.ge_s [ prev rows 1 i32.sub stride i32.mul i32.add ] [ cur ] if ]
    if :> above
    r 1 i32.add real i32.lt_s
    [ cur stride i32.add ]
    [ next 0 i32.ge_s [ next ] [ cur ] if ]
    if :> below
    method 1 i32.eq
    [ src cur dw dst  doff r width i32.mul i32.add  width upsample.h2v1-row12 ]
    [
      doff r 2 i32.mul width i32.mul i32.add :> up
      up width i32.add :> down
      method 2 i32.eq
      [
        src cur above 1 dst up width upsample.h1v2-row12
        src cur below 2 dst down width upsample.h1v2-row12
      ]
      [
        src cur above dw dst up width upsample.h2v2-row12
        src cur below dw dst down width upsample.h2v2-row12
      ]
      if
    ]
    if
  ]
  times ;

# Test fixture: fx.fancy's parameters with the three slots as 16-bit
# big-endian samples; the result an array i32.
: fx.fancy12 ( str i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -- array i32 )
  :> width :> n :> real :> next :> prev :> method :> base :> vx :> hx :> rows :> stride :> h
  h fx.samples12 :> wide
  0 bytes.new :> none
  none base stride rows hx vx wide plane.new :> p
  n array.new ( array i32 ) :> d
  p method prev next real d 0 width upsample.fancy12
  d ;

