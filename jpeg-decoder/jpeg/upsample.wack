test upsample.h1v2-row : "0A14" 0 0 2 4 2 2 fx.h1v2 2 bytes.at -> 10

# One output row of libjpeg's h2v2_fancy_upsample: src, the offsets of the
# nearest input row (cur) and the next nearest (other: the row above for the
# upper output row of each pair, the row below for the lower; the same row
# where an edge row is duplicated), dw (>= 3), dst, its offset and the
# output width (2dw-1 or 2dw). The column sums 3 x cur + other weigh the
# rows 3/4 and 1/4; across, 3/4 of the nearer sum and 1/4 of the further,
# so the samples weigh 9/16, 3/16, 3/16 and 1/16. The bias alternates +8,
# +7 between the pair, libjpeg's ordered dither, and the edge outputs use
# 4 x their column sum.
declare upsample.h2v2-row ( bytes i32 i32 i32 bytes i32 i32 -- )

: upsample.h2v2-row ( bytes i32 i32 i32 bytes i32 i32 -- )
  :> width :> doff :> dst :> dw :> other :> cur :> src
  dw
  [
    :> k
    src cur k i32.add bytes.at 3 i32.mul  src other k i32.add bytes.at  i32.add :> cs
    k 2 i32.mul :> x
    k 0 i32.eq
    [ cs 4 i32.mul 8 i32.add 4 i32.shr_s ]
    [
      src cur k i32.add 1 i32.sub bytes.at 3 i32.mul  src other k i32.add 1 i32.sub bytes.at  i32.add :> left
      cs 3 i32.mul left i32.add 8 i32.add 4 i32.shr_s
    ]
    if :> even
    k dw 1 i32.sub i32.eq
    [ cs 4 i32.mul 7 i32.add 4 i32.shr_s ]
    [
      src cur k i32.add 1 i32.add bytes.at 3 i32.mul  src other k i32.add 1 i32.add bytes.at  i32.add :> right
      cs 3 i32.mul right i32.add 7 i32.add 4 i32.shr_s
    ]
    if :> odd
    x width i32.lt_s [ dst doff x i32.add even bytes.at! ] when
    x 1 i32.add width i32.lt_s [ dst doff x i32.add 1 i32.add odd bytes.at! ] when
  ]
  times ;

# Test fixture: hex input, cur, other, dw, destination length, dst offset,
# width.
: fx.h2v2 ( str i32 i32 i32 i32 i32 i32 -- bytes )
  :> width :> doff :> n :> dw :> other :> cur :> h
  n bytes.new :> d
  h hex cur other dw d doff width upsample.h2v2-row
  d ;

