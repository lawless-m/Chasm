# Upsampling: one component's MCU row of samples expanded to full resolution.
#
# A plane holds one component's decoded samples for three MCU rows, a ring:
# MCU row k sits in slot k mod 3 (plane.slot), `rows` sample rows (v x 8) of
# `stride` samples each, so the rows above and below an MCU row, which fancy
# upsampling needs, stay resident. `base` is the offset of the MCU row being
# upsampled; hexp = hmax / h and vexp = vmax / v are the expansion factors.
# An 8-bit frame keeps its samples in `data`, one byte each; a 12-bit frame
# in `wide`, an array i32 with the same geometry in sample units (4 bytes a
# sample, counted by frame.need); the other one is empty.
#
# upsample.plain replicates each sample hexp times across and vexp times
# down, which is libjpeg's -nosmooth behaviour for every sampling factor
# (its merged upsampler for h2v1 and h2v2 YCbCr gives the same bytes). Fancy
# upsampling is M3 and will live here too.

struct plane  data: bytes  base: i32  stride: i32  rows: i32  hexp: i32  vexp: i32  wide: array i32

# The offset of MCU row k's slot.
declare plane.slot ( plane i32 -- i32 )

: plane.slot ( plane i32 -- i32 )
  :> k :> p
  k 3 i32.rem_u  p plane.rows i32.mul  p plane.stride i32.mul ;

# The plane, the destination, the destination offset, the output width and
# the number of output rows.
declare upsample.plain ( plane bytes i32 i32 i32 -- )

# upsample.plain for a 12-bit plane: replication from plane.wide into an
# array i32 (plane, dst, dst offset, output width, output rows).
declare upsample.plain12 ( plane array i32 i32 i32 i32 -- )

: upsample.plain ( plane bytes i32 i32 i32 -- )
  :> rows :> width :> off :> dst :> p
  p plane.data :> src
  p plane.hexp :> hx
  p plane.vexp :> vx
  p plane.stride :> stride
  p plane.base :> base
  rows
  [
    :> r
    base  r vx i32.div_u stride i32.mul  i32.add :> from
    off r width i32.mul i32.add :> to
    hx 1 i32.eq
    [ width [ :> x0  dst to x0 i32.add  src from x0 i32.add bytes.at  bytes.at! ] times ]
    [ width [ :> x1  dst to x1 i32.add  src from x1 hx i32.div_u i32.add bytes.at  bytes.at! ] times ]
    if
  ]
  times ;

: upsample.plain12 ( plane array i32 i32 i32 i32 -- )
  :> rows :> width :> off :> dst :> p
  p plane.wide :> src
  p plane.hexp :> hx
  p plane.vexp :> vx
  p plane.stride :> stride
  p plane.base :> base
  rows
  [
    :> r
    base  r vx i32.div_u stride i32.mul  i32.add :> from
    off r width i32.mul i32.add :> to
    hx 1 i32.eq
    [ width [ :> x0  dst to x0 i32.add  src from x0 i32.add array.at  array.at! ] times ]
    [ width [ :> x1  dst to x1 i32.add  src from x1 hx i32.div_u i32.add array.at  array.at! ] times ]
    if
  ]
  times ;

# Test fixtures: hex data, stride, hexp, vexp (base 0); and a run into a
# fresh width x rows destination.
: fx.plane ( str i32 i32 i32 -- plane )
  :> vx :> hx :> stride :> h
  h hex :> d
  0 array.new ( array i32 ) :> none
  d 0 stride  d bytes.len stride i32.div_u  hx vx none plane.new ;
: fx.up ( plane i32 i32 -- bytes )
  :> rows :> width :> p
  width rows i32.mul bytes.new :> d
  p d 0 width rows upsample.plain
  d ;

