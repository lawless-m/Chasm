# The fancy row filters for 12-bit planes (libjpeg's 12-bit build of
# jdsample.c): the same formulas over array i32 samples; column sums stay
# within an i32 (at most 4 x 4095 x 4). The 8-bit words are untouched.
declare upsample.h2v1-row12 ( array i32 i32 i32 array i32 i32 i32 -- )
declare upsample.h1v2-row12 ( array i32 i32 i32 i32 array i32 i32 i32 -- )
declare upsample.h2v2-row12 ( array i32 i32 i32 i32 array i32 i32 i32 -- )

: upsample.h2v1-row12 ( array i32 i32 i32 array i32 i32 i32 -- )
  :> width :> doff :> dst :> dw :> off :> src
  dw
  [
    :> k
    src off k i32.add array.at 3 i32.mul :> v3
    k 2 i32.mul :> x
    k 0 i32.eq
    [ src off array.at ]
    [ v3  src off k i32.add 1 i32.sub array.at  i32.add 1 i32.add 2 i32.shr_s ]
    if :> even
    k dw 1 i32.sub i32.eq
    [ src off k i32.add array.at ]
    [ v3  src off k i32.add 1 i32.add array.at  i32.add 2 i32.add 2 i32.shr_s ]
    if :> odd
    x width i32.lt_s [ dst doff x i32.add even array.at! ] when
    x 1 i32.add width i32.lt_s [ dst doff x i32.add 1 i32.add odd array.at! ] when
  ]
  times ;

: upsample.h1v2-row12 ( array i32 i32 i32 i32 array i32 i32 i32 -- )
  :> width :> doff :> dst :> bias :> other :> cur :> src
  width
  [ :> x  dst doff x i32.add  src cur x i32.add array.at 3 i32.mul  src other x i32.add array.at  i32.add bias i32.add 2 i32.shr_s  array.at! ]
  times ;

: upsample.h2v2-row12 ( array i32 i32 i32 i32 array i32 i32 i32 -- )
  :> width :> doff :> dst :> dw :> other :> cur :> src
  dw
  [
    :> k
    src cur k i32.add array.at 3 i32.mul  src other k i32.add array.at  i32.add :> cs
    k 2 i32.mul :> x
    k 0 i32.eq
    [ cs 4 i32.mul 8 i32.add 4 i32.shr_s ]
    [
      src cur k i32.add 1 i32.sub array.at 3 i32.mul  src other k i32.add 1 i32.sub array.at  i32.add :> left
      cs 3 i32.mul left i32.add 8 i32.add 4 i32.shr_s
    ]
    if :> even
    k dw 1 i32.sub i32.eq
    [ cs 4 i32.mul 7 i32.add 4 i32.shr_s ]
    [
      src cur k i32.add 1 i32.add array.at 3 i32.mul  src other k i32.add 1 i32.add array.at  i32.add :> right
      cs 3 i32.mul right i32.add 7 i32.add 4 i32.shr_s
    ]
    if :> odd
    x width i32.lt_s [ dst doff x i32.add even array.at! ] when
    x 1 i32.add width i32.lt_s [ dst doff x i32.add 1 i32.add odd array.at! ] when
  ]
  times ;

# Test fixtures: a hex string of 16-bit big-endian samples (spaces ignored)
# as an array; the 8-bit row fixtures over such arrays.
: fx.samples12 ( str -- array i32 )
  hex :> b
  b bytes.len 2 i32.div_u :> n
  n array.new ( array i32 ) :> w
  n [ :> i  w i  b i 2 i32.mul bytes.at 8 i32.shl  b i 2 i32.mul 1 i32.add bytes.at  i32.or  array.at! ] times
  w ;
: fx.h2v1-12 ( str i32 i32 i32 i32 i32 -- array i32 )
  :> width :> doff :> n :> dw :> off :> h
  n array.new ( array i32 ) :> d
  h fx.samples12 off dw d doff width upsample.h2v1-row12
  d ;
: fx.h1v2-12 ( str i32 i32 i32 i32 i32 i32 -- array i32 )
  :> width :> doff :> n :> bias :> other :> cur :> h
  n array.new ( array i32 ) :> d
  h fx.samples12 cur other bias d doff width upsample.h1v2-row12
  d ;
: fx.h2v2-12 ( str i32 i32 i32 i32 i32 i32 -- array i32 )
  :> width :> doff :> n :> dw :> other :> cur :> h
  n array.new ( array i32 ) :> d
  h fx.samples12 cur other dw d doff width upsample.h2v2-row12
  d ;

