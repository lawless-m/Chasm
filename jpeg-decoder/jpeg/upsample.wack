# One MCU row of a component through the fancy row words, with libjpeg's
# context rows (jdmainct.c): plane (base at this MCU row's slot), method (1
# h2v1, 2 h1v2, 3 h2v2), the previous and next MCU rows' slot offsets (-1
# at the top or bottom of the image), real-rows (the sample rows of this
# MCU row inside the image: plane.rows, except in the last MCU row), dst,
# its offset and the output width. Above an image's first sample row is
# that row itself (make_funny_pointers duplicates it), below the last real
# sample row is that row itself (set_bottom_pointers; the padding rows of a
# partial last MCU row are never used), and elsewhere the neighbours are the
# adjacent decoded rows, in the previous or next MCU row across a boundary.
# Rows past real-rows produce nothing: their output lies below the image.
declare upsample.fancy ( plane i32 i32 i32 i32 bytes i32 i32 -- )

: upsample.fancy ( plane i32 i32 i32 i32 bytes i32 i32 -- )
  :> width :> doff :> dst :> real :> next :> prev :> method :> p
  p plane.data :> src
  p plane.stride :> stride
  p plane.rows :> rows
  p plane.base :> base
  width p plane.hexp ceil-div :> dw
  real
  [
    :> r
    base r stride i32.mul i32.add :> cur
    r 0 i32.gt_s
    [ cur stride i32.sub ]
    [ prev 0 i32.ge_s [ prev rows 1 i32.sub stride i32.mul i32.add ] [ cur ] if ]
    if :> above
    r 1 i32.add real i32.lt_s
    [ cur stride i32.add ]
    [ next 0 i32.ge_s [ next ] [ cur ] if ]
    if :> below
    method 1 i32.eq
    [ src cur dw dst  doff r width i32.mul i32.add  width upsample.h2v1-row ]
    [
      doff r 2 i32.mul width i32.mul i32.add :> up
      up width i32.add :> down
      method 2 i32.eq
      [
        src cur above 1 dst up width upsample.h1v2-row
        src cur below 2 dst down width upsample.h1v2-row
      ]
      [
        src cur above dw dst up width upsample.h2v2-row
        src cur below dw dst down width upsample.h2v2-row
      ]
      if
    ]
    if
  ]
  times ;

# Test fixture: hex data holding three slots, stride, rows, hexp, vexp, the
# base, method, prev, next, real-rows, destination length and width.
: fx.fancy ( str i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 -- bytes )
  :> width :> n :> real :> next :> prev :> method :> base :> vx :> hx :> rows :> stride :> h
  0 array.new ( array i32 ) :> none
  h hex base stride rows hx vx none plane.new :> p
  n bytes.new :> d
  p method prev next real d 0 width upsample.fancy
  d ;

