# libjpeg's per-component choice of upsampler (_jinit_upsampler in
# jdsample.c, with no DCT scaling): fancy flag, hexp, vexp and the
# downsampled width dw = ceil(width / hexp) -> 0 plain replication, 1 h2v1
# fancy, 2 h1v2 fancy, 3 h2v2 fancy. h2v1 and h2v2 are fancy only when dw
# exceeds 2, h1v2 always; libjpeg's fullsize, int_upsample, h2v1_upsample
# and h2v2_upsample are all replication. Its do_fancy is the user's flag
# (djpeg's default on, -nosmooth off) when nothing is scaled.
declare upsample.method ( i32 i32 i32 i32 -- i32 )
test upsample.method : 1 2 1 3 upsample.method -> 1
test upsample.method : 1 2 1 2 upsample.method -> 0
test upsample.method : 1 2 1 1 upsample.method -> 0
test upsample.method : 1 1 2 1 upsample.method -> 2
test upsample.method : 1 1 2 2 upsample.method -> 2
test upsample.method : 1 2 2 3 upsample.method -> 3
test upsample.method : 1 2 2 2 upsample.method -> 0
test upsample.method : 0 2 2 100 upsample.method -> 0
test upsample.method : 0 1 2 5 upsample.method -> 0
test upsample.method : 1 1 1 5 upsample.method -> 0
test upsample.method : 1 4 1 9 upsample.method -> 0
test upsample.method : 1 2 4 9 upsample.method -> 0
test upsample.method : 1 1 4 9 upsample.method -> 0
test upsample.method : 1 3 1 9 upsample.method -> 0

: upsample.method ( i32 i32 i32 i32 -- i32 )
  :> dw :> vx :> hx :> fancy
  fancy i32.eqz
  [ 0 ]
  [
    hx 2 i32.eq  vx 1 i32.eq  i32.and  dw 2 i32.gt_s  i32.and
    [ 1 ]
    [
      hx 1 i32.eq  vx 2 i32.eq  i32.and
      [ 2 ]
      [ hx 2 i32.eq  vx 2 i32.eq  i32.and  dw 2 i32.gt_s  i32.and [ 3 ] [ 0 ] if ]
      if
    ]
    if
  ]
  if ;

# One row of libjpeg's h2v1_fancy_upsample: src, the offset of the first of
# dw (>= 3) input samples, dw, dst, its offset and the output width (2dw-1
# or 2dw; an odd image width has one sample fewer). Each output is 3/4 of
# the nearer input and 1/4 of the further, the first and last outputs copy
# the edge samples, and the bias alternates +1, +2 between the pair, as
# libjpeg's ordered dither against rounding bias.
declare upsample.h2v1-row ( bytes i32 i32 bytes i32 i32 -- )

: upsample.h2v1-row ( bytes i32 i32 bytes i32 i32 -- )
  :> width :> doff :> dst :> dw :> off :> src
  dw
  [
    :> k
    src off k i32.add bytes.at 3 i32.mul :> v3
    k 2 i32.mul :> x
    k 0 i32.eq
    [ src off bytes.at ]
    [ v3  src off k i32.add 1 i32.sub bytes.at  i32.add 1 i32.add 2 i32.shr_s ]
    if :> even
    k dw 1 i32.sub i32.eq
    [ src off k i32.add bytes.at ]
    [ v3  src off k i32.add 1 i32.add bytes.at  i32.add 2 i32.add 2 i32.shr_s ]
    if :> odd
    x width i32.lt_s [ dst doff x i32.add even bytes.at! ] when
    x 1 i32.add width i32.lt_s [ dst doff x i32.add 1 i32.add odd bytes.at! ] when
  ]
  times ;

# Test fixture: hex input, off, dw, destination length, dst offset, width.
: fx.h2v1 ( str i32 i32 i32 i32 i32 -- bytes )
  :> width :> doff :> n :> dw :> off :> h
  n bytes.new :> d
  h hex off dw d doff width upsample.h2v1-row
  d ;

