# Test fixtures for 12-bit planes: a hex string of 16-bit big-endian samples,
# stride, hexp, vexp (base 0, data empty); and a run into a fresh width x
# rows array.
: fx.plane12 ( str i32 i32 i32 -- plane )
  :> vx :> hx :> stride :> h
  h hex :> b
  b bytes.len 2 i32.div_u :> n
  n array.new ( array i32 ) :> w
  n [ :> i  w i  b i 2 i32.mul bytes.at 8 i32.shl  b i 2 i32.mul 1 i32.add bytes.at  i32.or  array.at! ] times
  0 bytes.new :> none
  none 0 stride  n stride i32.div_u  hx vx w plane.new ;
: fx.up12 ( plane i32 i32 -- array i32 )
  :> rows :> width :> p
  width rows i32.mul array.new ( array i32 ) :> d
  p d 0 width rows upsample.plain12
  d ;
: fx.up12-at ( plane i32 -- array i32 )
  :> off :> p
  12 array.new ( array i32 ) :> d
  p d off 2 1 upsample.plain12
  d ;

