: fx.lcg1024 ( -- str )
  "966268585E9E6FD777779214C68084A7DE2342FC16BF4A05702D3E2CE42B4CC0D9D712D7A6653BD4FF00B204443F3666C03CF69D5DC4678C2B55293C3022F34E"
  "C4FB3F83AA2A353EF66182FE80C9206BE6DBBF3FEC73B5A8F5154A83BE4E3B2E90DE4761A2C591510DC254E9236D1F8D099F0F59925D06B3AAF5FDF188F550D4" str.concat
  "562498C04BFFD9" str.concat ;
# Those bits.
: fx.lcg1024-bits ( -- str )
  "3D33E3B1363B247E5806A75B5552A11B612F5FEFE40F31EB7A9AC8645C8BC62E2E5E52F38ED61ADD3CEEE95E2245DC46605A6FB13CF7FDFD0999A6E4390C7D53"
  "E729622411CE5EDFDCEC26664A077FF3FA049C6792EBAF9DE52179C9E91698F6FD3572F8FB3244C3A945CD8D0FA0E21AE1B18CBA000B830F81ABB3E0C6D11B2D" str.concat ;
