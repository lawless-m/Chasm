# Arithmetic decoding: the QM decoder of T.81 Annex D as libjpeg-turbo's
# jdarith.c implements it.
#
# Statistics: one bytes of 1281 bins, DC table t (0..3) at t x 64, AC table t
# at 256 + t x 256, and libjpeg's fixed-probability bin at 1280 (state 113).
# Each bin is one byte: the MPS in bit 7, the state index in bits 0..6. The
# state table (arith.table) is jaricom.c's jpeg_aritab, Qe << 16 |
# Next_Index_MPS << 8 | Switch_MPS << 7 | Next_Index_LPS, and arith.vs-d3
# checks entries 0..112 against T.81's Table D.3 (113 is libjpeg's fixed bin).
#
# Registers as libjpeg's: c (the code register, with a floating cut point at
# bit ct), a (the interval), ct (bits left, -16 at a scan's start so the
# first two bytes are read before the first decision). marker is libjpeg's
# unread_marker: once a marker is met inside the data the decoder is fed zero
# bytes, which is how every arithmetic scan normally ends, since the encoder
# discards trailing zero bytes (jcarith.c finish_pass).
#
# Strictness: a marker inside arithmetic data is legal and feeds zeros, as in
# libjpeg, so a scan cut short and closed with a marker decodes exactly as
# djpeg decodes it; running out of input (TRUNCATED), bytes the decoder did
# not consume before the marker (BAD_ENTROPY_DATA), restart faults
# (BAD_RESTART) and spectral or magnitude overflow (BAD_ENTROPY_DATA) are
# refused where libjpeg warns. Every arithmetic frame, sequential or
# progressive, decodes through the whole-image coefficient store
# (rows.multi), sharing the progression checks, quant table latching, block
# smoothing and output pass with the Huffman store path. Conditioning comes
# from DAC segments (markers.dac: libjpeg's 16 tables, L 0 U 1 and Kx 5 by
# default, validated as get_dac); scans select tables 0..3.

struct arith
  data: bytes  pos: i32  c: i32  a: i32  ct: i32  marker: i32  stats: bytes  tab: array i32
  lastdc: array i32  dcctx: array i32  blk: array i32  nat: array i32
  dcl: array i32  dcu: array i32  ack: array i32
  scn: option scan  prog: i32  restart: i32  togo: i32  next-rst: i32  mcu: i32  total: i32

# jaricom.c's 114 packed entries.
declare arith.table ( -- array i32 )

# The jpeg (its data and DAC conditioning), the natural-order table and a
# flag: 1 allocates the statistics and a block, 0 leaves them empty (a
# Huffman decoder carries an empty arith). The only allocation of this file.
declare arith.make ( jpeg array i32 i32 -- arith )

# The entries 0..112 of arith.table that differ from Table D.3 in Qe,
# Next_Index_LPS, Next_Index_MPS or Switch_MPS.
declare arith.vs-d3 ( -- i32 )

# jaricom.c's table, 8 hex digits per entry, generated from the source.
: fx.aritab-hex ( -- str )
  "5A1D01812586020E11140310080B041203D8051401DA061700E50719006F081C0036091E001A0A21000D0B2300060C0900030D0A00010D0C5A7F0F8F3F251024"
  "2CF21126207C122717B913281182142A0CEF152B09A1162D072F172E055C18300406193103031A3302401B3401B11C3601441D3800F51E3900B71F3B008A203C" str.concat
  "0068213E004E223F003B2320002C09215AE125A5484C26403A0D27412EF12843261F29441F332A4519A82B4615182C4811772D490E742E4A0BFB2F4B09F8304D" str.concat
  "0861314E0706324F05CD333004DE3432040F35320363363302D43734025C383501F8393601A43A3701603B3801253C3900F63D3A00CB3E3B00AB3F3D008F203D" str.concat
  "5B1241C14D044250412C435137D844522FE84553293C4654237947561EDF48571AA94957174E4A4814244B48119C4C4A0F6B4D4A0D514E4B0BB64F4D0A40304D" str.concat
  "583251D04D1C5258438E53593BDD545A34EE555B2EAE565C299A575D25164756557059D84CA95A5F44D95B603E225C6138245D6332B45E632E17565D56A860DF" str.concat
  "4F46616547E5626641CF63673C3D6468375E5D63523166694C0F676A4639686B415E636756276AE950E76B6C4B85676D55976D6E504F6B6F5A106FEE55226D70" str.concat
  "59EB6FF05A1D7171" str.concat ;

# T.81 Table D.3, 5 bytes per entry (Qe high, Qe low, Next_Index_LPS,
# Next_Index_MPS, Switch_MPS), extracted from the PDF by tmp/m5/d3.py.
: fx.d3-hex ( -- str )
  "5A1D01010125860E02001114100300080B12040003D814050001DA17060000E5190700006F1C080000361E0900001A210A00000D230B000006090C0000030A0D"
  "0000010C0D005A7F0F0F013F252410002CF2261100207C27120017B928130011822A14000CEF2B150009A12D1600072F2E1700055C3018000406311900030333" str.concat
  "1A000240341B0001B1361C000144381D0000F5391E0000B73B1F00008A3C200000683E2100004E3F2200003B202300002C2109005AE1252501484C4026003A0D" str.concat
  "4127002EF1432800261F4429001F33452A0019A8462B001518482C001177492D000E744A2E000BFB4B2F0009F84D300008614E310007064F320005CD30330004" str.concat
  "DE323400040F323500036333360002D4343700025C35380001F836390001A4373A000160383B000125393C0000F63A3D0000CB3B3E0000AB3D3F00008F3D2000" str.concat
  "5B124141014D04504200412C51430037D85244002FE8534500293C54460023795647001EDF5748001AA9574900174E484A001424484B00119C4A4C000F6B4A4D" str.concat
  "000D514B4E000BB64D4F000A404D300058325051014D1C585200438E5953003BDD5A540034EE5B55002EAE5C5600299A5D5700251656470055705859014CA95F" str.concat
  "5A0044D9605B003E22615C003824635D0032B4635E002E175D560056A85F60014F4665610047E566620041CF6763003C3D686400375E635D0052316966004C0F" str.concat
  "6A670046396B6800415E6763005627696A0150E76C6B004B856D670055976E6D00504F6F6B005A106E6F015522706D0059EB706F01" str.concat ;

: arith.table ( -- array i32 )
  fx.aritab-hex hex :> b
  114 array.new ( array i32 ) :> t
  114
  [
    :> i
    t i
    b i 4 i32.mul bytes.at 24 i32.shl  b i 4 i32.mul 1 i32.add bytes.at 16 i32.shl i32.or
    b i 4 i32.mul 2 i32.add bytes.at 8 i32.shl i32.or  b i 4 i32.mul 3 i32.add bytes.at i32.or
    array.at!
  ]
  times
  t ;

: arith.make ( jpeg array i32 i32 -- arith )
  :> alloc :> nat :> j
  alloc [ 1281 ] [ 0 ] if bytes.new :> st
  alloc [ st 1280 113 bytes.at! ] when
  alloc [ 64 ] [ 0 ] if array.new ( array i32 ) :> blk
  MAX_COMPONENTS array.new ( array i32 ) :> lastdc
  MAX_COMPONENTS array.new ( array i32 ) :> dcctx
  arith.table :> t
  option.none ( option scan ) :> none
  j jpeg.data 0 0 0 -16 0 st t lastdc dcctx blk nat j jpeg.dc-l j jpeg.dc-u j jpeg.ac-k none 0 0 0 0 0 0 arith.new ;

: arith.vs-d3 ( -- i32 )
  arith.table :> t
  fx.d3-hex hex :> d
  0 :> bad!
  113
  [
    :> i
    t i array.at :> v
    i 5 i32.mul :> o
    v 16 i32.shr_u  d o bytes.at 8 i32.shl d o 1 i32.add bytes.at i32.or  i32.ne
    v 127 i32.and  d o 2 i32.add bytes.at  i32.ne  i32.or
    v 8 i32.shr_u 255 i32.and  d o 3 i32.add bytes.at  i32.ne  i32.or
    v 7 i32.shr_u 1 i32.and  d o 4 i32.add bytes.at  i32.ne  i32.or
    [ bad 1 i32.add bad! ] when
  ]
  times
  bad ;

# Test fixture: an arithmetic decoder over hex data.
: fx.arith ( str -- arith )  hex markers.open idct.make idct.natural 1 arith.make ;

test arith.table : arith.table array.len -> 114
test arith.table : arith.table 0 array.at -> 0x5A1D0181
test arith.table : arith.table 1 array.at -> 0x2586020E
test arith.table : arith.table 35 array.at -> 0x002C0921
test arith.table : arith.table 112 array.at -> 0x59EB6FF0
test arith.table : arith.table 113 array.at -> 0x5A1D7171
test arith.table : arith.table 0 i64 [ i64 i64.add ] fold -> 66202512378 i64
test arith.table : arith.table 0 [ 16 i32.shr_u i32.add ] fold -> 1010145
test arith.table : arith.table 0 [ 127 i32.and i32.add ] fold -> 7674
test arith.table : arith.table 0 [ 8 i32.shr_u 255 i32.and i32.add ] fold -> 6409
test arith.table : arith.table 0 [ 7 i32.shr_u 1 i32.and i32.add ] fold -> 10
test arith.vs-d3 : arith.vs-d3 -> 0
test arith.make : "" fx.arith arith.stats bytes.len -> 1281
test arith.make : "" fx.arith arith.stats 1280 bytes.at -> 113
test arith.make : "" fx.arith arith.ct -> -16
test arith.make : "" fx.arith arith.dcu 0 array.at -> 1
test arith.make : "" fx.arith arith.ack 0 array.at -> 5
test arith.make : "" fx.arith arith.blk array.len -> 64
test arith.make : "FFD8" hex markers.open idct.make idct.natural 0 arith.make arith.stats bytes.len -> 0

# One byte for the code register (libjpeg's get_byte inside arith_decode):
# 0 once a marker has been met, without reading; FF followed by FFs and 00
# is one FF data byte; FF followed by FFs and another byte is a marker,
# recorded in arith.marker with pos left at the run's first FF, and the
# decoder is fed zeros from then on (legal: it is how every scan ends). The
# end of the data inside a scan is TRUNCATED (libjpeg warns JWRN_JPEG_EOF
# and inserts a fake EOI; strict refuses).
declare arith.byte ( arith -- i32 )

# The renormalisation loop of arith_decode: while a < 0x8000, fetch a byte
# into c whenever ct runs out, and double a. ct starts at -16, so the first
# two bytes are read before the first decision.
declare arith.norm ( arith -- )

# One decision with the statistics bin at an index (libjpeg's
# arith_decode): the interval split, the conditional exchange and the state
# update ported verbatim. In T.81's terms the spec's C register is
# c << (16 - ct) and its A is a.
declare arith.decode ( arith i32 -- i32 )

: arith.byte ( arith -- i32 )
  :> ar
  0 :> out!
  ar arith.marker i32.eqz
  [
    ar arith.data :> d
    d bytes.len :> n
    ar arith.pos :> p
    p n i32.ge_s [ TRUNCATED "arithmetic data ends before the scan's last MCU" p refusal-n trap ] when
    d p bytes.at :> b
    b 0xFF i32.ne
    [ ar p 1 i32.add arith.pos!  b out! ]
    [
      p 1 i32.add :> q!
      [ q n i32.lt_s [ d q bytes.at 0xFF i32.eq ] [ 0 ] if ] [ q 1 i32.add q! ] while
      q n i32.ge_s [ TRUNCATED "arithmetic data ends inside an FF run at" p refusal-n trap ] when
      d q bytes.at :> m
      m [ ar m arith.marker! ] [ ar q 1 i32.add arith.pos!  0xFF out! ] if
    ]
    if
  ]
  when
  out ;

: arith.norm ( arith -- )
  :> ar
  [ ar arith.a 0x8000 i32.lt_s ]
  [
    ar  ar arith.ct 1 i32.sub  arith.ct!
    ar arith.ct 0 i32.lt_s
    [
      ar  ar arith.c 8 i32.shl  ar arith.byte i32.or  arith.c!
      ar  ar arith.ct 8 i32.add  arith.ct!
      ar arith.ct 0 i32.lt_s
      [
        ar  ar arith.ct 1 i32.add  arith.ct!
        ar arith.ct i32.eqz [ ar 0x8000 arith.a! ] when
      ]
      when
    ]
    when
    ar  ar arith.a 1 i32.shl  arith.a!
  ]
  while ;

: arith.decode ( arith i32 -- i32 )
  :> si :> ar
  ar arith.norm
  ar arith.stats :> st
  st si bytes.at :> sv!
  ar arith.tab sv 127 i32.and array.at :> v
  v 255 i32.and :> nl
  v 8 i32.shr_u 255 i32.and :> nm
  v 16 i32.shr_u :> qe
  ar arith.a qe i32.sub :> ai
  ar ai arith.a!
  ai ar arith.ct i32.shl :> temp
  ar arith.c temp i32.ge_s
  [
    ar  ar arith.c temp i32.sub  arith.c!
    ai qe i32.lt_s
    [ ar qe arith.a!  st si  sv 128 i32.and nm i32.xor  bytes.at! ]
    [ ar qe arith.a!  st si  sv 128 i32.and nl i32.xor  bytes.at!  sv 128 i32.xor sv! ]
    if
  ]
  [
    ai 0x8000 i32.lt_s
    [
      ai qe i32.lt_s
      [ st si  sv 128 i32.and nl i32.xor  bytes.at!  sv 128 i32.xor sv! ]
      [ st si  sv 128 i32.and nm i32.xor  bytes.at! ]
      if
    ]
    when
  ]
  if
  sv 7 i32.shr_u ;

# Test fixtures: T.81 K.4.1's input bits and coded bytes; n decisions in one
# context, or in context i mod m, packed MSB first; the state before event
# n + 1; the spec's C register; the encoder vectors of tmp/m5/qm.py.
: fx.k4-in ( -- str )  "00020051000000C00352872AAAAAAAAA82C02000FCD79EF674EAABF7697EE74C" ;
: fx.k4 ( -- str )  "655B5144F7969D517855BFFF00FC5184C7CEF93900287D46708ECBC0F6FFD900" ;
: fx.adec-rr ( arith i32 i32 -- bytes )
  :> n :> m :> ar
  n 8 i32.div_u bytes.new :> out
  n
  [
    :> i
    ar i m i32.rem_u arith.decode
    [ out  i 3 i32.shr_u  out i 3 i32.shr_u bytes.at  128 i 7 i32.and i32.shr_u i32.or  bytes.at! ]
    when
  ]
  times
  out ;
: fx.adec ( arith i32 i32 -- bytes )
  :> n :> si :> ar
  n 8 i32.div_u bytes.new :> out
  n
  [
    :> i
    ar si arith.decode
    [ out  i 3 i32.shr_u  out i 3 i32.shr_u bytes.at  128 i 7 i32.and i32.shr_u i32.or  bytes.at! ]
    when
  ]
  times
  out ;
: fx.state ( str i32 -- arith )
  :> n :> h
  h fx.arith :> ar
  n [ drop ar 0 arith.decode drop ] times
  ar arith.norm
  ar ;
: fx.spec-c ( arith -- i32 )  :> ar  ar arith.c  16 ar arith.ct i32.sub  i32.shl ;
# 2048 zero decisions in context 0.
: fx.zeros2048 ( -- str )
  "4CFFD9" ;
# The K.4.1 bits, decision i in context i mod 8.
: fx.k4rr8 ( -- str )
  "4BEF3101743929B5849A9DE293CB02CF91D8DD4BB5C28243EEBD0A408C587AC57910FFD9" ;
