# The input: one file loaded into one bytes buffer.
#
# There is no way to learn a file's size before reading it, so the buffer
# starts at 1 MiB and doubles whenever the file fills it, up to
# MAX_INPUT_BYTES + 1: the memory touched is under four times the file's
# size, not 64 MB. Reading more than MAX_INPUT_BYTES refuses LIMIT_INPUT. A path that cannot be opened
# refuses NOT_JPEG: the refusal table has no code for an unreadable file, and
# to the service an input it cannot open is not a JPEG.

declare source.check-size ( i32 -- )
test source.check-size : 64000001 source.check-size -> trap
test source.check-size : 64000000 source.check-size 1 -> 1

# The first buffer's size.
declare source.first ( -- i32 )
test source.first : source.first -> 1048576

# A buffer, a new length: a fresh buffer of that length holding the old
# buffer's bytes at the front.
declare source.grow ( bytes i32 -- bytes )
test source.grow : "414243" hex 6 source.grow bytes.len -> 6
test source.grow : "414243" hex 6 source.grow 0 bytes.at -> 65
test source.grow : "414243" hex 6 source.grow 2 bytes.at -> 67
test source.grow : "414243" hex 6 source.grow 3 bytes.at -> 0
test source.grow : "4142" hex 1 source.grow -> trap

declare source.load ( str -- bytes )

: source.check-size ( i32 -- )
  MAX_INPUT_BYTES i32.gt_s [ LIMIT_INPUT "input over MAX_INPUT_BYTES" refusal trap ] when ;

: source.first ( -- i32 )  1048576 ;

: source.grow ( bytes i32 -- bytes )
  :> n :> old
  n bytes.new :> new
  new 0 old bytes.as-str bytes.put
  new ;

# Every pass of the loop reads into the unread tail, so the position only
# grows; a full buffer below the cap doubles first (to at most the cap), and
# a full buffer at the cap leaves an empty tail, which reads 0 and ends it.
: source.load ( str -- bytes )
  host.OREAD host.open :> h
  h 0 i32.lt_s [ NOT_JPEG "cannot open input" refusal trap ] when
  MAX_INPUT_BYTES 1 i32.add :> cap
  source.first bytes.new :> buf!
  0 :> total!
  1 :> n!
  [ n 0 i32.gt_s ]
  [
    total buf bytes.len i32.eq  buf bytes.len cap i32.lt_s  i32.and
    [
      buf bytes.len 2 i32.mul :> twice
      buf  twice cap i32.gt_s [ cap ] [ twice ] if  source.grow buf!
    ]
    when
    h  buf total  buf bytes.len total i32.sub  bytes.slice  host.read n!
    n 0 i32.lt_s [ TRUNCATED "read error" refusal trap ] when
    total n i32.add total!
  ]
  while
  h host.close drop
  total source.check-size
  buf 0 total bytes.slice ;
