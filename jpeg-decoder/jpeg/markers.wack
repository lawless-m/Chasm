# The segment walker: markers, segment lengths and the tables they define.
#
# Markers are FF xx, xx neither 00 nor FF (FF FF is fill). A segment carries
# a big-endian 2-byte length that includes itself (JPEG-NOTES.md).
#
# State, in one `jpeg` struct: the input and the read position; the frame,
# once a SOF is parsed; qt, 4 quantisation tables x 64 entries in the order
# read, and qt-set, a flag per table; huff-at, indexed tc*4+th, the offset in
# the input of a Huffman table's 16 counts, -1 while undefined (M1 builds the
# code tables from there); the restart interval; and what APP0 (JFIF) and
# APP14 (Adobe, with its transform) said; the scan, once a SOS is parsed;
# scans, the SOS headers parsed so far; and eoi, set once the EOI marker has
# been stepped over.
#
# Invariants: pos only moves forward, and every malformed input is refused at
# the point it is first visible, before any bytes.at could trap.

# A scan header: its components (indexes into the frame's), their DC and AC
# table selectors, spectral selection, successive approximation, and the
# offset of the first entropy-coded byte.
struct scan
  ncomp: i32  comps: array i32  td: array i32  ta: array i32
  ss: i32  se: i32  ah: i32  al: i32  data-at: i32

struct jpeg
  data: bytes  pos: i32  frame: option frame
  qt: array i32  qt-set: array i32  huff-at: array i32
  restart: i32  jfif: i32  adobe: i32  transform: i32  scan: option scan
  scans: i32  eoi: i32

declare markers.open ( bytes -- jpeg )
test markers.open : "FFD8" hex markers.open jpeg.pos -> 0
test markers.open : "FFD8" hex markers.open jpeg.huff-at 7 array.at -> -1
test markers.open : "FFD8" hex markers.open jpeg.qt array.len -> 256

declare markers.u8 ( bytes i32 -- i32 )
test markers.u8 : "FFD8" hex 1 markers.u8 -> 0xD8
test markers.u8 : "FFD8" hex 2 markers.u8 -> trap

declare markers.u16 ( bytes i32 -- i32 )
test markers.u16 : "FFD8" hex 0 markers.u16 -> 0xFFD8
test markers.u16 : "FF" hex 0 markers.u16 -> trap

declare markers.soi ( jpeg -- )
test markers.soi : "FFD8FFD9" hex markers.open dup markers.soi jpeg.pos -> 2
test markers.soi : "FFD9" hex markers.open markers.soi -> trap
test markers.soi : "" hex markers.open markers.soi -> trap
test markers.soi : "FF" hex markers.open markers.soi -> trap

declare markers.next-marker ( jpeg -- i32 )
test markers.next-marker : "FFD8FFFFFFDB" hex markers.open dup markers.soi markers.next-marker -> 0xDB
test markers.next-marker : "FFD8FFFFFFDB" hex markers.open dup markers.soi dup markers.next-marker drop jpeg.pos -> 6
test markers.next-marker : "FFD8 00DB" hex markers.open dup markers.soi markers.next-marker -> trap
test markers.next-marker : "FFD8FF" hex markers.open dup markers.soi markers.next-marker -> trap
test markers.next-marker : "FFD8FF00" hex markers.open dup markers.soi markers.next-marker -> trap
test markers.next-marker : "FFD8" hex markers.open dup markers.soi markers.next-marker -> trap

declare markers.segment ( jpeg -- i32 i32 )
test markers.segment : "FFD8 0004 AABB" hex markers.open dup 2 jpeg.pos! markers.segment -> 4 2
test markers.segment : "FFD8 0004 AABB" hex markers.open dup 2 jpeg.pos! dup markers.segment 2drop jpeg.pos -> 6
test markers.segment : "FFD8 0001" hex markers.open dup 2 jpeg.pos! markers.segment -> trap
test markers.segment : "FFD8 0010 AA" hex markers.open dup 2 jpeg.pos! markers.segment -> trap
test markers.segment : "FFD8 00" hex markers.open dup 2 jpeg.pos! markers.segment -> trap

: markers.open ( bytes -- jpeg )
  :> d
  option.none ( option frame ) :> nf
  option.none ( option scan ) :> ns
  256 array.new ( array i32 ) :> qt
  4 array.new ( array i32 ) :> qs
  8 array.new ( array i32 ) :> ha
  8 [ :> i  ha i -1 array.at! ] times
  d 0 nf qt qs ha 0 0 0 0 ns 0 0 jpeg.new ;

: markers.u8 ( bytes i32 -- i32 )
  :> off :> d
  off 0 i32.lt_s  off d bytes.len i32.ge_s  i32.or
  [ TRUNCATED "data ends before offset" off refusal-n trap ]
  when
  d off bytes.at ;

: markers.u16 ( bytes i32 -- i32 )
  :> off :> d
  d off markers.u8 8 i32.shl  d off 1 i32.add markers.u8  i32.or ;

: markers.soi ( jpeg -- )
  :> j
  j jpeg.data :> d
  [ d bytes.len 2 i32.lt_s ] [ d 0 bytes.at 0xFF i32.ne  d 1 bytes.at 0xD8 i32.ne  i32.or ] or
  [ NOT_JPEG "no SOI at the start" refusal trap ]
  when
  j 2 jpeg.pos! ;

: markers.next-marker ( jpeg -- i32 )
  :> j
  j jpeg.data :> d
  d bytes.len :> len
  j jpeg.pos :> p!
  p len i32.ge_s [ TRUNCATED "data ends where a marker was expected" refusal trap ] when
  d p bytes.at 0xFF i32.ne
  [ BAD_SEGMENT_LENGTH "expected a marker at offset" p refusal-n trap ]
  when
  p 1 i32.add p!
  [ [ p len i32.lt_s ] [ d p bytes.at 0xFF i32.eq ] and ] [ p 1 i32.add p! ] while
  p len i32.ge_s [ TRUNCATED "data ends inside a marker" refusal trap ] when
  d p bytes.at :> m
  m 0 i32.eq [ BAD_SEGMENT_LENGTH "stuffed byte where a marker was expected at offset" p refusal-n trap ] when
  j p 1 i32.add jpeg.pos!
  m ;

: markers.segment ( jpeg -- i32 i32 )
  :> j
  j jpeg.pos :> p
  j jpeg.data p markers.u16 :> len
  len 2 i32.lt_s [ BAD_SEGMENT_LENGTH "segment length" len refusal-n trap ] when
  p len i32.add j jpeg.data bytes.len i32.gt_s
  [ TRUNCATED "segment runs past the end at offset" p refusal-n trap ]
  when
  j p len i32.add jpeg.pos!
  p 2 i32.add  len 2 i32.sub ;

# A string repeated n times, for building tables in tests.
: fx.rep ( str i32 -- str )
  :> n :> s
  "" n [ drop s str.concat ] times ;
test fx.rep : "ab" 3 fx.rep -> "ababab"

# DQT (T.81 B.2.4.1): one or more tables, each Pq/Tq then 64 entries of 1
# byte (Pq 0) or 2 big-endian bytes (Pq 1), stored in the order read.
declare markers.dqt ( jpeg i32 i32 -- )
test markers.dqt : fx.dqt hex markers.open dup 4 65 markers.dqt jpeg.qt-set 0 array.at -> 1
test markers.dqt : fx.dqt hex markers.open dup 4 65 markers.dqt jpeg.qt 0 array.at -> 16
test markers.dqt : fx.tiny hex markers.open dup 24 65 markers.dqt jpeg.qt 63 array.at -> 99
test markers.dqt : "11" "0100" 64 fx.rep str.concat hex markers.open dup 0 129 markers.dqt jpeg.qt 64 array.at -> 256
test markers.dqt : "00" "01" 64 fx.rep str.concat "01" str.concat "02" 64 fx.rep str.concat hex markers.open dup 0 130 markers.dqt jpeg.qt 127 array.at -> 2
test markers.dqt : "04" "01" 64 fx.rep str.concat hex markers.open dup 0 65 markers.dqt -> trap
test markers.dqt : "20" "01" 64 fx.rep str.concat hex markers.open dup 0 65 markers.dqt -> trap
test markers.dqt : "00" "01" 10 fx.rep str.concat hex markers.open dup 0 11 markers.dqt -> trap
test markers.dqt : "00" "01" 64 fx.rep str.concat "00" str.concat hex markers.open dup 0 66 markers.dqt -> trap
test markers.dqt : "00" hex markers.open dup 0 0 markers.dqt -> trap

# DHT (B.2.4.2): one or more tables, each Tc/Th, 16 counts, then the
# symbols. Only validated and located here: huff-at records where the counts
# start, and M1 builds the codes from there.
declare markers.dht ( jpeg i32 i32 -- )
test markers.dht : fx.tiny hex markers.open dup 106 18 markers.dht jpeg.huff-at 0 array.at -> 107
test markers.dht : fx.tiny hex markers.open dup 128 18 markers.dht jpeg.huff-at 4 array.at -> 129
test markers.dht : "20" "00" 16 fx.rep str.concat hex markers.open dup 0 17 markers.dht -> trap
test markers.dht : "04" "00" 16 fx.rep str.concat hex markers.open dup 0 17 markers.dht -> trap
test markers.dht : "00" "00" 14 fx.rep str.concat "02FF" str.concat hex markers.open dup 0 17 markers.dht -> trap
test markers.dht : "0003" "00" 15 fx.rep str.concat "000102" str.concat hex markers.open dup 0 20 markers.dht -> trap
test markers.dht : "0002" "00" 15 fx.rep str.concat "00" str.concat hex markers.open dup 0 18 markers.dht -> trap
test markers.dht : "00" "00" 5 fx.rep str.concat hex markers.open dup 0 6 markers.dht -> trap

# DRI (B.2.4.4): the restart interval in MCUs.
declare markers.dri ( jpeg i32 i32 -- )
test markers.dri : "0010" hex markers.open dup 0 2 markers.dri jpeg.restart -> 16
test markers.dri : "000100" hex markers.open dup 0 3 markers.dri -> trap

: markers.dqt ( jpeg i32 i32 -- )
  :> len :> start :> j
  j jpeg.data :> d
  len 0 i32.eq [ BAD_SEGMENT_LENGTH "empty DQT" refusal trap ] when
  start len i32.add :> end
  start :> p!
  [ p end i32.lt_s ]
  [
    d p markers.u8 :> b
    b 4 i32.shr_u :> pq
    b 15 i32.and :> tq
    pq 1 i32.gt_u [ BAD_TABLE "DQT precision" pq refusal-n trap ] when
    tq 3 i32.gt_u [ BAD_TABLE "DQT table index" tq refusal-n trap ] when
    pq 1 i32.add 64 i32.mul :> size
    p 1 i32.add size i32.add end i32.gt_s
    [ BAD_SEGMENT_LENGTH "DQT shorter than its table at offset" p refusal-n trap ]
    when
    64
    [
      :> k
      j jpeg.qt  tq 64 i32.mul k i32.add
      pq [ d p 1 i32.add k 2 i32.mul i32.add markers.u16 ] [ d p 1 i32.add k i32.add markers.u8 ] if
      array.at!
    ]
    times
    j jpeg.qt-set tq 1 array.at!
    p 1 i32.add size i32.add p!
  ]
  while ;

: markers.dht ( jpeg i32 i32 -- )
  :> len :> start :> j
  j jpeg.data :> d
  start len i32.add :> end
  start :> p!
  [ p end i32.lt_s ]
  [
    d p markers.u8 :> b
    b 4 i32.shr_u :> tc
    b 15 i32.and :> th
    tc 1 i32.gt_u [ BAD_TABLE "DHT class" tc refusal-n trap ] when
    th 3 i32.gt_u [ BAD_TABLE "DHT table index" th refusal-n trap ] when
    p 17 i32.add end i32.gt_s
    [ BAD_SEGMENT_LENGTH "DHT shorter than its counts at offset" p refusal-n trap ]
    when
    0 :> total!
    0 :> kraft!
    16
    [
      :> i
      d p 1 i32.add i i32.add markers.u8 :> c
      total c i32.add total!
      kraft  c 15 i i32.sub i32.shl  i32.add kraft!
    ]
    times
    total 256 i32.gt_s [ BAD_TABLE "DHT symbol count" total refusal-n trap ] when
    p 17 i32.add total i32.add end i32.gt_s
    [ BAD_SEGMENT_LENGTH "DHT shorter than its symbols at offset" p refusal-n trap ]
    when
    kraft 65536 i32.gt_s [ BAD_TABLE "DHT over-subscribed at offset" p refusal-n trap ] when
    j jpeg.huff-at  tc 4 i32.mul th i32.add  p 1 i32.add  array.at!
    p 17 i32.add total i32.add p!
  ]
  while ;

: markers.dri ( jpeg i32 i32 -- )
  :> len :> start :> j
  len 2 i32.ne [ BAD_SEGMENT_LENGTH "DRI length" len refusal-n trap ] when
  j  j jpeg.data start markers.u16  jpeg.restart! ;

declare markers.has-frame? ( jpeg -- i32 )
declare markers.frame-width ( jpeg -- i32 )

# APP0: a payload starting JFIF\0 marks a JFIF file; any other APP0 (JFXX
# and the like) is skipped.
declare markers.app0 ( jpeg i32 i32 -- )
test markers.app0 : fx.app0 hex markers.open dup 4 14 markers.app0 jpeg.jfif -> 1
test markers.app0 : "FFE0 0007 0000000000" hex markers.open dup 4 5 markers.app0 jpeg.jfif -> 0

# APP14: Adobe, version (2 bytes), flags0 (2), flags1 (2), transform (1).
declare markers.app14 ( jpeg i32 i32 -- )
test markers.app14 : "FFEE 000E 41646F6265 0064 0000 0000 01" hex markers.open dup 4 12 markers.app14 jpeg.adobe -> 1
test markers.app14 : "FFEE 000E 41646F6265 0064 0000 0000 01" hex markers.open dup 4 12 markers.app14 jpeg.transform -> 1
test markers.app14 : "FFEE 0007 41646F6265" hex markers.open dup 4 5 markers.app14 jpeg.adobe -> 0

# SOF (B.2.2): marker byte, payload start and length. Builds the frame, runs
# frame.check before any geometry word (hmax may be 0 in hostile input),
# then the memory budget. The component array is the only allocation, made
# after the count is known to be in range; nothing is allocated after
# frame.check-memory.
declare markers.sof ( jpeg i32 i32 i32 -- )
test markers.sof : fx.sof hex markers.open dup 0xC0 4 9 markers.sof markers.frame-width -> 1
test markers.sof : fx.sof hex markers.open dup 0xC0 4 9 markers.sof markers.has-frame? -> 1
test markers.sof : fx.sof hex markers.open markers.has-frame? -> 0
test markers.sof : fx.sof hex markers.open dup dup 0xC0 4 9 markers.sof 0xC0 4 9 markers.sof -> trap
test markers.sof : fx.sof hex markers.open 0xC0 4 8 markers.sof -> trap
test markers.sof : fx.sof hex markers.open 0xC0 4 5 markers.sof -> trap
test markers.sof : "FFC0 000B 08 0001 4001 01 011100" hex markers.open 0xC0 4 9 markers.sof -> trap
test markers.sof : "FFC0 0008 08 0001 0001 00" hex markers.open 0xC0 4 6 markers.sof -> trap

: markers.has-frame? ( jpeg -- i32 )  jpeg.frame none: [ 0 ] some: [ drop 1 ] match ;
: markers.frame-width ( jpeg -- i32 )  jpeg.frame none: [ -1 ] some: [ frame.width ] match ;

: markers.app0 ( jpeg i32 i32 -- )
  :> len :> start :> j
  j jpeg.data :> d
  [ len 5 i32.ge_s ] [ d start 5 bytes.slice bytes.to-str "JFIF\u{0}" str.eq ] and
  [ j 1 jpeg.jfif! ]
  when ;

: markers.app14 ( jpeg i32 i32 -- )
  :> len :> start :> j
  j jpeg.data :> d
  [ len 12 i32.ge_s ] [ d start 5 bytes.slice bytes.to-str "Adobe" str.eq ] and
  [ j 1 jpeg.adobe!  j  d start 11 i32.add markers.u8  jpeg.transform! ]
  when ;

: markers.sof ( jpeg i32 i32 i32 -- )
  :> len :> start :> m :> j
  j jpeg.data :> d
  j markers.has-frame? [ UNSUPPORTED_SOF "second SOF (hierarchical)" refusal trap ] when
  len 6 i32.lt_s [ BAD_SEGMENT_LENGTH "SOF length" len refusal-n trap ] when
  d start markers.u8 :> p
  d start 1 i32.add markers.u16 :> ht
  d start 3 i32.add markers.u16 :> wd
  d start 5 i32.add markers.u8 :> nf
  len 6 nf 3 i32.mul i32.add i32.ne [ BAD_SEGMENT_LENGTH "SOF length for its components" len refusal-n trap ] when
  nf 1 i32.lt_s  nf MAX_COMPONENTS i32.gt_s  i32.or
  [ BAD_COMPONENT "component count" nf refusal-n trap ]
  when
  nf array.new ( array component ) :> cs
  nf
  [
    :> i
    start 6 i32.add i 3 i32.mul i32.add :> at
    d at 1 i32.add markers.u8 :> hv
    cs i  d at markers.u8  hv 4 i32.shr_u  hv 15 i32.and  d at 2 i32.add markers.u8  component.new  array.at!
  ]
  times
  m p ht wd nf cs frame.new :> f
  f frame.check
  f d bytes.len MEM_BUDGET i64 frame.check-memory
  j f option.some jpeg.frame! ;

# Test helpers: parse the fixture's known segments at their offsets, so a
# test can vary only the SOS that follows fx.head.
declare fx.prep ( bytes -- jpeg )
declare fx.ready ( -- jpeg )

# The first entropy byte of the parsed scan, or -1 when there is none.
declare markers.scan-data ( jpeg -- i32 )

# SOS (B.2.3): payload start and length. Checks the header against the
# frame and the tables defined so far, then records the scan. Sequential
# frames must be exactly Ss 0, Se 63, Ah 0, Al 0 (strict: libjpeg only
# warns). The ordering of progressive scans against each other is M4.
declare markers.sos ( jpeg i32 i32 -- )
test markers.sos : fx.ready dup 150 6 markers.sos markers.scan-data -> 156
test markers.sos : fx.ready markers.scan-data -> -1
test markers.sos : fx.tiny hex markers.open 150 6 markers.sos -> trap
test markers.sos : fx.head "FFDA 0006 00 003F00" str.concat hex fx.prep 150 4 markers.sos -> trap
test markers.sos : fx.head "FFDA 0010 05 0100 0100 0100 0100 0100 003F00" str.concat hex fx.prep 150 14 markers.sos -> trap
test markers.sos : fx.head "FFDA 0008 01 0200 003F00" str.concat hex fx.prep 150 6 markers.sos -> trap
test markers.sos : fx.head "FFDA 0008 01 0140 003F00" str.concat hex fx.prep 150 6 markers.sos -> trap
test markers.sos : fx.head "FFDA 0008 01 0100 013F00" str.concat hex fx.prep 150 6 markers.sos -> trap
test markers.sos : fx.head "FFDA 0008 01 0100 003E00" str.concat hex fx.prep 150 6 markers.sos -> trap
test markers.sos : fx.head "FFDA 0008 01 0100 003F01" str.concat hex fx.prep 150 6 markers.sos -> trap
test markers.sos : fx.head "FFDA 0008 01 0100 003F00" str.concat hex fx.prep 150 7 markers.sos -> trap
test markers.sos : fx.tiny hex markers.open dup 24 65 markers.dqt dup 0xC0 93 9 markers.sof 150 6 markers.sos -> trap
test markers.sos : fx.tiny hex markers.open dup 0xC0 93 9 markers.sof dup 106 18 markers.dht dup 128 18 markers.dht 150 6 markers.sos -> trap

: fx.prep ( bytes -- jpeg )
  markers.open :> j
  j 24 65 markers.dqt
  j 0xC0 93 9 markers.sof
  j 106 18 markers.dht
  j 128 18 markers.dht
  j ;

: fx.ready ( -- jpeg )  fx.tiny hex fx.prep ;

: markers.scan-data ( jpeg -- i32 )  jpeg.scan none: [ -1 ] some: [ scan.data-at ] match ;

: markers.sos ( jpeg i32 i32 -- )
  :> len :> start :> j
  j jpeg.data :> d
  j jpeg.frame none: [ NO_FRAME "SOS before SOF" refusal trap ] some: [ ] match :> f
  f frame.kind :> kind
  len 1 i32.lt_s [ BAD_SEGMENT_LENGTH "SOS length" len refusal-n trap ] when
  d start markers.u8 :> ns
  ns 1 i32.lt_s  ns 4 i32.gt_s  i32.or [ BAD_SCAN_HEADER "scan component count" ns refusal-n trap ] when
  len 4 ns 2 i32.mul i32.add i32.ne [ BAD_SEGMENT_LENGTH "SOS length for its components" len refusal-n trap ] when
  ns array.new ( array i32 ) :> sc
  ns array.new ( array i32 ) :> td
  ns array.new ( array i32 ) :> ta
  ns
  [
    :> k
    d start 1 i32.add k 2 i32.mul i32.add markers.u8 :> cid
    d start 2 i32.add k 2 i32.mul i32.add markers.u8 :> t
    -1 :> idx!
    f frame.ncomp [ :> c  f frame.comps c array.at component.id cid i32.eq [ c idx! ] when ] times
    idx 0 i32.lt_s [ BAD_SCAN_HEADER "scan component not in the frame, id" cid refusal-n trap ] when
    k [ :> q  sc q array.at idx i32.eq [ BAD_SCAN_HEADER "scan component twice, id" cid refusal-n trap ] when ] times
    t 4 i32.shr_u 3 i32.gt_u  t 15 i32.and 3 i32.gt_u  i32.or
    [ BAD_SCAN_HEADER "scan table selector, component id" cid refusal-n trap ]
    when
    sc k idx array.at!
    td k t 4 i32.shr_u array.at!
    ta k t 15 i32.and array.at!
  ]
  times
  start 1 i32.add ns 2 i32.mul i32.add :> at
  d at markers.u8 :> ss
  d at 1 i32.add markers.u8 :> se
  d at 2 i32.add markers.u8 :> a
  a 4 i32.shr_u :> ah
  a 15 i32.and :> al
  kind 0xC2 i32.eq  kind 0xCA i32.eq  i32.or :> progressive
  progressive
  [
    se 63 i32.gt_s  ss se i32.gt_s  i32.or
    ss 0 i32.eq se 0 i32.ne i32.and  i32.or
    ss 0 i32.gt_s ns 1 i32.ne i32.and  i32.or
    al 13 i32.gt_s  i32.or
    ah 0 i32.ne ah al 1 i32.add i32.ne i32.and  i32.or
    [ BAD_SCAN_HEADER "progressive scan parameters" refusal trap ]
    when
  ]
  [
    ss 0 i32.ne  se 63 i32.ne  i32.or  ah i32.or  al i32.or
    [ BAD_SCAN_HEADER "sequential scan must be Ss 0, Se 63, Ah 0, Al 0" refusal trap ]
    when
  ]
  if
  ns 1 i32.gt_s
  [
    0 :> blocks!
    ns [ :> b  f frame.comps sc b array.at array.at :> cb  blocks cb component.h cb component.v i32.mul i32.add blocks! ] times
    blocks 10 i32.gt_s [ BAD_SCAN_HEADER "blocks per MCU over 10" blocks refusal-n trap ] when
  ]
  when
  kind 0xC0 i32.eq  kind 0xC1 i32.eq  i32.or  kind 0xC2 i32.eq  i32.or :> huffman
  ns
  [
    :> e
    f frame.comps sc e array.at array.at :> ce
    j jpeg.qt-set ce component.tq array.at i32.eqz
    [ MISSING_TABLE "quantisation table" ce component.tq refusal-n trap ]
    when
    huffman
    [
      [ ss 0 i32.eq ah 0 i32.eq i32.and ] [ j jpeg.huff-at td e array.at array.at 0 i32.lt_s ] and
      [ MISSING_TABLE "DC Huffman table" td e array.at refusal-n trap ]
      when
      [ se 0 i32.gt_s ] [ j jpeg.huff-at 4 ta e array.at i32.add array.at 0 i32.lt_s ] and
      [ MISSING_TABLE "AC Huffman table" ta e array.at refusal-n trap ]
      when
    ]
    when
  ]
  times
  j jpeg.scans 1 i32.add :> nscans
  nscans MAX_SCANS i32.gt_s [ LIMIT_SCANS "scan count over MAX_SCANS" nscans refusal-n trap ] when
  j nscans jpeg.scans!
  j  ns sc td ta ss se ah al start len i32.add scan.new option.some  jpeg.scan! ;

declare markers.has-scan? ( jpeg -- i32 )

# One marker at pos: a table, header or APP segment is parsed, an APPn or
# COM is skipped by its length (its contents are never copied anywhere),
# and anything out of scope is refused before its length is read. DAC
# (arithmetic conditioning) is skipped by length here; M5 parses it.
declare markers.step ( jpeg -- )

# SOI, then one step at a time until a scan header is parsed (an EOI before
# the first scan is refused). Every step
# moves pos forward by at least 2 bytes, so the loop is bounded by the
# input length.
declare markers.walk ( jpeg -- )

# From jpeg.pos, which the caller sets to the FF of the marker that ended a
# scan's entropy data: steps through tables and other segments to the next
# SOS (1, its header parsed into jpeg.scan) or to the EOI (0, jpeg.eoi set).
# Every step moves pos forward, so the loop is bounded by the input length.
declare markers.next-scan ( jpeg -- i32 )
test markers.walk : fx.tiny hex markers.open dup markers.walk markers.scan-data -> 156
test markers.walk : fx.tiny hex markers.open dup markers.walk markers.frame-width -> 1
test markers.walk : fx.tiny hex markers.open dup markers.walk jpeg.jfif -> 1
test markers.walk : fx.soi fx.app0 str.concat fx.dqt str.concat "FFE1 0004 AABB" str.concat "FFFE 0005 414243" str.concat fx.sof str.concat fx.dht-dc str.concat fx.dht-ac str.concat fx.sos str.concat fx.tail str.concat hex markers.open dup markers.walk markers.scan-data -> 169
test markers.walk : fx.soi "FFFFFF" str.concat fx.app0 str.concat fx.dqt str.concat fx.sof str.concat fx.dht-dc str.concat fx.dht-ac str.concat fx.sos str.concat fx.tail str.concat hex markers.open dup markers.walk markers.scan-data -> 159
test markers.walk : fx.tiny 0 200 str.slice hex markers.open markers.walk -> trap
test markers.walk : fx.soi fx.dqt str.concat fx.dht-dc str.concat fx.dht-ac str.concat fx.sos str.concat fx.tail str.concat hex markers.open markers.walk -> trap
test markers.walk : fx.soi "FFD9" str.concat hex markers.open markers.walk -> trap
test markers.walk : fx.soi "FFD0" str.concat hex markers.open markers.walk -> trap
test markers.walk : fx.soi "FFD8" str.concat hex markers.open markers.walk -> trap
test markers.walk : fx.soi "FFC3000B080001000101011100" str.concat hex markers.open markers.walk -> trap
test markers.walk : fx.soi "FF02" str.concat hex markers.open markers.walk -> trap
test markers.walk : fx.soi "FFDC 0004 0001" str.concat hex markers.open markers.walk -> trap
test markers.walk : "00" fx.tiny str.concat hex markers.open markers.walk -> trap
test markers.walk : fx.head fx.sof str.concat fx.sos str.concat fx.tail str.concat hex markers.open markers.walk -> trap

: markers.has-scan? ( jpeg -- i32 )  jpeg.scan none: [ 0 ] some: [ drop 1 ] match ;

: markers.step ( jpeg -- )
  :> j
  j markers.next-marker :> m
  0 :> done!
  m 0xD8 i32.eq [ NOT_JPEG "second SOI" refusal trap ] when
  m 0xD9 i32.eq
  [
    j jpeg.scans i32.eqz [ NO_FRAME "EOI with no scan" refusal trap ] when
    j 1 jpeg.eoi!
    1 done!
  ]
  when
  m 0xD0 i32.ge_u  m 0xD7 i32.le_u  i32.and
  [ BAD_RESTART "RST marker outside entropy data" m refusal-n trap ]
  when
  m 0x01 i32.eq [ UNSUPPORTED_SOF "reserved marker" m refusal-n trap ] when
  m 0xC0 i32.eq  m 0xC1 i32.eq  i32.or  m 0xC2 i32.eq  i32.or  m 0xC9 i32.eq  i32.or  m 0xCA i32.eq  i32.or
  [ j m j markers.segment markers.sof  1 done! ]
  when
  m 0xC3 i32.eq  m 0xC5 i32.ge_u m 0xC8 i32.le_u i32.and  i32.or
  m 0xCB i32.eq  i32.or  m 0xCD i32.ge_u m 0xCF i32.le_u i32.and  i32.or
  m 0xDE i32.eq  i32.or  m 0xDF i32.eq  i32.or  m 0xF0 i32.ge_u m 0xFD i32.le_u i32.and  i32.or
  [ UNSUPPORTED_SOF "lossless, hierarchical or reserved marker" m refusal-n trap ]
  when
  m 0xC4 i32.eq [ j j markers.segment markers.dht  1 done! ] when
  m 0xDB i32.eq [ j j markers.segment markers.dqt  1 done! ] when
  m 0xDD i32.eq [ j j markers.segment markers.dri  1 done! ] when
  m 0xCC i32.eq [ j markers.segment 2drop  1 done! ] when
  m 0xE0 i32.eq [ j j markers.segment markers.app0  1 done! ] when
  m 0xEE i32.eq [ j j markers.segment markers.app14  1 done! ] when
  m 0xE1 i32.ge_u m 0xEF i32.le_u i32.and  m 0xEE i32.ne i32.and  m 0xFE i32.eq  i32.or
  [ j markers.segment 2drop  1 done! ]
  when
  m 0xDA i32.eq [ j j markers.segment markers.sos  1 done! ] when
  done i32.eqz [ UNSUPPORTED_SOF "unexpected marker" m refusal-n trap ] when ;

: markers.next-scan ( jpeg -- i32 )
  :> j
  option.none ( option scan ) :> none
  j none jpeg.scan!
  [ j markers.has-scan? j jpeg.eoi i32.or i32.eqz ] [ j markers.step ] while
  j markers.has-scan? ;

: markers.walk ( jpeg -- )
  :> j
  j markers.soi
  [ j markers.has-scan? i32.eqz ] [ j markers.step ] while ;

# The FRAME line main prints, once the walk has found the frame.
: markers.frame-line ( jpeg -- str )  jpeg.frame none: [ "FRAME none" ] some: [ frame.describe ] match ;
test markers.frame-line : fx.ready markers.frame-line -> "FRAME 1 1 1 192"

# n copies of the fixture's SOS header parsed in turn.
: fx.sos-times ( i32 -- jpeg )
  :> n
  fx.ready :> j
  n [ drop j 150 6 markers.sos ] times
  j ;
test markers.sos : 256 fx.sos-times jpeg.scans -> 256
test markers.sos : 1 fx.sos-times jpeg.scans -> 1
test markers.sos : 257 fx.sos-times -> trap

# Two scans of the fixture: the second SOS's FF at 157, its data at 167, the
# EOI at 168.
: fx.two-scans ( -- str )
  fx.head fx.sos str.concat "3F" str.concat "FFDA0008010100003F00" str.concat "3F" str.concat "FFD9" str.concat ;
: fx.between ( str -- jpeg )
  :> mid
  fx.head fx.sos str.concat "3F" str.concat mid str.concat "FFDA0008010100003F00" str.concat "3FFFD9" str.concat
  hex markers.open dup markers.walk ;
test fx.two-scans : fx.two-scans hex bytes.len -> 170
test markers.next-scan : fx.two-scans hex markers.open dup markers.walk dup 157 jpeg.pos! markers.next-scan -> 1
test markers.next-scan : fx.two-scans hex markers.open dup markers.walk dup 157 jpeg.pos! dup markers.next-scan drop markers.scan-data -> 167
test markers.next-scan : fx.two-scans hex markers.open dup markers.walk dup 157 jpeg.pos! dup markers.next-scan drop jpeg.scans -> 2
test markers.next-scan : fx.two-scans hex markers.open dup markers.walk dup 168 jpeg.pos! markers.next-scan -> 0
test markers.next-scan : fx.two-scans hex markers.open dup markers.walk dup 168 jpeg.pos! dup markers.next-scan drop jpeg.eoi -> 1
test markers.next-scan : fx.two-scans hex markers.open dup markers.walk dup 168 jpeg.pos! dup markers.next-scan drop markers.has-scan? -> 0
test markers.next-scan : fx.dht-dc fx.between dup 157 jpeg.pos! dup markers.next-scan drop markers.scan-data -> 189
test markers.next-scan : fx.sof "FFD9" str.concat fx.between dup 157 jpeg.pos! markers.next-scan -> trap
test markers.next-scan : "FFD8" fx.between dup 157 jpeg.pos! markers.next-scan -> trap
test markers.next-scan : "FFD0" fx.between dup 157 jpeg.pos! markers.next-scan -> trap
