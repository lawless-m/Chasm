# Tables shared by the IDCT and the scan layer.
#
# - natural: libjpeg's jpeg_natural_order, the position in the 8x8 block (row
#   major) of the k-th coefficient in zigzag order, with 16 extra entries of 63
#   (libjpeg's safety entries). The scan layer places coefficients with
#   natural[k].
# - limit: libjpeg's post-IDCT range-limit table, 1024 entries indexed by
#   `x & 1023` where x is the descaled IDCT output before the +128 centring:
#   0..127 give x + 128, 128..511 give 255, 512..895 give 0, 896..1023 give
#   x - 896, so out-of-range values clamp without a branch and wild ones wrap
#   exactly as libjpeg's RANGE_MASK does.
# - ws: the IDCT's 64-entry workspace, reused for every block.
#
# The IDCT dequantises in natural order, so idct.quant turns a table that
# markers.dqt stored in zigzag order into natural order, as libjpeg's get_dqt.

struct idct  natural: array i32  limit: array i32  ws: array i32

declare idct.make ( -- idct )
test idct.make : idct.make idct.natural array.len -> 80
test idct.make : idct.make idct.natural 0 array.at -> 0
test idct.make : idct.make idct.natural 1 array.at -> 1
test idct.make : idct.make idct.natural 2 array.at -> 8
test idct.make : idct.make idct.natural 3 array.at -> 16
test idct.make : idct.make idct.natural 16 array.at -> 12
test idct.make : idct.make idct.natural 17 array.at -> 19
test idct.make : idct.make idct.natural 32 array.at -> 35
test idct.make : idct.make idct.natural 48 array.at -> 58
test idct.make : idct.make idct.natural 63 array.at -> 63
test idct.make : idct.make idct.natural 64 array.at -> 63
test idct.make : idct.make idct.natural 79 array.at -> 63
test idct.make : idct.make idct.limit array.len -> 1024
test idct.make : idct.make idct.limit 0 array.at -> 128
test idct.make : idct.make idct.limit 127 array.at -> 255
test idct.make : idct.make idct.limit 128 array.at -> 255
test idct.make : idct.make idct.limit 511 array.at -> 255
test idct.make : idct.make idct.limit 512 array.at -> 0
test idct.make : idct.make idct.limit 895 array.at -> 0
test idct.make : idct.make idct.limit 896 array.at -> 0
test idct.make : idct.make idct.limit 1023 array.at -> 127
test idct.make : idct.make idct.ws array.len -> 64

# The jpeg and a table index tq: a fresh 64-entry table in natural order.
declare idct.quant ( jpeg i32 -- array i32 )
test idct.quant : fx.ready 0 idct.quant array.len -> 64
test idct.quant : fx.ready 0 idct.quant 0 array.at -> 16
test idct.quant : fx.ready 0 idct.quant 1 array.at -> 11
test idct.quant : fx.ready 0 idct.quant 2 array.at -> 10
test idct.quant : fx.ready 0 idct.quant 8 array.at -> 12
test idct.quant : fx.ready 0 idct.quant 9 array.at -> 12
test idct.quant : fx.ready 0 idct.quant 16 array.at -> 14
test idct.quant : fx.ready 0 idct.quant 63 array.at -> 99
test idct.quant : fx.ready 0 idct.quant 7 array.at -> 61
test idct.quant : fx.ready 0 idct.quant 56 array.at -> 72

: idct.make ( -- idct )
  "000108100902030a11182019120b04050c131a21283029221b140d06070e151c232a313839322b241d160f171e252c333a3b342d261f272e353c3d362f373e3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f" hex :> order
  80 array.new ( array i32 ) :> nat
  80 [ :> i  nat i  order i bytes.at  array.at! ] times
  1024 array.new ( array i32 ) :> lim
  1024
  [
    :> j
    lim j
    j 128 i32.lt_s
    [ j 128 i32.add ]
    [ j 512 i32.lt_s [ 255 ] [ j 896 i32.lt_s [ 0 ] [ j 896 i32.sub ] if ] if ]
    if
    array.at!
  ]
  times
  64 array.new ( array i32 ) :> ws
  nat lim ws idct.new ;

: idct.quant ( jpeg i32 -- array i32 )
  :> tq :> j
  idct.make idct.natural :> nat
  64 array.new ( array i32 ) :> q
  64 [ :> k  q  nat k array.at  j jpeg.qt tq 64 i32.mul k i32.add array.at  array.at! ] times
  q ;

# libjpeg's jpeg_idct_islow (jidctint.c) for 8-bit samples, dequantising as
# it goes: the tables, the coefficient block (64, natural order), the
# quantisation tables and the offset of this component's 64 natural-order
# entries in them, the destination, the offset of the block's top-left
# sample and the row stride. What libjpeg holds in JLONG is i64 here and
# what it holds in int is i32, with the same (int) wraps, so hostile
# coefficients with 16-bit quantisation tables overflow identically. The
# multipliers are int, as in the oracle (built without SIMD; a SIMD build
# keeps them in short).
declare idct.block ( idct array i32 array i32 i32 bytes i32 i32 -- )

# DESCALE(x, n): x rounded and shifted right n bits, then (int).
: idct.descale ( i64 i32 -- i32 )
  :> n :> x
  x  1 i64 n 1 i32.sub i64 i64.shl  i64.add  n i64 i64.shr_s  i32.wrap_i64 ;

# Coefficient i of the block, dequantised by entry qoff + i (an int
# multiply, as libjpeg's DEQUANTIZE), widened.
: idct.dq ( array i32 array i32 i32 i32 -- i64 )
  :> i :> qoff :> quant :> coef
  coef i array.at  quant qoff i i32.add array.at  i32.mul i64 ;

# One 1-D pass, shared by columns and rows: eight inputs in order 0..7,
# eight undescaled outputs in order 0..7.
: idct.1d ( i64 i64 i64 i64 i64 i64 i64 i64 -- i64 i64 i64 i64 i64 i64 i64 i64 )
  :> v7 :> v6 :> v5 :> v4 :> v3 :> v2 :> v1 :> v0
  v2 v6 i64.add 4433 i64 i64.mul :> e1
  e1  v6 -15137 i64 i64.mul  i64.add :> e2
  e1  v2 6270 i64 i64.mul  i64.add :> e3
  v0 v4 i64.add 13 i64 i64.shl :> e0
  v0 v4 i64.sub 13 i64 i64.shl :> e4
  e0 e3 i64.add :> t10
  e0 e3 i64.sub :> t13
  e4 e2 i64.add :> t11
  e4 e2 i64.sub :> t12
  v7 v1 i64.add :> z1
  v5 v3 i64.add :> z2
  v7 v3 i64.add :> z3
  v5 v1 i64.add :> z4
  z3 z4 i64.add 9633 i64 i64.mul :> z5
  z3 -16069 i64 i64.mul z5 i64.add :> z3b
  z4 -3196 i64 i64.mul z5 i64.add :> z4b
  z1 -7373 i64 i64.mul :> z1b
  z2 -20995 i64 i64.mul :> z2b
  v7 2446 i64 i64.mul  z1b z3b i64.add  i64.add :> o0
  v5 16819 i64 i64.mul  z2b z4b i64.add  i64.add :> o1
  v3 25172 i64 i64.mul  z2b z3b i64.add  i64.add :> o2
  v1 12299 i64 i64.mul  z1b z4b i64.add  i64.add :> o3
  t10 o3 i64.add
  t11 o2 i64.add
  t12 o1 i64.add
  t13 o0 i64.add
  t13 o0 i64.sub
  t12 o1 i64.sub
  t11 o2 i64.sub
  t10 o3 i64.sub ;

: idct.block ( idct array i32 array i32 i32 bytes i32 i32 -- )
  :> stride :> off :> dst :> qoff :> quant :> coef :> t
  t idct.ws :> ws
  t idct.limit :> lim
  # Pass 1: columns, into the workspace.
  8
  [
    :> c
    coef 8 c i32.add array.at  coef 16 c i32.add array.at  i32.or
    coef 24 c i32.add array.at i32.or  coef 32 c i32.add array.at i32.or
    coef 40 c i32.add array.at i32.or  coef 48 c i32.add array.at i32.or
    coef 56 c i32.add array.at i32.or
    i32.eqz
    [
      coef c array.at  quant qoff c i32.add array.at  i32.mul 2 i32.shl :> dc
      8 [ :> r0  ws  r0 8 i32.mul c i32.add  dc  array.at! ] times
    ]
    [
      coef quant qoff c idct.dq  coef quant qoff c 8 i32.add idct.dq
      coef quant qoff c 16 i32.add idct.dq  coef quant qoff c 24 i32.add idct.dq
      coef quant qoff c 32 i32.add idct.dq  coef quant qoff c 40 i32.add idct.dq
      coef quant qoff c 48 i32.add idct.dq  coef quant qoff c 56 i32.add idct.dq
      idct.1d
      :> p7 :> p6 :> p5 :> p4 :> p3 :> p2 :> p1 :> p0
      ws c p0 11 idct.descale array.at!
      ws c 8 i32.add p1 11 idct.descale array.at!
      ws c 16 i32.add p2 11 idct.descale array.at!
      ws c 24 i32.add p3 11 idct.descale array.at!
      ws c 32 i32.add p4 11 idct.descale array.at!
      ws c 40 i32.add p5 11 idct.descale array.at!
      ws c 48 i32.add p6 11 idct.descale array.at!
      ws c 56 i32.add p7 11 idct.descale array.at!
    ]
    if
  ]
  times
  # Pass 2: rows, through the range-limit table into the destination.
  8
  [
    :> r
    r 8 i32.mul :> b
    ws b 1 i32.add array.at  ws b 2 i32.add array.at  i32.or
    ws b 3 i32.add array.at i32.or  ws b 4 i32.add array.at i32.or
    ws b 5 i32.add array.at i32.or  ws b 6 i32.add array.at i32.or
    ws b 7 i32.add array.at i32.or
    off r stride i32.mul i32.add :> row
    i32.eqz
    [
      lim  ws b array.at i64 5 idct.descale 1023 i32.and  array.at :> v
      8 [ :> x0  dst row x0 i32.add v bytes.at! ] times
    ]
    [
      ws b array.at i64  ws b 1 i32.add array.at i64  ws b 2 i32.add array.at i64  ws b 3 i32.add array.at i64
      ws b 4 i32.add array.at i64  ws b 5 i32.add array.at i64  ws b 6 i32.add array.at i64  ws b 7 i32.add array.at i64
      idct.1d
      :> q7 :> q6 :> q5 :> q4 :> q3 :> q2 :> q1 :> q0
      dst row  lim q0 18 idct.descale 1023 i32.and array.at  bytes.at!
      dst row 1 i32.add  lim q1 18 idct.descale 1023 i32.and array.at  bytes.at!
      dst row 2 i32.add  lim q2 18 idct.descale 1023 i32.and array.at  bytes.at!
      dst row 3 i32.add  lim q3 18 idct.descale 1023 i32.and array.at  bytes.at!
      dst row 4 i32.add  lim q4 18 idct.descale 1023 i32.and array.at  bytes.at!
      dst row 5 i32.add  lim q5 18 idct.descale 1023 i32.and array.at  bytes.at!
      dst row 6 i32.add  lim q6 18 idct.descale 1023 i32.and array.at  bytes.at!
      dst row 7 i32.add  lim q7 18 idct.descale 1023 i32.and array.at  bytes.at!
    ]
    if
  ]
  times ;

# Test fixtures: blocks and a runner (qoff 0, a 64-byte destination with
# stride 8).
: fx.zeros ( -- array i32 )  64 array.new ( array i32 ) ;
: fx.ones ( -- array i32 )
  64 array.new ( array i32 ) :> a
  64 [ :> i  a i 1 array.at! ] times
  a ;
: fx.run ( array i32 array i32 -- bytes )
  :> q :> c
  64 bytes.new :> d
  idct.make c q 0 d 0 8 idct.block
  d ;
: fx.dc ( i32 -- bytes )
  :> v
  fx.zeros :> c
  c 0 v array.at!
  c fx.ones fx.run ;
: fx.full ( -- array i32 )
  fx.zeros :> c
  c 0 -40 array.at!  c 1 30 array.at!  c 8 -20 array.at!  c 2 10 array.at!
  c 9 5 array.at!  c 16 -7 array.at!  c 63 3 array.at!
  c ;
: fx.ac1 ( -- bytes )
  fx.zeros :> c
  c 1 100 array.at!
  c fx.ones fx.run ;
: fx.big ( -- bytes )
  fx.zeros :> c
  c 0 2047 array.at!  c 1 2047 array.at!
  64 array.new ( array i32 ) :> q
  64 [ :> i  q i 65535 array.at! ] times
  c q fx.run ;
# coef [0] = 8, quant ones, into a 256-byte destination at offset 8, stride 16.
: fx.placed ( -- bytes )
  fx.zeros :> c
  c 0 8 array.at!
  256 bytes.new :> d
  idct.make c fx.ones 0 d 8 16 idct.block
  d ;
# A 128-entry quant array, zeros then ones, used at qoff 64.
: fx.qoff ( -- bytes )
  fx.zeros :> c
  c 0 8 array.at!
  128 array.new ( array i32 ) :> q
  64 [ :> i  q i 64 i32.add 1 array.at! ] times
  64 bytes.new :> d
  idct.make c q 64 d 0 8 idct.block
  d ;

test idct.block : 0 fx.dc 0 bytes.at -> 128
test idct.block : 8 fx.dc 0 bytes.at -> 129
test idct.block : 8 fx.dc 63 bytes.at -> 129
test idct.block : -8 fx.dc 5 bytes.at -> 127
test idct.block : 1016 fx.dc 0 bytes.at -> 255
test idct.block : 1023 fx.dc 0 bytes.at -> 255
test idct.block : 1024 fx.dc 0 bytes.at -> 255
test idct.block : -1024 fx.dc 0 bytes.at -> 0
test idct.block : 2048 fx.dc 0 bytes.at -> 255
test idct.block : 4096 fx.dc 0 bytes.at -> 0
test idct.block : fx.full fx.ones fx.run 0 bytes.at -> 126
test idct.block : fx.full fx.ones fx.run 1 bytes.at -> 124
test idct.block : fx.full fx.ones fx.run 7 bytes.at -> 114
test idct.block : fx.full fx.ones fx.run 8 bytes.at -> 127
test idct.block : fx.full fx.ones fx.run 27 bytes.at -> 124
test idct.block : fx.full fx.ones fx.run 36 bytes.at -> 123
test idct.block : fx.full fx.ones fx.run 56 bytes.at -> 131
test idct.block : fx.full fx.ones fx.run 63 bytes.at -> 123
test idct.block : fx.full fx.ready 0 idct.quant fx.run 0 bytes.at -> 81
test idct.block : fx.full fx.ready 0 idct.quant fx.run 3 bytes.at -> 0
test idct.block : fx.full fx.ready 0 idct.quant fx.run 9 bytes.at -> 95
test idct.block : fx.full fx.ready 0 idct.quant fx.run 25 bytes.at -> 154
test idct.block : fx.full fx.ready 0 idct.quant fx.run 32 bytes.at -> 157
test idct.block : fx.full fx.ready 0 idct.quant fx.run 63 bytes.at -> 50
test idct.block : fx.ac1 0 bytes.at -> 145
test idct.block : fx.ac1 7 bytes.at -> 111
test idct.block : fx.ac1 57 bytes.at -> 143
test idct.block : fx.big 0 bytes.at -> 255
test idct.block : fx.big 1 bytes.at -> 178
test idct.block : fx.big 4 bytes.at -> 155
test idct.block : fx.placed 8 bytes.at -> 129
test idct.block : fx.placed 0 bytes.at -> 0
test idct.block : fx.placed 127 bytes.at -> 129
test idct.block : fx.placed 128 bytes.at -> 0
test idct.block : fx.placed 15 bytes.at -> 129
test idct.block : fx.placed 16 bytes.at -> 0
test idct.block : fx.qoff 0 bytes.at -> 129
