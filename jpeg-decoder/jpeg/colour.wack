: colour.ink ( i32 i32 -- i32 )
  :> k :> c
  c k i32.mul 1 i32.shl 255 i32.add 510 i32.div_u ;

: colour.ink12 ( i32 i32 -- i32 )
  :> k :> c
  c k i32.mul 1 i32.shl 4095 i32.add 8190 i32.div_u ;

: colour.ycck ( colour i32 i32 i32 i32 -- i32 i32 i32 )
  :> k :> cr :> cb :> y :> t
  t y cb cr colour.ycc :> b :> g :> r
  255 r i32.sub k colour.ink
  255 g i32.sub k colour.ink
  255 b i32.sub k colour.ink ;

: colour.ycck12 ( colour i32 i32 i32 i32 -- i32 i32 i32 )
  :> k :> cr :> cb :> y :> t
  t y cb cr colour.ycc12 :> b :> g :> r
  4095 r i32.sub k colour.ink12
  4095 g i32.sub k colour.ink12
  4095 b i32.sub k colour.ink12 ;

test colour.ink : 255 255 colour.ink -> 255
test colour.ink : 0 255 colour.ink -> 0
test colour.ink : 255 0 colour.ink -> 0
test colour.ink : 128 128 colour.ink -> 64
test colour.ink : 200 20 colour.ink -> 16
test colour.ink : 30 20 colour.ink -> 2
test colour.ink : 60 20 colour.ink -> 5
test colour.ink : 127 255 colour.ink -> 127
test colour.ink : 179 255 colour.ink -> 179
