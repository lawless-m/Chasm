# Colour: libjpeg's colour-space decision and its fixed-point YCbCr to RGB
# conversion (build_ycc_rgb_table in jdcolor.c, SCALEBITS 16, ONE_HALF 32768).
#
# Spaces: 0 greyscale, 1 YCbCr, 2 RGB, 3 four components (CMYK or YCCK,
# M7). The tables hold, for x = i - 128: cr-r FIX(1.40200) x, cb-b FIX(1.77200)
# x, both rounded and descaled; cr-g -FIX(0.71414) x and cb-g -FIX(0.34414) x
# + ONE_HALF, descaled together per pixel.

struct colour  cr-r: array i32  cb-b: array i32  cr-g: array i32  cb-g: array i32

declare colour.make ( -- colour )
test colour.make : colour.make colour.cr-r 0 array.at -> -179
test colour.make : colour.make colour.cr-r 127 array.at -> -1
test colour.make : colour.make colour.cr-r 128 array.at -> 0
test colour.make : colour.make colour.cr-r 255 array.at -> 178
test colour.make : colour.make colour.cb-b 0 array.at -> -227
test colour.make : colour.make colour.cb-b 255 array.at -> 225
test colour.make : colour.make colour.cr-g 0 array.at -> 5990656
test colour.make : colour.make colour.cr-g 128 array.at -> 0
test colour.make : colour.make colour.cr-g 255 array.at -> -5943854
test colour.make : colour.make colour.cb-g 128 array.at -> 32768
test colour.make : colour.make colour.cb-g 0 array.at -> 2919680

# To 0..255. This is libjpeg's range_limit here: y + cr-r lies in -179..433,
# y + cb-b in -227..480 and the green sum in -135..390, all inside the part
# of its sample_range_limit table that clamps plainly.
declare colour.clamp ( i32 -- i32 )
test colour.clamp : -5 colour.clamp -> 0
test colour.clamp : 300 colour.clamp -> 255
test colour.clamp : 77 colour.clamp -> 77

# y cb cr to r g b.
declare colour.ycc ( colour i32 i32 i32 -- i32 i32 i32 )
test colour.ycc : colour.make 128 128 128 colour.ycc -> 128 128 128
test colour.ycc : colour.make 255 0 0 colour.ycc -> 76 255 28
test colour.ycc : colour.make 0 255 255 colour.ycc -> 178 0 225
test colour.ycc : colour.make 0 0 0 colour.ycc -> 0 135 0
test colour.ycc : colour.make 255 255 255 colour.ycc -> 255 121 255
test colour.ycc : colour.make 100 50 200 colour.ycc -> 201 75 0
test colour.ycc : colour.make 200 210 90 colour.ycc -> 147 199 255
test colour.ycc : colour.make 76 85 255 colour.ycc -> 254 0 0
test colour.ycc : colour.make 16 128 128 colour.ycc -> 16 16 16
test colour.ycc : colour.make 235 128 128 colour.ycc -> 235 235 235

# libjpeg's default_decompress_parms: 1 component greyscale; 3 components
# YCbCr when JFIF, else by the Adobe transform (0 is RGB, anything else
# YCbCr), else RGB only for component ids 'R' 'G' 'B'; 4 components space 3.
# Any other count has no colour space (djpeg fails too): BAD_COMPONENT.
declare colour.space ( jpeg -- i32 )

# The tables, the space (0, 1 or 2), the upsampled buffer (ncomp blocks of
# rows x width samples), rows per component block, the row r, the output
# row and the width.
declare colour.row ( colour i32 bytes i32 i32 bytes i32 -- )

# The 12-bit counterparts of the words above (libjpeg's 12-bit build of
# jdcolor.c: build_ycc_rgb_table with _MAXJSAMPLE 4095 and _CENTERJSAMPLE
# 2048). They are separate words because a 12-bit frame's upsampled samples
# are an array i32, its output row holds two big-endian bytes a sample and
# its tables have 4096 entries; the 8-bit words keep their bytes and their
# speed.
declare colour.make12 ( -- colour )
declare colour.clamp12 ( i32 -- i32 )
declare colour.ycc12 ( colour i32 i32 i32 -- i32 i32 i32 )

# As colour.row, from an array i32 of 12-bit samples into an output row of
# width x ncomp x 2 bytes, each sample high byte first (wrppm.c's
# PUTPPMSAMPLE for maxval 4095).
declare colour.row12 ( colour i32 array i32 i32 i32 bytes i32 -- )

: colour.make ( -- colour )
  256 array.new ( array i32 ) :> crr
  256 array.new ( array i32 ) :> cbb
  256 array.new ( array i32 ) :> crg
  256 array.new ( array i32 ) :> cbg
  256
  [
    :> i
    i 128 i32.sub :> x
    crr i  91881 x i32.mul 32768 i32.add 16 i32.shr_s  array.at!
    cbb i  116130 x i32.mul 32768 i32.add 16 i32.shr_s  array.at!
    crg i  -46802 x i32.mul  array.at!
    cbg i  -22554 x i32.mul 32768 i32.add  array.at!
  ]
  times
  crr cbb crg cbg colour.new ;

: colour.clamp ( i32 -- i32 )
  dup 0 i32.lt_s [ drop 0 ] [ dup 255 i32.gt_s [ drop 255 ] when ] if ;

: colour.ycc ( colour i32 i32 i32 -- i32 i32 i32 )
  :> cr :> cb :> y :> t
  y  t colour.cr-r cr array.at  i32.add colour.clamp
  y  t colour.cb-g cb array.at  t colour.cr-g cr array.at  i32.add 16 i32.shr_s  i32.add colour.clamp
  y  t colour.cb-b cb array.at  i32.add colour.clamp ;

: colour.space ( jpeg -- i32 )
  :> j
  j jpeg.frame none: [ NO_FRAME "colour space before SOF" refusal trap ] some: [ ] match :> f
  f frame.ncomp :> n
  f frame.comps :> cs
  n 1 i32.eq
  [ 0 ]
  [
    n 3 i32.eq
    [
      j jpeg.jfif
      [ 1 ]
      [
        j jpeg.adobe
        [ j jpeg.transform [ 1 ] [ 2 ] if ]
        [
          cs 0 array.at component.id 82 i32.eq  cs 1 array.at component.id 71 i32.eq  i32.and
          cs 2 array.at component.id 66 i32.eq  i32.and
          [ 2 ] [ 1 ] if
        ]
        if
      ]
      if
    ]
    [
      n 4 i32.eq
      [ 3 ]
      [ BAD_COMPONENT "no colour space for component count" n refusal-n trap ]
      if
    ]
    if
  ]
  if ;

: colour.row ( colour i32 bytes i32 i32 bytes i32 -- )
  :> width :> out :> r :> rows :> ups :> space :> t
  rows width i32.mul :> block
  r width i32.mul :> at
  space 0 i32.eq
  [ width [ :> x0  out x0  ups at x0 i32.add bytes.at  bytes.at! ] times ]
  [
    space 1 i32.eq
    [
      width
      [
        :> x1
        at x1 i32.add :> p
        t  ups p bytes.at  ups block p i32.add bytes.at  ups block 2 i32.mul p i32.add bytes.at  colour.ycc
        :> bl :> gr :> rd
        x1 3 i32.mul :> o
        out o rd bytes.at!
        out o 1 i32.add gr bytes.at!
        out o 2 i32.add bl bytes.at!
      ]
      times
    ]
    [
      width
      [
        :> x2
        at x2 i32.add :> q
        x2 3 i32.mul :> o2
        out o2  ups q bytes.at  bytes.at!
        out o2 1 i32.add  ups block q i32.add bytes.at  bytes.at!
        out o2 2 i32.add  ups block 2 i32.mul q i32.add bytes.at  bytes.at!
      ]
      times
    ]
    if
  ]
  if ;

# Test fixtures: a jpeg with a 3-component 8x8 frame of ids a b c, the JFIF
# flag and an Adobe transform (-1 for no Adobe marker); a jpeg whose frame
# has n components; and a colour.row run into a fresh output row.
: fx.jpeg-ids ( i32 i32 i32 i32 i32 -- jpeg )
  :> tr :> jf :> c :> b :> a
  3 array.new ( array component ) :> cs
  cs 0  a 1 1 0 component.new  array.at!
  cs 1  b 1 1 0 component.new  array.at!
  cs 2  c 1 1 0 component.new  array.at!
  "FFD8" hex markers.open :> j
  j  0xC0 8 8 8 3 cs frame.new option.some  jpeg.frame!
  j jf jpeg.jfif!
  tr 0 i32.ge_s [ j 1 jpeg.adobe!  j tr jpeg.transform! ] when
  j ;
: fx.jpeg-n ( i32 -- jpeg )
  :> n
  "FFD8" hex markers.open :> j
  j  n fx.ncomp option.some  jpeg.frame!
  j ;
: fx.row ( i32 str i32 i32 i32 -- bytes )
  :> width :> r :> rows :> h :> space
  width  space [ 3 ] [ 1 ] if  i32.mul bytes.new :> out
  colour.make space h hex rows r out width colour.row
  out ;

test colour.space : 1 fx.jpeg-n colour.space -> 0
test colour.space : 1 2 3 1 -1 fx.jpeg-ids colour.space -> 1
test colour.space : 1 2 3 0 -1 fx.jpeg-ids colour.space -> 1
test colour.space : 82 71 66 0 -1 fx.jpeg-ids colour.space -> 2
test colour.space : 82 71 66 1 -1 fx.jpeg-ids colour.space -> 1
test colour.space : 82 71 66 0 1 fx.jpeg-ids colour.space -> 1
test colour.space : 1 2 3 0 0 fx.jpeg-ids colour.space -> 2
test colour.space : 1 2 3 0 1 fx.jpeg-ids colour.space -> 1
test colour.space : 1 2 3 0 2 fx.jpeg-ids colour.space -> 1
test colour.space : 5 6 7 0 -1 fx.jpeg-ids colour.space -> 1
test colour.space : 0 1 2 0 1 fx.jpeg-ids colour.space -> 1
test colour.space : 4 fx.jpeg-n colour.space -> 3
test colour.space : 2 fx.jpeg-n colour.space -> trap
test colour.space : "FFD8" hex markers.open colour.space -> trap
test colour.row : 1 "FF0000" 1 0 1 fx.row 0 bytes.at -> 76
test colour.row : 1 "FF0000" 1 0 1 fx.row 1 bytes.at -> 255
test colour.row : 1 "FF0000" 1 0 1 fx.row 2 bytes.at -> 28
test colour.row : 0 "7F" 1 0 1 fx.row 0 bytes.at -> 127
test colour.row : 2 "0A0B0C" 1 0 1 fx.row 1 bytes.at -> 11
test colour.row : 0 "01020304" 2 1 2 fx.row 0 bytes.at -> 3
test colour.row : 0 "01020304" 2 1 2 fx.row 1 bytes.at -> 4
test colour.row : 1 "80 80 80 80 80 80 80 80 80 80 80 80" 2 1 2 fx.row 5 bytes.at -> 128
test colour.row : 2 "0102 0304 0506" 1 0 2 fx.row 4 bytes.at -> 4
test colour.row : 2 "0102 0304 0506" 1 0 2 fx.row 5 bytes.at -> 6

: colour.make12 ( -- colour )
  4096 array.new ( array i32 ) :> crr
  4096 array.new ( array i32 ) :> cbb
  4096 array.new ( array i32 ) :> crg
  4096 array.new ( array i32 ) :> cbg
  4096
  [
    :> i
    i 2048 i32.sub :> x
    crr i  91881 x i32.mul 32768 i32.add 16 i32.shr_s  array.at!
    cbb i  116130 x i32.mul 32768 i32.add 16 i32.shr_s  array.at!
    crg i  -46802 x i32.mul  array.at!
    cbg i  -22554 x i32.mul 32768 i32.add  array.at!
  ]
  times
  crr cbb crg cbg colour.new ;

: colour.clamp12 ( i32 -- i32 )
  dup 0 i32.lt_s [ drop 0 ] [ dup 4095 i32.gt_s [ drop 4095 ] when ] if ;

: colour.ycc12 ( colour i32 i32 i32 -- i32 i32 i32 )
  :> cr :> cb :> y :> t
  y  t colour.cr-r cr array.at  i32.add colour.clamp12
  y  t colour.cb-g cb array.at  t colour.cr-g cr array.at  i32.add 16 i32.shr_s  i32.add colour.clamp12
  y  t colour.cb-b cb array.at  i32.add colour.clamp12 ;

# One 12-bit sample into the output row at byte o, high byte first.
: colour.put12 ( bytes i32 i32 -- )
  :> v :> o :> out
  out o  v 8 i32.shr_u  bytes.at!
  out o 1 i32.add  v 255 i32.and  bytes.at! ;

: colour.row12 ( colour i32 array i32 i32 i32 bytes i32 -- )
  :> width :> out :> r :> rows :> ups :> space :> t
  rows width i32.mul :> block
  r width i32.mul :> at
  space 0 i32.eq
  [ width [ :> x0  out  x0 2 i32.mul  ups at x0 i32.add array.at  colour.put12 ] times ]
  [
    space 1 i32.eq
    [
      width
      [
        :> x1
        at x1 i32.add :> p
        t  ups p array.at  ups block p i32.add array.at  ups block 2 i32.mul p i32.add array.at  colour.ycc12
        :> bl :> gr :> rd
        x1 6 i32.mul :> o
        out o rd colour.put12
        out o 2 i32.add gr colour.put12
        out o 4 i32.add bl colour.put12
      ]
      times
    ]
    [
      width
      [
        :> x2
        at x2 i32.add :> q
        x2 6 i32.mul :> o2
        out o2  ups q array.at  colour.put12
        out o2 2 i32.add  ups block q i32.add array.at  colour.put12
        out o2 4 i32.add  ups block 2 i32.mul q i32.add array.at  colour.put12
      ]
      times
    ]
    if
  ]
  if ;

# Test fixture: space, a hex string of 16-bit big-endian samples (the
# upsampled buffer), rows, r and width: one 12-bit output row.
: fx.row12 ( i32 str i32 i32 i32 -- bytes )
  :> w :> r :> rows :> h :> space
  h hex :> b
  b bytes.len 2 i32.div_u :> n
  n array.new ( array i32 ) :> ups
  n [ :> i  ups i  b i 2 i32.mul bytes.at 8 i32.shl  b i 2 i32.mul 1 i32.add bytes.at  i32.or  array.at! ] times
  space [ 3 ] [ 1 ] if w i32.mul 2 i32.mul bytes.new :> out
  colour.make12 space ups rows r out w colour.row12
  out ;

test colour.make12 : colour.make12 colour.cr-r array.len -> 4096
test colour.make12 : colour.make12 colour.cr-r 0 array.at -> -2871
test colour.make12 : colour.make12 colour.cr-r 2048 array.at -> 0
test colour.make12 : colour.make12 colour.cr-r 4095 array.at -> 2870
test colour.make12 : colour.make12 colour.cb-b 0 array.at -> -3629
test colour.make12 : colour.make12 colour.cb-b 4095 array.at -> 3627
test colour.make12 : colour.make12 colour.cr-g 0 array.at -> 95850496
test colour.make12 : colour.make12 colour.cr-g 4095 array.at -> -95803694
test colour.make12 : colour.make12 colour.cb-g 2048 array.at -> 32768
test colour.make12 : colour.make12 colour.cb-g 0 array.at -> 46223360
test colour.clamp12 : -5 colour.clamp12 -> 0
test colour.clamp12 : 5000 colour.clamp12 -> 4095
test colour.clamp12 : 777 colour.clamp12 -> 777
test colour.ycc12 : colour.make12 2048 2048 2048 colour.ycc12 -> 2048 2048 2048
test colour.ycc12 : colour.make12 4095 0 0 colour.ycc12 -> 1224 4095 466
test colour.ycc12 : colour.make12 0 4095 4095 colour.ycc12 -> 2870 0 3627
test colour.ycc12 : colour.make12 0 0 0 colour.ycc12 -> 0 2167 0
test colour.ycc12 : colour.make12 4095 4095 4095 colour.ycc12 -> 4095 1929 4095
test colour.ycc12 : colour.make12 1600 800 3200 colour.ycc12 -> 3215 1207 0
test colour.ycc12 : colour.make12 2000 1300 2048 colour.ycc12 -> 2000 2257 675
test colour.ycc12 : colour.make12 256 2048 2048 colour.ycc12 -> 256 256 256
test colour.row12 : 0 "0FFF" 1 0 1 fx.row12 0 bytes.at -> 15
test colour.row12 : 0 "0FFF" 1 0 1 fx.row12 1 bytes.at -> 255
test colour.row12 : 0 "0000" 1 0 1 fx.row12 bytes.len -> 2
test colour.row12 : 0 "0000" 1 0 1 fx.row12 0 bytes.at -> 0
test colour.row12 : 1 "0800 0800 0800" 1 0 1 fx.row12 0 bytes.at -> 8
test colour.row12 : 1 "0800 0800 0800" 1 0 1 fx.row12 1 bytes.at -> 0
test colour.row12 : 1 "0800 0800 0800" 1 0 1 fx.row12 4 bytes.at -> 8
test colour.row12 : 1 "0800 0800 0800" 1 0 1 fx.row12 5 bytes.at -> 0
test colour.row12 : 1 "0FFF 0000 0000" 1 0 1 fx.row12 0 bytes.at -> 4
test colour.row12 : 1 "0FFF 0000 0000" 1 0 1 fx.row12 1 bytes.at -> 200
test colour.row12 : 1 "0FFF 0000 0000" 1 0 1 fx.row12 2 bytes.at -> 15
test colour.row12 : 1 "0FFF 0000 0000" 1 0 1 fx.row12 3 bytes.at -> 255
test colour.row12 : 1 "0FFF 0000 0000" 1 0 1 fx.row12 4 bytes.at -> 1
test colour.row12 : 1 "0FFF 0000 0000" 1 0 1 fx.row12 5 bytes.at -> 210
test colour.row12 : 2 "0102 0304 0506" 1 0 1 fx.row12 0 bytes.at -> 1
test colour.row12 : 2 "0102 0304 0506" 1 0 1 fx.row12 3 bytes.at -> 4
test colour.row12 : 2 "0102 0304 0506" 1 0 1 fx.row12 5 bytes.at -> 6
test colour.row12 : 0 "0001 0002 0003 0004" 2 1 2 fx.row12 1 bytes.at -> 3
test colour.row12 : 0 "0001 0002 0003 0004" 2 1 2 fx.row12 3 bytes.at -> 4
