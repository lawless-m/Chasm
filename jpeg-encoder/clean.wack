# The sanitiser's entry point: JPEG in, JPEG out, in one process, the
# decoder's rows going straight into the encoder (ARCHITECTURE.md, "The two
# programs").
#
# Protocol: stdin gives the input path and the output path (natively
# `/file/<absolute path>`), then option lines until the end of input:
# `quality=Q` (default 85) and `sample=S` (420, 422 or 444, default 420;
# ignored for greyscale); any other line is a trap. stdout gets the
# decoder's `FRAME width height ncomp kind` line, then
# `CLEANED width height orientation icc-bytes`: the output's dimensions,
# the orientation read from the input's Exif (1 when it has none), and the
# length of the ICC profile carried into the output (0 when none). The exit
# status is 0. A refusal is a trap `REFUSED CODE: message` on stderr with
# exit status 1; any other trap is a bug. The output is opened after the
# decoder's setup, so a refusal mid-scan can leave a partial file, which the
# harness ignores.
#
# The steps: the decoder's source.load and markers.walk, so a structural
# refusal before the SOS keeps the decoder's code; then meta.walk over the
# same bytes, so BAD_EXIF, BAD_ICC and LIMIT_ICC (elimits.wack) come before
# any scan or setup refusal; then the decoder's tables and rows.setup, and
# the rows into the encoder. Orientation 1 streams the rows straight into
# the encoder. Any other orientation collects the whole decoded image into
# one buffer (clean.gather), allocated once after rows.setup and before the
# encoder opens, then streams it turned (orient.row-into), a row at a time.
# That buffer is at most MAX_PIXELS x 3 bytes, 240 MB; with the input (at
# most 64 MB), the decoder's own buffers (an MCU-row ring a component and
# about 8 MB more) and the encoder's (one iMCU row), the total stays inside
# MEM_BUDGET for every frame the decoder accepts. The CLEANED dimensions are
# the output's, after the turn. The input's profile is carried only when its
# colour space is RGB for a colour output or GRAY for a greyscale one; any
# other valid profile is dropped, with no refusal.
#
# The program is the shared files (../jpeg-shared/: limits, refuse,
# fixtures, dct, out), the decoder's jpeg files unchanged, in its own order
# (source, frame, coeffs, markers, bits, huffman, idct, scan, arith,
# progressive, upsample, colour, ppm, rows), then the encoder's (elimits to
# options), orient.wack, meta.wack, then this file.

# A decoded row as rows.decode hands it out, the encoder, the rescale table
# and the 8-bit row buffer. An 8-bit frame passes an empty table and buffer
# and its row goes to encoder.row as it is; a 12-bit frame's row (two bytes
# a sample, big-endian) is narrowed into the buffer through rdppm.c's table
# (ppmread.narrow-into) and the buffer goes to encoder.row. The row comes
# first so main's quotation is `[ ( bytes -- ) e tab buf clean.row ]` with
# no shuffling; the table and buffer are allocated once by main, so this
# word allocates nothing.
declare clean.row ( bytes encoder bytes bytes -- )

# A wide flag and the hex of one 1x1 row: the row through clean.row into a
# 1x1 4:2:0 encoder at q50, finished; the whole file.
: fx.clean-row ( i32 str -- bytes )
  :> img :> wide
  wide [ 4095 ppmread.rescale ] [ 0 bytes.new ] if :> tab
  wide [ 3 bytes.new ] [ 0 bytes.new ] if :> buf
  1 1 2 2 50 fx.enc3 :> e
  img hex e tab buf clean.row
  e encoder.finish
  e encoder.o fx.taken ;

test clean.row : 0 "ff0000" fx.clean-row fx.ref-red-q50-420 hex eq -> 1
test clean.row : 1 "0fff00000000" fx.clean-row fx.ref-red-q50-420 hex eq -> 1
test clean.row : 1 "0fff0000" fx.clean-row -> trap
test clean.row : 0 "ff00" fx.clean-row -> trap

: clean.row ( bytes encoder bytes bytes -- )
  :> buf :> tab :> e :> row
  tab bytes.len 0 i32.eq
  [ e row encoder.row ]
  [
    row tab buf ppmread.narrow-into
    e buf encoder.row
  ]
  if ;

# The collected image: its buffer, the 8-bit row length (width x n), the
# rows received so far, and the 12-bit rescale table (empty for 8 bits).
struct gather  buf: bytes  rb: i32  rows: i32  tab: bytes

# A row as rows.decode hands it out, and the gather: the row copied into
# the image at rows x rb (a 12-bit row narrowed straight into that view),
# then counted. A row past the image's height is a plain trap. Allocates
# nothing but the view.
declare clean.gather ( bytes gather -- )

# A wide flag and the hex of two 1x1 RGB rows laid end to end (3 bytes a
# row, or 6 when wide): a 1x2 image gathered from both rows.
: fx.gather ( i32 str -- bytes )
  :> img :> wide
  img hex :> rows
  wide [ 6 ] [ 3 ] if :> rl
  6 bytes.new :> buf
  buf 3 0  wide [ 4095 ppmread.rescale ] [ 0 bytes.new ] if  gather.new :> g
  rows 0 rl bytes.slice g clean.gather
  rows rl rl bytes.slice g clean.gather
  buf ;

test clean.gather : 0 "ff000000ff00" fx.gather "ff000000ff00" hex eq -> 1
test clean.gather : 1 "0fff00000000000000000fff" fx.gather "ff00000000ff" hex eq -> 1
test clean.gather : 0 "ff0000" fx.gather -> trap

: clean.gather ( bytes gather -- )
  :> g :> row
  g gather.rb :> rb
  g gather.rows rb i32.mul :> off
  off rb i32.add  g gather.buf bytes.len  i32.gt_s [ "row past the image" trap ] when
  g gather.tab bytes.len 0 i32.eq
  [ g gather.buf off  row bytes.as-str  bytes.put ]
  [ row  g gather.tab  g gather.buf off rb bytes.slice  ppmread.narrow-into ]
  if
  g  g gather.rows 1 i32.add  gather.rows! ;

: main ( -- )
  read-line drop :> inp
  read-line drop :> outp
  85 :> quality!
  420 :> sample!
  1 :> more!
  [ more ]
  [
    read-line more!
    :> line
    more
    [
      line "icc=" options.prefix? [ "unknown option" trap ] when
      quality line options.quality quality!
      sample line options.sample sample!
    ]
    when
  ]
  while
  inp source.load :> data
  data markers.open :> j
  j markers.walk
  data meta.walk :> m
  j huffman.scan-tables :> tabs
  j markers.frame-line println
  j tabs 1 rows.setup :> d
  d decoder.width :> width
  d decoder.height :> height
  d decoder.ncomp 4 i32.eq [ 3 ] [ d decoder.ncomp ] if :> n
  d decoder.wide :> wide
  wide [ 4095 ppmread.rescale ] [ 0 bytes.new ] if :> tab
  wide [ width n i32.mul bytes.new ] [ 0 bytes.new ] if :> buf
  m meta.icc bytes.len 0 i32.gt_s [ m meta.icc n meta.icc-space? ] [ 0 ] if :> carry
  carry [ m meta.icc ] [ 0 bytes.new ] if :> prof
  m meta.orientation :> o
  o width height orient.dims :> oh :> ow
  o 1 i32.eq
  [
    outp width height n quality sample prof encoder.open-with :> e
    d [ ( bytes -- ) e tab buf clean.row ] rows.decode
    e encoder.close
  ]
  [
    width height i32.mul n i32.mul bytes.new :> img
    img  width n i32.mul  0 tab gather.new :> g
    d [ ( bytes -- ) g clean.gather ] rows.decode
    outp ow oh n quality sample prof encoder.open-with :> e2
    ow n i32.mul bytes.new :> row
    oh [ :> y  img width height n o row y orient.row-into  e2 row encoder.row ] times
    e2 encoder.close
  ]
  if
  "CLEANED " ow i32.to-str str.concat " " str.concat oh i32.to-str str.concat
  " " str.concat  m meta.orientation i32.to-str str.concat
  " " str.concat  prof bytes.len i32.to-str str.concat
  println ;
