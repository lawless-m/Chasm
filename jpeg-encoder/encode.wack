# The encoder's PPM entry point: the cjpeg equivalent the byte-exact tests
# drive (ARCHITECTURE.md, "The two programs").
#
# Protocol: stdin gives the input path and the output path (natively
# `/file/<absolute path>`), then option lines until the end of input:
# `quality=Q` (default 85) and `sample=S` (420, 422 or 444, default 420;
# ignored for greyscale). stdout gets `ENCODED width height ncomp`, with
# the JPEG written to the output path; the exit status is 0. A refusal is
# a trap `REFUSED CODE: message` on stderr with exit status 1; any other
# trap is an encoder bug.
#
# P5 (greyscale) and P6 (RGB) inputs are both encoded, with maxval 255 or
# 4095: 12-bit samples are scaled to 8 bits by ppmread, so the encoder sees
# 8-bit rows either way. Rows stream from the loaded image into the row
# sink encoder.wack, which codes one iMCU row at a time.

# The quality so far and an option line: the quality after it.
declare encode.option ( i32 str -- i32 )
test encode.option : 85 "quality=50" encode.option -> 50
test encode.option : 85 "quality=100" encode.option -> 100
test encode.option : 85 "sample=420" encode.option -> 85
test encode.option : 85 "sample=444" encode.option -> 85
test encode.option : 85 "" encode.option -> 85
test encode.option : 85 "quality=" encode.option -> trap
test encode.option : 85 "quality=5x" encode.option -> trap
test encode.option : 85 "colour=red" encode.option -> trap
test encode.option : 85 "q" encode.option -> trap

# The sample so far and an option line: for `sample=S` the sample, which
# must be 420, 422 or 444; any other line leaves it as it was.
declare encode.sample ( i32 str -- i32 )
test encode.sample : 420 "sample=444" encode.sample -> 444
test encode.sample : 420 "sample=422" encode.sample -> 422
test encode.sample : 444 "sample=420" encode.sample -> 420
test encode.sample : 420 "quality=50" encode.sample -> 420
test encode.sample : 420 "" encode.sample -> 420
test encode.sample : 420 "sample=411" encode.sample -> trap
test encode.sample : 420 "sample=" encode.sample -> trap
test encode.sample : 420 "sample=420x" encode.sample -> trap

: encode.prefix? ( str str -- i32 )
  :> p :> line
  line str.len p str.len i32.ge_u [ line 0 p str.len str.slice p str.eq ] [ 0 ] if ;

: encode.option ( i32 str -- i32 )
  :> line :> q
  line str.len 0 i32.eq
  [ q ]
  [
    line "quality=" encode.prefix?
    [
      line 8 str.i32-at :> next :> v
      next line str.len i32.ne [ "bad quality" trap ] when
      v
    ]
    [ line "sample=" encode.prefix? [ q ] [ "unknown option" trap ] if ]
    if
  ]
  if ;

: encode.sample ( i32 str -- i32 )
  :> line :> s
  line "sample=" encode.prefix?
  [
    line 7 str.i32-at :> next :> v
    next line str.len i32.ne [ "bad sample" trap ] when
    v 420 i32.eq  v 422 i32.eq i32.or  v 444 i32.eq i32.or  i32.eqz [ "bad sample" trap ] when
    v
  ]
  [ s ]
  if ;

: main ( -- )
  read-line drop :> inp
  read-line drop :> outp
  85 :> quality!
  420 :> sample!
  1 :> more!
  [ more ]
  [
    read-line more!
    :> line
    more
    [
      quality line encode.option quality!
      sample line encode.sample sample!
    ]
    when
  ]
  while
  inp ppmread.load :> im
  im pimage.w :> w
  im pimage.h :> h
  outp w h im pimage.n quality sample "" encoder.open :> e
  w im pimage.n i32.mul :> rb
  h [ :> y  e  im pimage.data y rb i32.mul rb bytes.slice  encoder.row ] times
  e encoder.close
  "ENCODED " im pimage.w i32.to-str str.concat " " str.concat im pimage.h i32.to-str str.concat
  " " str.concat im pimage.n i32.to-str str.concat
  println ;
