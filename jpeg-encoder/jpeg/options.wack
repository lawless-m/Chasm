# The stdin option lines both programs read, one word an option: encode.wack
# takes `quality=Q`, `sample=S` and `icc=<path>`; clean.wack takes
# `quality=Q` and `sample=S`. Each word takes the value so far and one line
# and gives the value after it; options.quality also rejects a line that is
# no option at all.

# A line and a prefix: 1 when the line starts with it.
declare options.prefix? ( str str -- i32 )
test options.prefix? : "quality=5" "quality=" options.prefix? -> 1
test options.prefix? : "q" "quality=" options.prefix? -> 0

# The quality so far and an option line: the quality after it.
declare options.quality ( i32 str -- i32 )
test options.quality : 85 "quality=50" options.quality -> 50
test options.quality : 85 "quality=100" options.quality -> 100
test options.quality : 85 "icc=/file/a.icc" options.quality -> 85
test options.quality : 85 "sample=420" options.quality -> 85
test options.quality : 85 "sample=444" options.quality -> 85
test options.quality : 85 "" options.quality -> 85
test options.quality : 85 "quality=" options.quality -> trap
test options.quality : 85 "quality=5x" options.quality -> trap
test options.quality : 85 "colour=red" options.quality -> trap
test options.quality : 85 "q" options.quality -> trap

# The sample so far and an option line: for `sample=S` the sample, which
# must be 420, 422 or 444; any other line leaves it as it was.
declare options.sample ( i32 str -- i32 )
test options.sample : 420 "sample=444" options.sample -> 444
test options.sample : 420 "sample=422" options.sample -> 422
test options.sample : 444 "sample=420" options.sample -> 420
test options.sample : 420 "quality=50" options.sample -> 420
test options.sample : 420 "" options.sample -> 420
test options.sample : 420 "sample=411" options.sample -> trap
test options.sample : 420 "sample=" options.sample -> trap
test options.sample : 420 "sample=420x" options.sample -> trap

# The profile path so far and an option line: for `icc=<path>` the path,
# which must not be empty; any other line leaves it as it was.
declare options.icc ( str str -- str )
test options.icc : "" "icc=/file/a.icc" options.icc -> "/file/a.icc"
test options.icc : "" "quality=50" options.icc -> ""
test options.icc : "/file/a.icc" "sample=420" options.icc -> "/file/a.icc"
test options.icc : "/file/a.icc" "icc=/file/b.icc" options.icc -> "/file/b.icc"
test options.icc : "" "icc=" options.icc -> trap
test options.icc : "" "" options.icc -> ""

: options.prefix? ( str str -- i32 )
  :> p :> line
  line str.len p str.len i32.ge_u [ line 0 p str.len str.slice p str.eq ] [ 0 ] if ;

: options.quality ( i32 str -- i32 )
  :> line :> q
  line str.len 0 i32.eq
  [ q ]
  [
    line "quality=" options.prefix?
    [
      line 8 str.i32-at :> next :> v
      next line str.len i32.ne [ "bad quality" trap ] when
      v
    ]
    [ line "sample=" options.prefix?  line "icc=" options.prefix? i32.or [ q ] [ "unknown option" trap ] if ]
    if
  ]
  if ;

: options.sample ( i32 str -- i32 )
  :> line :> s
  line "sample=" options.prefix?
  [
    line 7 str.i32-at :> next :> v
    next line str.len i32.ne [ "bad sample" trap ] when
    v 420 i32.eq  v 422 i32.eq i32.or  v 444 i32.eq i32.or  i32.eqz [ "bad sample" trap ] when
    v
  ]
  [ s ]
  if ;

: options.icc ( str str -- str )
  :> line :> path
  line "icc=" options.prefix?
  [
    line 4  line str.len 4 i32.sub  str.slice :> p
    p str.len 0 i32.eq [ "bad icc" trap ] when
    p
  ]
  [ path ]
  if ;
