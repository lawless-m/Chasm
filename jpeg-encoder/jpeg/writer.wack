# The markers, in the order cjpeg writes them: SOI, APP0 (JFIF), APP2 ICC
# chunks when a profile is carried (writer.icc, jcicc.c), DQT, SOF0, DHT
# for each table used, SOS, the scan, EOI (jcmarker.c). DQT writes its table in zigzag order. Greyscale writes one
# component with writer.sof0 and writer.sos; colour writes DQT 0, DQT 1,
# writer.sof0-ycc, DHT 0x00, 0x10, 0x01, 0x11 and writer.sos-ycc, with
# components 1 (Y, sampled hs x vs, tables 0), 2 (Cb) and 3 (Cr) (1x1,
# tables 1), as jpeg_set_colorspace sets them for YCbCr.

declare writer.soi ( out -- )
test writer.soi : 64 fx.out dup writer.soi fx.taken fx.soi hex eq -> 1

# APP0: JFIF 1.01, density unit 0, density 1:1, no thumbnail (cjpeg's
# defaults, emit_jfif_app0).
declare writer.app0 ( out -- )
test writer.app0 : 64 fx.out dup writer.app0 fx.taken fx.app0 hex eq -> 1

# The output and an ICC profile of n bytes (n > 0): APP2 segments as
# jcicc.c jpeg_write_icc_profile writes them. The profile is cut into
# chunks of at most 65519 bytes (65533 less the 14-byte header); each is
# FF E2, the length (chunk + 16), `ICC_PROFILE` and a 0 byte, the sequence
# number from 1, the chunk count, then the chunk's bytes, copied as they
# are (marker segments are not stuffed). An empty profile traps, where
# libjpeg errors JERR_BUFFER_SIZE.
declare writer.icc ( out bytes -- )
test writer.icc : 64 fx.out dup "0102ff" hex writer.icc fx.taken "ffe200134943435f50524f46494c450001010102ff" hex eq -> 1
test writer.icc : 65600 fx.out dup 65519 bytes.new writer.icc out.fill -> 65537
test writer.icc : 65600 fx.out dup 65519 bytes.new writer.icc fx.taken 0 18 bytes.slice "ffe2ffff4943435f50524f46494c45000101" hex eq -> 1
test writer.icc : 65600 fx.out dup 65520 bytes.new writer.icc out.fill -> 65556
test writer.icc : 65600 fx.out dup 65520 bytes.new writer.icc fx.taken 0 18 bytes.slice "ffe2ffff4943435f50524f46494c45000102" hex eq -> 1
test writer.icc : 65600 fx.out dup 65520 bytes.new writer.icc fx.taken 65537 18 bytes.slice "ffe200114943435f50524f46494c45000202" hex eq -> 1
test writer.icc : 140000 fx.out dup 131039 bytes.new writer.icc out.fill -> 131093
test writer.icc : 140000 fx.out dup 131039 bytes.new writer.icc fx.taken 131074 18 bytes.slice "ffe200114943435f50524f46494c45000303" hex eq -> 1
test writer.icc : 64 fx.out dup 0 bytes.new writer.icc -> trap

# The output, a table id (0 to 3), a 64-entry table in natural order.
declare writer.dqt ( out i32 array i32 -- )
test writer.dqt : 128 fx.out dup 0 qtables.lum 50 qtables.scaled writer.dqt fx.taken fx.dqt hex eq -> 1
test writer.dqt : 128 fx.out dup 1 qtables.lum 50 qtables.scaled writer.dqt fx.taken 4 bytes.at -> 1
test writer.dqt : 128 fx.out dup 0 qtables.lum 100 qtables.scaled dup 0 256 array.at! writer.dqt -> trap

# The output, width, height: a one-component (greyscale) SOF0.
declare writer.sof0 ( out i32 i32 -- )
test writer.sof0 : 64 fx.out dup 1 1 writer.sof0 fx.taken fx.sof hex eq -> 1
test writer.sof0 : 64 fx.out dup 8 8 writer.sof0 fx.taken "ffc0000b080008000801011100" hex eq -> 1
test writer.sof0 : 64 fx.out dup 300 200 writer.sof0 fx.taken 5 4 bytes.slice "00c8012c" hex eq -> 1

# The output, the class-and-id byte (0x00 DC table 0, 0x10 AC table 0),
# bits (17 entries, [1..16] written), vals (as many as the bits count).
declare writer.dht ( out i32 array i32 array i32 -- )
test writer.dht : 64 fx.out dup 0 htables.dc-lum-bits htables.dc-lum-vals writer.dht fx.taken "ffc4001f00" "00010501010101010100000000000000" str.concat "000102030405060708090a0b" str.concat hex eq -> 1
test writer.dht : 256 fx.out dup 0x10 htables.ac-lum-bits htables.ac-lum-vals writer.dht out.fill -> 183
test writer.dht : 256 fx.out dup 0x10 htables.ac-lum-bits htables.ac-lum-vals writer.dht fx.taken 3 bytes.at -> 0xB5
test writer.dht : 256 fx.out dup 0x10 htables.ac-lum-bits htables.ac-lum-vals writer.dht fx.taken 4 bytes.at -> 0x10
test writer.dht : 256 fx.out dup 0x10 htables.ac-lum-bits htables.ac-lum-vals writer.dht fx.taken 20 bytes.at -> 0x7D
test writer.dht : 256 fx.out dup 0x10 htables.ac-lum-bits htables.ac-lum-vals writer.dht fx.taken 182 bytes.at -> 0xFA

# A one-component (greyscale) SOS: tables 0 and 0, Ss 0, Se 63, AhAl 0.
declare writer.sos ( out -- )
test writer.sos : 64 fx.out dup writer.sos fx.taken fx.sos hex eq -> 1

declare writer.eoi ( out -- )
test writer.eoi : 64 fx.out dup writer.eoi fx.taken "ffd9" hex eq -> 1

: writer.soi ( out -- )  0xFFD8 out.u16 ;

: writer.app0 ( out -- )
  :> o
  o 0xFFE0 out.u16
  o 16 out.u16
  o 0x4A out.byte  o 0x46 out.byte  o 0x49 out.byte  o 0x46 out.byte  o 0 out.byte
  o 1 out.byte  o 1 out.byte
  o 0 out.byte
  o 1 out.u16  o 1 out.u16
  o 0 out.byte  o 0 out.byte ;

: writer.icc ( out bytes -- )
  :> prof :> o
  prof bytes.len :> n
  n 0 i32.eq [ "empty ICC profile" trap ] when
  n 65519 i32.div_u :> full
  full 65519 i32.mul n i32.eq [ full ] [ full 1 i32.add ] if :> count
  0 :> at!
  1 :> seq!
  [ at n i32.lt_u ]
  [
    n at i32.sub :> left
    left 65519 i32.gt_u [ 65519 ] [ left ] if :> len
    o 0xFFE2 out.u16
    o  len 16 i32.add  out.u16
    o 0x49 out.byte  o 0x43 out.byte  o 0x43 out.byte  o 0x5F out.byte
    o 0x50 out.byte  o 0x52 out.byte  o 0x4F out.byte  o 0x46 out.byte
    o 0x49 out.byte  o 0x4C out.byte  o 0x45 out.byte  o 0 out.byte
    o seq out.byte
    o count out.byte
    len [ :> k  o  prof at k i32.add bytes.at  out.byte ] times
    at len i32.add at!
    seq 1 i32.add seq!
  ]
  while ;

: writer.dqt ( out i32 array i32 -- )
  :> t :> id :> o
  dct.natural :> nat
  o 0xFFDB out.u16
  o 67 out.u16
  o id out.byte
  64
  [
    :> k
    t  nat k array.at  array.at :> v
    v 255 i32.gt_s [ "DQT entry over 255" trap ] when
    o v out.byte
  ]
  times ;

: writer.sof0 ( out i32 i32 -- )
  :> ht :> wd :> o
  o 0xFFC0 out.u16
  o 11 out.u16
  o 8 out.byte
  o ht out.u16
  o wd out.u16
  o 1 out.byte
  o 1 out.byte  o 0x11 out.byte  o 0 out.byte ;

: writer.dht ( out i32 array i32 array i32 -- )
  :> vals :> bits :> tc :> o
  0 :> count!
  16 [ :> i  count  bits i 1 i32.add array.at  i32.add count! ] times
  o 0xFFC4 out.u16
  o  19 count i32.add  out.u16
  o tc out.byte
  16 [ :> j  o  bits j 1 i32.add array.at  out.byte ] times
  count [ :> k  o  vals k array.at  out.byte ] times ;

: writer.sos ( out -- )
  :> o
  o 0xFFDA out.u16
  o 8 out.u16
  o 1 out.byte
  o 1 out.byte  o 0 out.byte
  o 0 out.byte  o 63 out.byte  o 0 out.byte ;

: writer.eoi ( out -- )  0xFFD9 out.u16 ;

# The output, width, height and the luma sampling factors hs, vs (2 2 for
# 420, 2 1 for 422, 1 1 for 444): a three-component SOF0.
declare writer.sof0-ycc ( out i32 i32 i32 i32 -- )

# A three-component SOS: Y with tables 0 and 0, Cb and Cr with 1 and 1.
declare writer.sos-ycc ( out -- )

# Segments of cjpeg -dct int -baseline -quality 50 -sample S of a 1x1 red
# P6: DQT 1, SOF0 at 2x2, 2x1 and 1x1, DHT 0x01, DHT 0x11, SOS.
: fx.dqt1-q50 ( -- str )  "ffdb0043011112121815182f1a1a2f634238426363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363636363" ;
: fx.sof-420 ( -- str )  "ffc00011080001000103012200021101031101" ;
: fx.sof-422 ( -- str )  "ffc00011080001000103012100021101031101" ;
: fx.sof-444 ( -- str )  "ffc00011080001000103011100021101031101" ;
: fx.dht01 ( -- str )  "ffc4001f0100030101010101010101010000000000000102030405060708090a0b" ;
: fx.dht11 ( -- str )  "" ;
: fx.sos-ycc ( -- str )  "ffda000c03010002110311003f00" ;

test writer.sof0-ycc : 64 fx.out dup 1 1 2 2 writer.sof0-ycc fx.taken fx.sof-420 hex eq -> 1
test writer.sof0-ycc : 64 fx.out dup 1 1 2 1 writer.sof0-ycc fx.taken fx.sof-422 hex eq -> 1
test writer.sof0-ycc : 64 fx.out dup 1 1 1 1 writer.sof0-ycc fx.taken fx.sof-444 hex eq -> 1
test writer.sof0-ycc : 64 fx.out dup 300 200 2 2 writer.sof0-ycc fx.taken 5 4 bytes.slice "00c8012c" hex eq -> 1
test writer.sos-ycc : 64 fx.out dup writer.sos-ycc fx.taken fx.sos-ycc hex eq -> 1
test writer.dqt : 128 fx.out dup 1 qtables.chrom 50 qtables.scaled writer.dqt fx.taken fx.dqt1-q50 hex eq -> 1
test writer.dht : 64 fx.out dup 0x01 htables.dc-chrom-bits htables.dc-chrom-vals writer.dht fx.taken fx.dht01 hex eq -> 1
test writer.dht : 256 fx.out dup 0x11 htables.ac-chrom-bits htables.ac-chrom-vals writer.dht fx.taken fx.dht11 hex eq -> 1

: writer.sof0-ycc ( out i32 i32 i32 i32 -- )
  :> vs :> hs :> ht :> wd :> o
  o 0xFFC0 out.u16
  o 17 out.u16
  o 8 out.byte
  o ht out.u16
  o wd out.u16
  o 3 out.byte
  o 1 out.byte  o  hs 4 i32.shl vs i32.or  out.byte  o 0 out.byte
  o 2 out.byte  o 0x11 out.byte  o 1 out.byte
  o 3 out.byte  o 0x11 out.byte  o 1 out.byte ;

: writer.sos-ycc ( out -- )
  :> o
  o 0xFFDA out.u16
  o 12 out.u16
  o 3 out.byte
  o 1 out.byte  o 0x00 out.byte
  o 2 out.byte  o 0x11 out.byte
  o 3 out.byte  o 0x11 out.byte
  o 0 out.byte  o 63 out.byte  o 0 out.byte ;
