# The eight EXIF orientations applied to a collected image: any orientation
# but 1 collects the whole decoded image, then streams it, turned, into the
# encoder (ARCHITECTURE.md, "The two programs").
#
# Output pixel (x, y) comes from input pixel, W and H being the input's
# width and height: 1 (x, y); 2 (W-1-x, y); 3 (W-1-x, H-1-y); 4 (x, H-1-y);
# 5 (y, x); 6 (y, H-1-x); 7 (W-1-y, H-1-x); 8 (W-1-y, x). Orientations 5 to
# 8 swap the width and height. tools/orient.py is the same table in Python
# and the reference the tests are pinned from. Orientations 5 to 8 read the
# input column-wise, a pixel at a time: correct first; speed comes later.

# Orientation, width, height: the turned image's width and height. An
# orientation outside 1 to 8 is a plain trap (meta guarantees the range).
declare orient.dims ( i32 i32 i32 -- i32 i32 )
test orient.dims : 1 5 7 orient.dims -> 5 7
test orient.dims : 4 5 7 orient.dims -> 5 7
test orient.dims : 5 5 7 orient.dims -> 7 5
test orient.dims : 6 5 7 orient.dims -> 7 5
test orient.dims : 8 5 7 orient.dims -> 7 5
test orient.dims : 0 5 7 orient.dims -> trap
test orient.dims : 9 5 7 orient.dims -> trap

# The image (w x h pixels of n bytes, row-major), w, h, n, the orientation,
# an output row buffer of exactly w' x n bytes and the output row index y:
# fills the buffer with output row y. Allocates nothing; a wrong image or
# buffer length, or y past the turned height, is a plain trap.
declare orient.row-into ( bytes i32 i32 i32 i32 bytes i32 -- )

# w, h, n, orientation and the hex of an image: the whole turned image, row
# by row through orient.row-into.
: fx.or-all ( i32 i32 i32 i32 str -- bytes )
  :> img :> o :> n :> h :> w
  img hex :> data
  o w h orient.dims :> h2 :> w2
  w2 n i32.mul :> rb
  rb bytes.new :> row
  rb h2 i32.mul bytes.new :> all
  h2 [ :> y  data w h n o row y orient.row-into  all  y rb i32.mul  row bytes.as-str bytes.put ] times
  all ;

test orient.row-into : 2 3 3 1 "000102030405060708090a0b0c0d0e0f1011" fx.or-all "000102030405060708090a0b0c0d0e0f1011" hex eq -> 1
test orient.row-into : 2 3 3 2 "000102030405060708090a0b0c0d0e0f1011" fx.or-all "030405000102090a0b0607080f10110c0d0e" hex eq -> 1
test orient.row-into : 2 3 3 3 "000102030405060708090a0b0c0d0e0f1011" fx.or-all "0f10110c0d0e090a0b060708030405000102" hex eq -> 1
test orient.row-into : 2 3 3 4 "000102030405060708090a0b0c0d0e0f1011" fx.or-all "0c0d0e0f1011060708090a0b000102030405" hex eq -> 1
test orient.row-into : 2 3 3 5 "000102030405060708090a0b0c0d0e0f1011" fx.or-all "0001020607080c0d0e030405090a0b0f1011" hex eq -> 1
test orient.row-into : 2 3 3 6 "000102030405060708090a0b0c0d0e0f1011" fx.or-all "0c0d0e0607080001020f1011090a0b030405" hex eq -> 1
test orient.row-into : 2 3 3 7 "000102030405060708090a0b0c0d0e0f1011" fx.or-all "0f1011090a0b0304050c0d0e060708000102" hex eq -> 1
test orient.row-into : 2 3 3 8 "000102030405060708090a0b0c0d0e0f1011" fx.or-all "030405090a0b0f10110001020607080c0d0e" hex eq -> 1
test orient.row-into : 3 2 1 1 "000102030405" fx.or-all "000102030405" hex eq -> 1
test orient.row-into : 3 2 1 2 "000102030405" fx.or-all "020100050403" hex eq -> 1
test orient.row-into : 3 2 1 3 "000102030405" fx.or-all "050403020100" hex eq -> 1
test orient.row-into : 3 2 1 4 "000102030405" fx.or-all "030405000102" hex eq -> 1
test orient.row-into : 3 2 1 5 "000102030405" fx.or-all "000301040205" hex eq -> 1
test orient.row-into : 3 2 1 6 "000102030405" fx.or-all "030004010502" hex eq -> 1
test orient.row-into : 3 2 1 7 "000102030405" fx.or-all "050204010300" hex eq -> 1
test orient.row-into : 3 2 1 8 "000102030405" fx.or-all "020501040003" hex eq -> 1
test orient.row-into : 2 3 3 1 "000102030405060708090a0b0c0d0e0f1011" fx.or-all bytes.len -> 18
test orient.row-into : "000102030405060708090a0b0c0d0e0f1011" hex 2 3 3 6 5 bytes.new 0 orient.row-into -> trap
test orient.row-into : "000102030405060708090a0b0c0d0e0f1011" hex 2 3 3 6 9 bytes.new 2 orient.row-into -> trap
test orient.row-into : "000102030405060708090a0b0c0d0e0f10" hex 2 3 3 6 9 bytes.new 0 orient.row-into -> trap

: orient.dims ( i32 i32 i32 -- i32 i32 )
  :> h :> w :> o
  o 1 i32.lt_s  o 8 i32.gt_s  i32.or [ "orientation out of range" trap ] when
  o 5 i32.ge_s [ h w ] [ w h ] if ;

: orient.row-into ( bytes i32 i32 i32 i32 bytes i32 -- )
  :> y :> row :> o :> n :> h :> w :> img
  img bytes.len  w h i32.mul n i32.mul  i32.ne [ "image length" trap ] when
  o w h orient.dims :> h2 :> w2
  row bytes.len  w2 n i32.mul  i32.ne [ "row length" trap ] when
  y 0 i32.lt_s  y h2 i32.ge_s  i32.or [ "row index" trap ] when
  w2
  [
    :> x
    o 1 i32.eq [ x ]
    [
      o 2 i32.eq  o 3 i32.eq  i32.or [ w 1 i32.sub x i32.sub ]
      [
        o 4 i32.eq [ x ]
        [
          o 5 i32.eq  o 6 i32.eq  i32.or [ y ] [ w 1 i32.sub y i32.sub ] if
        ]
        if
      ]
      if
    ]
    if :> sx
    o 1 i32.eq  o 2 i32.eq  i32.or [ y ]
    [
      o 3 i32.eq  o 4 i32.eq  i32.or [ h 1 i32.sub y i32.sub ]
      [
        o 5 i32.eq  o 8 i32.eq  i32.or [ x ] [ h 1 i32.sub x i32.sub ] if
      ]
      if
    ]
    if :> sy
    sy w i32.mul sx i32.add n i32.mul :> src
    x n i32.mul :> dst
    n [ :> k  row  dst k i32.add  img src k i32.add bytes.at  bytes.at! ] times
  ]
  times ;
