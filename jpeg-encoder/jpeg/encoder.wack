: fx.img8 ( -- str )  "f5b165224a58b791df6af1d8303e61cdc4bb86c3d1c427103c344c4189eb2f1e7bd5d47e446fcec2a3d811736110e5781bcccea696762e6116c6e9c92d99bf35" ;
: fx.ref8-q50 ( -- str )  "" ;
: fx.ref8-q100 ( -- str )  "" ;
: fx.ref-flat77-q50 ( -- str )  "" ;
: fx.img9x3 ( -- str )  "38b4e652e44da7f2370d9e260e27136550a4a3a6d07f5c0c2f8b12" ;
: fx.ref9x3-q85 ( -- str )  "" ;
: fx.img1x1 ( -- str )  "3c" ;
: fx.ref1x1-q50 ( -- str )  "" ;
: fx.img3x17 ( -- str )  "d7a56d3cfcf9a44dc716691acdaba1b8a912646543c6977a5a43ac2753cf10173122071113bd120536abce666699a58c1affea" ;
: fx.ref3x17-q75 ( -- str )  "" ;
: fx.img17x9 ( -- str )  "" ;
: fx.ref17x9-q50 ( -- str )  "" ;
# cjpeg -dct int -baseline -quality 50 -sample 2x2 of a 1x1 red P6.
: fx.ref-red-q50-420 ( -- str )  "" ;
: fx.img6-8x8 ( -- str )  "" ;
: fx.ref6-8x8-q50-444 ( -- str )  "" ;
: fx.img6-9x3 ( -- str )  "38b4e652e44da7f2370d9e260e27136550a4a3a6d07f5c0c332f8b1224083fd22b902f8911e81818f8c99d5d5d9831957504d90e945de2e8f54ee781cc75f636d85099095aa300165a67036f9b540d6b11" ;
: fx.ref6-9x3-q85-444 ( -- str )  "" ;
: fx.img6-17x9 ( -- str )  "" ;
: fx.ref6-17x9-q75-444 ( -- str )  "" ;
: fx.imgp6-16x16 ( -- str )  "" ;
: fx.refp6-16x16-q90-444 ( -- str )  "" ;
: fx.ref6-9x3-q85-422 ( -- str )  "" ;
: fx.img6-24x8 ( -- str )  "" ;
: fx.ref6-24x8-q50-422 ( -- str )  "" ;
: fx.img6-16x16 ( -- str )  "" ;
: fx.ref6-16x16-q75-420 ( -- str )  "" ;
: fx.img6-17x17 ( -- str )  "" ;
: fx.ref6-17x17-q50-420 ( -- str )  "" ;
: fx.img6-3x17 ( -- str )  "" ;
: fx.ref6-3x17-q50-420 ( -- str )  "" ;
: fx.imgp6-33x17 ( -- str )  "" ;
: fx.refp6-33x17-q85-420 ( -- str )  "" ;

# A 9x3 greyscale encoder fed the first n rows of fx.img9x3, then finished.
: fx.feed9x3 ( i32 -- i32 )
  :> n
  fx.img9x3 hex :> data
  8192 fx.out 9 3 1 1 1 85 0 bytes.new encoder.on :> e
  n [ :> y  e  data y 9 i32.mul 9 bytes.slice  encoder.row ] times
  e encoder.finish
  e encoder.o out.fill ;

test encoder.on : 85 fx.enc encoder.pw -> 8
test encoder.on : 85 fx.enc encoder.hb 0 array.at -> 1
test encoder.on : 85 fx.enc encoder.cp bytes.len -> 64
test encoder.on : 85 fx.enc encoder.o out.fill -> 328
test encoder.on : 4096 fx.out 17 3 1 1 1 85 0 bytes.new encoder.on encoder.pw -> 24
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.mw -> 2
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.mh -> 2
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.pw -> 32
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.hb 0 array.at -> 3
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.hb 1 array.at -> 2
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.hb 2 array.at -> 2
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.vb 0 array.at -> 3
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.vb 1 array.at -> 2
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.vb 2 array.at -> 2
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.cpw 0 array.at -> 24
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.cpw 1 array.at -> 16
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.cp bytes.len -> 640
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.rg bytes.len -> 192
test encoder.on : 17 17 2 2 50 fx.enc3 encoder.o out.fill -> 623
test encoder.on : 9 3 2 1 85 fx.enc3 encoder.mw -> 1
test encoder.on : 9 3 2 1 85 fx.enc3 encoder.pw -> 16
test encoder.on : 9 3 2 1 85 fx.enc3 encoder.hb 0 array.at -> 2
test encoder.on : 9 3 2 1 85 fx.enc3 encoder.hb 1 array.at -> 1
test encoder.on : 9 3 2 1 85 fx.enc3 encoder.vb 0 array.at -> 1
test encoder.on : 1 1 1 1 50 fx.enc3 encoder.mw -> 1
test encoder.on : 1 1 1 1 50 fx.enc3 encoder.pw -> 8
test encoder.on : 1 1 1 1 50 fx.enc3 encoder.cp bytes.len -> 192
# With the 3-byte profile 01 02 FF: the header ends where cjpeg -icc's SOS
# ends, and the APP2 chunk is cjpeg's.
test encoder.on : 4096 fx.out 8 8 1 1 1 85 "0102ff" hex encoder.on encoder.o out.fill -> 349
test encoder.on : 4096 fx.out 8 8 1 1 1 85 "0102ff" hex encoder.on encoder.o fx.taken 20 21 bytes.slice "ffe200134943435f50524f46494c450001010102ff" hex eq -> 1
test encoder.on : 65536 fx.out 17 17 3 2 2 50 "0102ff" hex encoder.on encoder.o out.fill -> 644
test encoder.on : 65536 fx.out 17 17 3 2 2 50 "0102ff" hex encoder.on encoder.o fx.taken 20 21 bytes.slice "ffe200134943435f50524f46494c450001010102ff" hex eq -> 1
test encoder.open : "/file/dev/null" 1 1 3 85 420 "" encoder.open encoder.hs -> 2
test encoder.open : "/file/dev/null" 1 1 3 85 420 "" encoder.open encoder.vs -> 2
test encoder.open : "/file/dev/null" 1 1 3 85 422 "" encoder.open encoder.hs -> 2
test encoder.open : "/file/dev/null" 1 1 3 85 422 "" encoder.open encoder.vs -> 1
test encoder.open : "/file/dev/null" 1 1 3 85 444 "" encoder.open encoder.hs -> 1
test encoder.open : "/file/dev/null" 1 1 3 85 444 "" encoder.open encoder.vs -> 1
