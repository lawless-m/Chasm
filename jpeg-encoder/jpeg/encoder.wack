test encoder.row : 8192 fx.out 9 3 1 1 1 85 0 bytes.new encoder.on 8 bytes.new encoder.row -> trap
# A colour row one byte short, and a colour image one row short.
test encoder.row : 9 3 1 1 85 fx.enc3 26 bytes.new encoder.row -> trap
test encoder.row : 9 3 2 2 85 fx.enc3 dup 27 bytes.new encoder.row dup 27 bytes.new encoder.row encoder.finish -> trap
test encoder.row : 8 8 1 1 50 fx.img6-8x8 fx.feed3 fx.ref6-8x8-q50-444 hex eq -> 1
test encoder.row : 9 3 1 1 85 fx.img6-9x3 fx.feed3 fx.ref6-9x3-q85-444 hex eq -> 1
test encoder.row : 17 9 1 1 75 fx.img6-17x9 fx.feed3 fx.ref6-17x9-q75-444 hex eq -> 1
test encoder.row : 16 16 1 1 90 fx.imgp6-16x16 fx.feed3 fx.refp6-16x16-q90-444 hex eq -> 1
test encoder.row : 9 3 2 1 85 fx.img6-9x3 fx.feed3 fx.ref6-9x3-q85-422 hex eq -> 1
test encoder.row : 24 8 2 1 50 fx.img6-24x8 fx.feed3 fx.ref6-24x8-q50-422 hex eq -> 1
test encoder.row : 16 16 2 2 75 fx.img6-16x16 fx.feed3 fx.ref6-16x16-q75-420 hex eq -> 1
test encoder.row : 17 17 2 2 50 fx.img6-17x17 fx.feed3 fx.ref6-17x17-q50-420 hex eq -> 1
test encoder.row : 3 17 2 2 50 fx.img6-3x17 fx.feed3 fx.ref6-3x17-q50-420 hex eq -> 1
test encoder.row : 33 17 2 2 85 fx.imgp6-33x17 fx.feed3 fx.refp6-33x17-q85-420 hex eq -> 1

: encoder.on ( out i32 i32 i32 i32 i32 i32 bytes -- encoder )
  :> prof :> q :> vs :> hs :> n :> h :> w :> o
  w 8 hs i32.mul i32.add 1 i32.sub  8 hs i32.mul i32.div_s :> mw
  h 8 vs i32.mul i32.add 1 i32.sub  8 vs i32.mul i32.div_s :> mh
  mw 8 i32.mul hs i32.mul :> pw
  3 array.new ( array i32 ) :> hb
  3 array.new ( array i32 ) :> vb
  3 array.new ( array i32 ) :> cpw
  3 array.new ( array i32 ) :> cpo
  hb 0  w 7 i32.add 8 i32.div_s  array.at!
  vb 0  h 7 i32.add 8 i32.div_s  array.at!
  hb 1 mw array.at!  hb 2 mw array.at!
  vb 1 mh array.at!  vb 2 mh array.at!
  3 [ :> c  cpw c  hb c array.at 8 i32.mul  array.at! ] times
  cpo 1  vs 8 i32.mul  cpw 0 array.at i32.mul  array.at!
  cpo 2  cpo 1 array.at  8 cpw 1 array.at i32.mul i32.add  array.at!
  n 1 i32.eq [ cpo 1 array.at ] [ cpo 2 array.at  8 cpw 2 array.at i32.mul i32.add ] if :> cplen
  qtables.lum q qtables.scaled :> qt
  qtables.chrom q qtables.scaled :> qtc
  64 array.new ( array i32 ) :> blk
  n array.new ( array i32 ) :> pred
  o writer.soi
  o writer.app0
  prof bytes.len 0 i32.gt_s [ o prof writer.icc ] when
  o 0 qt writer.dqt
  n 3 i32.eq [ o 1 qtc writer.dqt ] when
  n 1 i32.eq [ o w h writer.sof0 ] [ o w h hs vs writer.sof0-ycc ] if
  o 0x00 htables.dc-lum-bits htables.dc-lum-vals writer.dht
  o 0x10 htables.ac-lum-bits htables.ac-lum-vals writer.dht
  n 3 i32.eq
  [
    o 0x01 htables.dc-chrom-bits htables.dc-chrom-vals writer.dht
    o 0x11 htables.ac-chrom-bits htables.ac-chrom-vals writer.dht
  ]
  when
  n 1 i32.eq [ o writer.sos ] [ o writer.sos-ycc ] if
  o  o 0 0 bitwriter.new  w h n hs vs mw mh pw  hb vb
  n vs i32.mul pw i32.mul bytes.new
  cplen bytes.new
  cpo cpw blk qt qtc qtables.natural
  htables.dc-lum htables.ac-lum htables.dc-chrom htables.ac-chrom
  ccolour.make pred
  0 0 0 0
  encoder.new ;

: encoder.load-icc ( str -- bytes )
  host.OREAD host.open :> fd
  fd 0 i32.lt_s [ "cannot open ICC profile" trap ] when
  MAX_ICC 1 i32.add :> cap
  cap bytes.new :> buf
  0 :> got!
  1 :> r!
  [ r 0 i32.gt_s  got cap i32.lt_s  i32.and ]
  [
    fd  buf got  cap got i32.sub  bytes.slice  host.read r!
    r 0 i32.lt_s [ "ICC read error" trap ] when
    got r i32.add got!
  ]
  while
  fd host.close drop
  got cap i32.ge_s [ "ICC profile over 1 MB" trap ] when
  got 0 i32.eq [ "empty ICC profile" trap ] when
  buf 0 got bytes.slice ;

: encoder.open-with ( str i32 i32 i32 i32 i32 bytes -- encoder )
  :> prof :> sample :> q :> n :> h :> w :> path
  n 1 i32.ne  n 3 i32.ne  i32.and [ "component count" trap ] when
  sample 420 i32.eq  sample 422 i32.eq i32.or  sample 444 i32.eq i32.or  i32.eqz [ "bad sample" trap ] when
  n 1 i32.eq  sample 444 i32.eq  i32.or [ 1 ] [ 2 ] if :> hs
  n 1 i32.eq  sample 420 i32.ne  i32.or [ 1 ] [ 2 ] if :> vs
  path out.open w h n hs vs q prof encoder.on ;

: encoder.open ( str i32 i32 i32 i32 i32 str -- encoder )
  :> icc :> sample :> q :> n :> h :> w :> path
  icc str.len 0 i32.eq [ 0 bytes.new ] [ icc encoder.load-icc ] if :> prof
  path w h n q sample prof encoder.open-with ;

: encoder.hc ( encoder i32 -- i32 )  :> c :> e  c 0 i32.eq [ e encoder.hs ] [ 1 ] if ;
: encoder.vc ( encoder i32 -- i32 )  :> c :> e  c 0 i32.eq [ e encoder.vs ] [ 1 ] if ;

: encoder.block ( encoder i32 i32 i32 -- )
  :> gx :> by :> c :> e
  e encoder.blk :> blk
  e encoder.cp :> cp
  e encoder.cpw c array.at :> cw
  e encoder.cpo c array.at  by 8 i32.mul cw i32.mul i32.add  gx 8 i32.mul i32.add :> base
  64
  [
    :> i
    blk i  cp  base  i 3 i32.shr_u cw i32.mul i32.add  i 7 i32.and i32.add  bytes.at 128 i32.sub  array.at!
  ]
  times
  blk fdct.block
  blk  c 0 i32.eq [ e encoder.qt ] [ e encoder.qtc ] if  quantise.block
  e encoder.bw
  c 0 i32.eq [ e encoder.dct ] [ e encoder.dctc ] if
  c 0 i32.eq [ e encoder.act ] [ e encoder.actc ] if
  e encoder.nat  blk  e encoder.pred c array.at
  huffenc.block
  e encoder.pred c  blk 0 array.at  array.at! ;

: encoder.dummy ( encoder i32 -- )
  :> c :> e
  e encoder.bw  c 0 i32.eq [ e encoder.dct ] [ e encoder.dctc ] if  0 huffenc.dc
  e encoder.bw  c 0 i32.eq [ e encoder.act ] [ e encoder.actc ] if  huffenc.eob ;

: encoder.mcu-row ( encoder -- )
  :> e
  e encoder.my :> my
  e encoder.mw
  [
    :> mx
    e encoder.n
    [
      :> c
      e c encoder.hc :> hc
      e c encoder.vc :> vc
      vc
      [
        :> by
        hc
        [
          :> bx
          mx hc i32.mul bx i32.add :> gx
          my vc i32.mul by i32.add :> gy
          gx e encoder.hb c array.at i32.lt_s  gy e encoder.vb c array.at i32.lt_s  i32.and
          [ e c by gx encoder.block ]
          [ e c encoder.dummy ]
          if
        ]
        times
      ]
      times
    ]
    times
  ]
  times
  e 0 encoder.grp!
  e  my 1 i32.add  encoder.my! ;

: encoder.group ( encoder -- )
  :> e
  e encoder.rg :> rg
  e encoder.cp :> cp
  e encoder.pw :> pw
  e encoder.vs :> vs
  e encoder.hs :> hs
  e encoder.grp :> grp
  e encoder.cpw 0 array.at :> cw0
  vs [ :> r  rg  r pw i32.mul  cp  grp vs i32.mul r i32.add cw0 i32.mul  cw0  downsample.full ] times
  e encoder.n 1 i32.sub
  [
    1 i32.add :> c
    e encoder.cpw c array.at :> cw
    e encoder.cpo c array.at  grp cw i32.mul i32.add :> dst
    c vs i32.mul pw i32.mul :> src
    hs 2 i32.eq
    [ vs 2 i32.eq [ rg src pw cp dst cw downsample.h2v2 ] [ rg src cp dst cw downsample.h2v1 ] if ]
    [ rg src cp dst cw downsample.full ]
    if
  ]
  times
  e 0 encoder.rows!
  e  grp 1 i32.add  encoder.grp!
  e encoder.grp 8 i32.eq [ e encoder.mcu-row ] when ;

: encoder.row ( encoder bytes -- )
  :> row :> e
  e encoder.w :> w
  e encoder.n :> n
  e encoder.pw :> pw
  e encoder.vs :> vs
  e encoder.rg :> rg
  e encoder.rows :> rows
  row bytes.len w n i32.mul i32.ne [ "row length" trap ] when
  e encoder.y e encoder.h i32.ge_s [ "too many rows" trap ] when
  n 1 i32.eq
  [ rg  rows pw i32.mul  row bytes.as-str bytes.put ]
  [ e encoder.ct row rg  vs pw i32.mul  rows pw i32.mul  ccolour.row ]
  if
  n
  [
    :> c
    c vs i32.mul rows i32.add pw i32.mul :> base
    rg  base w i32.add 1 i32.sub  bytes.at :> last
    pw w i32.sub [ :> j  rg  base w i32.add j i32.add  last bytes.at! ] times
  ]
  times
  e  rows 1 i32.add  encoder.rows!
  e  e encoder.y 1 i32.add  encoder.y!
  e encoder.rows vs i32.eq [ e encoder.group ] when ;

: encoder.finish ( encoder -- )
  :> e
  e encoder.y e encoder.h i32.ne [ "short image" trap ] when
  e encoder.pw :> pw
  e encoder.vs :> vs
  e encoder.rows :> held
  held 0 i32.gt_s
  [
    e encoder.rg :> rg
    e encoder.n
    [
      :> c
      rg  c vs i32.mul held i32.add 1 i32.sub pw i32.mul  pw bytes.slice bytes.as-str :> lastrow
      vs held i32.sub [ :> k  rg  c vs i32.mul held i32.add k i32.add pw i32.mul  lastrow bytes.put ] times
    ]
    times
    e encoder.group
  ]
  when
  e encoder.grp :> grp
  grp 0 i32.gt_s
  [
    e encoder.cp :> cp
    e encoder.n
    [
      :> ci
      e ci encoder.vc :> vc
      e encoder.cpw ci array.at :> cw
      e encoder.cpo ci array.at :> co
      cp  co grp vc i32.mul 1 i32.sub cw i32.mul i32.add  cw bytes.slice bytes.as-str :> lastds
      8 grp i32.sub vc i32.mul [ :> m  cp  co grp vc i32.mul m i32.add cw i32.mul i32.add  lastds bytes.put ] times
    ]
    times
    e encoder.mcu-row
  ]
  when
  e encoder.bw bitwriter.flush
  e encoder.o writer.eoi ;

: encoder.close ( encoder -- )
  :> e
  e encoder.finish
  e encoder.o out.close ;
