# The row sink (ARCHITECTURE.md "Data flow"): the encoder of one image,
# fed rows top to bottom, writing the JPEG as it goes. Greyscale is one
# component sampled 1x1; colour is Y, Cb and Cr with Y sampled hs x vs
# (2x2 for 420, 2x1 for 422, 1x1 for 444) and Cb and Cr 1x1, so hs and vs
# are also the maximum factors.
#
# Geometry (jcmaster.c initial_setup): mw = ceil(w / 8 hs) MCUs across,
# mh = ceil(h / 8 vs) iMCU rows, pw = mw x 8 hs the padded row width.
# Component c has hb[c] x vb[c] blocks (Y: ceil(w / 8) x ceil(h / 8);
# Cb, Cr: mw x mh) and its plane is cpw[c] = hb[c] x 8 samples wide.
#
# Buffers, allocated once by encoder.on: rg, the row group, n planes of vs
# rows of pw samples (plane c row r at (c vs + r) pw); cp, the component
# planes of one iMCU row, plane c being v_c x 8 rows of cpw[c] samples from
# cpo[c]; the 64-entry DCT workspace; the scaled tables, the zigzag order,
# the four Huffman tables, the colour tables and one DC predictor a
# component.
#
# The pipeline (jcprepct.c pre_process_data): encoder.row colour-converts a
# row into rg (a greyscale row is copied) and replicates each plane's last
# sample out to pw (jcsample.c expand_right_edge); vs rows make a row group,
# which encoder.group downsamples into cp (Y copied, Cb and Cr by h2v2,
# h2v1 or a copy); 8 row groups make an iMCU row, which encoder.mcu-row
# codes. At the bottom, encoder.finish replicates the last row of a partial
# row group through the group, downsamples it, then replicates each
# plane's last downsampled row down to a whole iMCU row (expand_bottom_edge).
#
# MCU order (jccoefct.c compress_data): for each MCU column, each component,
# block rows by of v_c and columns bx of h_c: the block at column
# mx h_c + bx and row my v_c + by. A block past the component's hb or vb is
# a dummy: libjpeg zeroes it and gives it the previous block's DC, so it is
# coded as a DC difference of 0 and an EOB and leaves the predictor alone.
# Every other block is the 8x8 samples less 128 (jcdctmgr.c convsamp), the
# forward DCT, quantisation and Huffman coding against the component's
# previous DC.

struct encoder  o: out  bw: bitwriter  w: i32  h: i32  n: i32  hs: i32  vs: i32  mw: i32  mh: i32  pw: i32  hb: array i32  vb: array i32  rg: bytes  cp: bytes  cpo: array i32  cpw: array i32  blk: array i32  qt: array i32  qtc: array i32  nat: array i32  dct: htab  act: htab  dctc: htab  actc: htab  ct: ccolour  pred: array i32  rows: i32  grp: i32  y: i32  my: i32

# The open output, width, height, components (1 or 3), the luma sampling
# factors hs and vs, quality, and an ICC profile (empty for none): the
# encoder, headers written; a non-empty profile goes in APP2 chunks
# between APP0 and DQT (writer.icc).
declare encoder.on ( out i32 i32 i32 i32 i32 i32 bytes -- encoder )

# A path: the ICC profile file's bytes, a slice of one buffer of
# MAX_ICC + 1 bytes filled by host.read until a read returns 0. There is
# no way to learn a file's size first, and cjpeg itself reads any size, so
# the plan's MAX_ICC (1 MB) caps it; the extra byte detects an oversize
# file. The bytes are not inspected: the profile is encode's own input,
# and the ICC checks are clean's. A missing, empty or oversize file, or a
# read error, is a plain trap.
declare encoder.load-icc ( str -- bytes )
test encoder.load-icc : "/file/dev/null" encoder.load-icc -> trap
test encoder.load-icc : "/nonexistent-dir-for-out-test/x.icc" encoder.load-icc -> trap
test encoder.load-icc : "/file/dev/zero" encoder.load-icc -> trap

# Path, width, height, ncomp (1 or 3), quality, sample (420, 422, 444;
# ignored for greyscale) and an ICC profile's bytes (empty for none): the
# encoder on a new file, headers written, the profile embedded unchecked as
# APP2 chunks (writer.icc) when non-empty.
declare encoder.open-with ( str i32 i32 i32 i32 i32 bytes -- encoder )
test encoder.open-with : "/file/dev/null" 1 1 3 50 420 0 bytes.new encoder.open-with encoder.hs -> 2
test encoder.open-with : "/file/dev/null" 1 1 3 50 444 0 bytes.new encoder.open-with encoder.vs -> 1
test encoder.open-with : "/file/dev/null" 1 1 1 50 420 0 bytes.new encoder.open-with encoder.hs -> 1
test encoder.open-with : "/file/dev/null" 1 1 2 50 420 0 bytes.new encoder.open-with -> trap
test encoder.open-with : "/file/dev/null" 1 1 3 50 411 0 bytes.new encoder.open-with -> trap
test encoder.open-with : "/file/dev/null" 1 1 1 50 420 "0102ff" hex encoder.open-with encoder.o out.fill  "/file/dev/null" 1 1 1 50 420 0 bytes.new encoder.open-with encoder.o out.fill  i32.sub -> 21

# Path, width, height, ncomp, quality, sample, and the path of an ICC
# profile file or "" for none: the file's bytes are loaded
# (encoder.load-icc: a missing or empty file traps) and encoder.open-with
# opens the encoder with them.
declare encoder.open ( str i32 i32 i32 i32 i32 str -- encoder )

# Component c's horizontal and vertical sampling factors.
declare encoder.hc ( encoder i32 -- i32 )
declare encoder.vc ( encoder i32 -- i32 )

# Code component c's block at block row by of the iMCU row and column gx.
declare encoder.block ( encoder i32 i32 i32 -- )

# Code a dummy block of component c: DC difference 0, EOB.
declare encoder.dummy ( encoder i32 -- )

# Code the buffered iMCU row, MCU by MCU.
declare encoder.mcu-row ( encoder -- )

# Downsample the buffered row group into the component planes.
declare encoder.group ( encoder -- )

# One image row of exactly width x n samples, top to bottom.
declare encoder.row ( encoder bytes -- )

# End the scan: pad and code what is buffered, flush the bits and write
# EOI; the output stays open. Fewer rows than the height is a plain trap
# (libjpeg's JERR_TOO_LITTLE_DATA).
declare encoder.finish ( encoder -- )

# Finish, then close the output.
declare encoder.close ( encoder -- )

# An 8x8 greyscale encoder at a quality on a 4 KiB buffer with no file.
: fx.enc ( i32 -- encoder )  :> q  4096 fx.out 8 8 1 1 1 q 0 bytes.new encoder.on ;

# A colour encoder: width, height, hs, vs, quality, on an 8 KiB buffer.
: fx.enc3 ( i32 i32 i32 i32 i32 -- encoder )  :> q :> vs :> hs :> h :> w  8192 fx.out w h 3 hs vs q 0 bytes.new encoder.on ;

# A quality and the hex of an 8x8 greyscale image: the whole file. The image
# is loaded straight into the component plane and its one block coded, so
# the eight rows count as received.
: fx.enc-one ( i32 str -- bytes )
  :> img :> q
  q fx.enc :> e
  e encoder.cp 0  img hex bytes.as-str  bytes.put
  e 0 0 0 encoder.block
  e 8 encoder.y!
  e encoder.finish
  e encoder.o fx.taken ;

# Width, height, quality and the hex of a greyscale image: every row fed
# through encoder.row, then encoder.finish; the whole file.
: fx.feed ( i32 i32 i32 str -- bytes )
  :> img :> q :> h :> w
  img hex :> data
  8192 fx.out w h 1 1 1 q 0 bytes.new encoder.on :> e
  h [ :> y  e  data y w i32.mul w bytes.slice  encoder.row ] times
  e encoder.finish
  e encoder.o fx.taken ;

# The same for colour: width, height, hs, vs, quality, the hex of the
# w x h x 3 RGB bytes.
: fx.feed3 ( i32 i32 i32 i32 i32 str -- bytes )
  :> img :> q :> vs :> hs :> h :> w
  img hex :> data
  w 3 i32.mul :> rb
  65536 fx.out w h 3 hs vs q 0 bytes.new encoder.on :> e
  h [ :> y  e  data y rb i32.mul rb bytes.slice  encoder.row ] times
  e encoder.finish
  e encoder.o fx.taken ;

# tools/gen_ppm.py noise W H SEED and cjpeg -dct int -baseline -quality Q
