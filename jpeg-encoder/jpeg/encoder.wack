# The row sink (ARCHITECTURE.md "Data flow"): the encoder of one image,
# fed sample rows top to bottom, writing the JPEG as it goes.
#
# encoder.on writes the headers and allocates everything once: one MCU row
# of samples (8 rows of the padded width, whole blocks across), the 64-entry
# DCT workspace, the scaled quantisation table, the zigzag order and the two
# Huffman tables. A buffered MCU row is coded block by block: the 8x8
# samples level-shifted by 128 into the workspace (jcdctmgr.c convsamp),
# the forward DCT, quantisation, and Huffman coding against the previous
# block's DC. A greyscale scan has one block per MCU, so every block,
# including those at the right and bottom edges, is a real DCT of padded
# samples (jccoefct.c compress_data never takes its dummy-block branches).
#
# Edges are padded as libjpeg pads them. Each row is copied into the MCU row
# buffer and its last sample replicated out to the padded width
# (jcsample.c expand_right_edge), in encoder.row. At the bottom, encoder.finish
# replicates the last real row, already padded, down to a whole MCU row of 8
# sample rows (jcprepct.c expand_bottom_edge) before coding it.

struct encoder  o: out  bw: bitwriter  w: i32  h: i32  wb: i32  pw: i32  buf: bytes  blk: array i32  qt: array i32  nat: array i32  dct: htab  act: htab  pred: i32  rows: i32  y: i32

# The open output, width, height, quality: the encoder, headers written.
declare encoder.on ( out i32 i32 i32 -- encoder )

# Path, width, height, ncomp, quality, sample, icc: the encoder on a new
# file. Only greyscale and no ICC profile, until E2 and E4.
declare encoder.open ( str i32 i32 i32 i32 i32 str -- encoder )

# Code block column bx of the buffered MCU row.
declare encoder.block ( encoder i32 -- )

# Code every block of the buffered MCU row; the buffer is then empty.
declare encoder.mcu-row ( encoder -- )

# One image row of exactly width samples, top to bottom; a full MCU row is
# coded at once.
declare encoder.row ( encoder bytes -- )

# End the scan: code the last, partial MCU row with its bottom rows
# replicated, flush the bits and write EOI; the output stays open. Fewer
# rows than the height is a plain trap (libjpeg's JERR_TOO_LITTLE_DATA).
declare encoder.finish ( encoder -- )

# Finish, then close the output.
declare encoder.close ( encoder -- )

# An 8x8 encoder at a quality on a 4 KiB buffer with no file.
: fx.enc ( i32 -- encoder )  :> q  4096 fx.out 8 8 q encoder.on ;

# A quality and the hex of an 8x8 image: the whole file the encoder writes.
# The image is loaded straight into the MCU row buffer and its one block
# coded, so the eight rows count as received.
: fx.one ( i32 str -- bytes )
  :> img :> q
  q fx.enc :> e
  e encoder.buf 0  img hex bytes.as-str  bytes.put
  e 0 encoder.block
  e 8 encoder.y!
  e encoder.finish
  e encoder.o fx.taken ;

# tools/gen_ppm.py noise 8 8 1, and cjpeg -dct int -quality Q -sample 1x1
# -grayscale of it at q50 and q100; cjpeg of flat 77 at q50.
: fx.img8 ( -- str )  "f5b165224a58b791df6af1d8303e61cdc4bb86c3d1c427103c344c4189eb2f1e7bd5d47e446fcec2a3d811736110e5781bcccea696762e6116c6e9c92d99bf35" ;
: fx.ref8-q50 ( -- str )  "" ;
: fx.ref8-q100 ( -- str )  "" ;
: fx.ref-flat77-q50 ( -- str )  "" ;

test encoder.on : 85 fx.enc encoder.pw -> 8
test encoder.on : 85 fx.enc encoder.wb -> 1
test encoder.on : 85 fx.enc encoder.buf bytes.len -> 64
test encoder.on : 85 fx.enc encoder.o out.fill -> 328
test encoder.on : 4096 fx.out 17 3 85 encoder.on encoder.pw -> 24
test encoder.open : "/file/dev/null" 1 1 3 85 420 "" encoder.open encoder.w -> trap
test encoder.open : "/file/dev/null" 1 1 1 85 420 "/file/x.icc" encoder.open encoder.w -> trap
test encoder.block : 50 fx.img8 fx.one fx.ref8-q50 hex eq -> 1
test encoder.block : 100 fx.img8 fx.one fx.ref8-q100 hex eq -> 1
test encoder.block : 50 "4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d" fx.one fx.ref-flat77-q50 hex eq -> 1

# Width, height, quality and the hex of an image: every row fed through
# encoder.row, then encoder.finish; the whole file.
: fx.feed ( i32 i32 i32 str -- bytes )
  :> img :> q :> h :> w
  img hex :> data
  8192 fx.out w h q encoder.on :> e
  h [ :> y  e  data y w i32.mul w bytes.slice  encoder.row ] times
  e encoder.finish
  e encoder.o fx.taken ;

# tools/gen_ppm.py noise W H SEED, and cjpeg -dct int -quality Q -sample 1x1
# -grayscale of it.
: fx.img9x3 ( -- str )  "38b4e652e44da7f2370d9e260e27136550a4a3a6d07f5c0c2f8b12" ;
: fx.ref9x3-q85 ( -- str )  "" ;
: fx.img1x1 ( -- str )  "3c" ;
: fx.ref1x1-q50 ( -- str )  "" ;
: fx.img3x17 ( -- str )  "d7a56d3cfcf9a44dc716691acdaba1b8a912646543c6977a5a43ac2753cf10173122071113bd120536abce666699a58c1affea" ;
: fx.ref3x17-q75 ( -- str )  "" ;
: fx.img17x9 ( -- str )  "" ;
: fx.ref17x9-q50 ( -- str )  "" ;

# A 9x3 encoder fed the first n rows of fx.img9x3, then finished.
: fx.feed9x3 ( i32 -- i32 )
  :> n
  fx.img9x3 hex :> data
  8192 fx.out 9 3 85 encoder.on :> e
  n [ :> y  e  data y 9 i32.mul 9 bytes.slice  encoder.row ] times
  e encoder.finish
  e encoder.o out.fill ;
test encoder.row : 9 3 85 fx.img9x3 fx.feed fx.ref9x3-q85 hex eq -> 1
test encoder.row : 1 1 50 fx.img1x1 fx.feed fx.ref1x1-q50 hex eq -> 1
test encoder.row : 3 17 75 fx.img3x17 fx.feed fx.ref3x17-q75 hex eq -> 1
test encoder.row : 17 9 50 fx.img17x9 fx.feed fx.ref17x9-q50 hex eq -> 1
test encoder.row : 2 fx.feed9x3 -> trap
test encoder.row : 4 fx.feed9x3 -> trap
test encoder.row : 3 fx.feed9x3 0 i32.gt_s -> 1
test encoder.row : 8192 fx.out 9 3 85 encoder.on 8 bytes.new encoder.row -> trap

: encoder.on ( out i32 i32 i32 -- encoder )
  :> q :> h :> w :> o
  w 7 i32.add 8 i32.div_s :> wb
  wb 8 i32.mul :> pw
  qtables.lum q qtables.scaled :> qt
  64 array.new ( array i32 ) :> blk
  o writer.soi
  o writer.app0
  o 0 qt writer.dqt
  o w h writer.sof0
  o 0x00 htables.dc-lum-bits htables.dc-lum-vals writer.dht
  o 0x10 htables.ac-lum-bits htables.ac-lum-vals writer.dht
  o writer.sos
  o  o 0 0 bitwriter.new  w h wb pw
  pw 8 i32.mul bytes.new
  blk
  qt qtables.natural htables.dc-lum htables.ac-lum
  0 0 0
  encoder.new ;

: encoder.open ( str i32 i32 i32 i32 i32 str -- encoder )
  :> icc :> sample :> q :> n :> h :> w :> path
  n 1 i32.ne [ "E1: greyscale only" trap ] when
  icc str.len 0 i32.ne [ "E1: no ICC" trap ] when
  path out.open w h q encoder.on ;

: encoder.block ( encoder i32 -- )
  :> bx :> e
  e encoder.blk :> blk
  e encoder.buf :> buf
  e encoder.pw :> pw
  64
  [
    :> i
    blk i  buf  i 3 i32.shr_u pw i32.mul  bx 8 i32.mul i32.add  i 7 i32.and i32.add  bytes.at 128 i32.sub  array.at!
  ]
  times
  blk fdct.block
  blk e encoder.qt quantise.block
  e encoder.bw  e encoder.dct  e encoder.act  e encoder.nat  blk  e encoder.pred  huffenc.block
  e  blk 0 array.at  encoder.pred! ;

: encoder.mcu-row ( encoder -- )
  :> e
  e encoder.wb [ :> bx  e bx encoder.block ] times
  e 0 encoder.rows! ;

: encoder.row ( encoder bytes -- )
  :> row :> e
  e encoder.w :> w
  e encoder.pw :> pw
  e encoder.buf :> buf
  row bytes.len w i32.ne [ "row length" trap ] when
  e encoder.y e encoder.h i32.ge_s [ "too many rows" trap ] when
  e encoder.rows pw i32.mul :> base
  buf base row bytes.as-str bytes.put
  row w 1 i32.sub bytes.at :> last
  pw w i32.sub [ :> j  buf  base w i32.add j i32.add  last bytes.at! ] times
  e  e encoder.rows 1 i32.add  encoder.rows!
  e  e encoder.y 1 i32.add  encoder.y!
  e encoder.rows 8 i32.eq [ e encoder.mcu-row ] when ;

: encoder.finish ( encoder -- )
  :> e
  e encoder.y e encoder.h i32.ne [ "short image" trap ] when
  e encoder.rows :> held
  held 0 i32.gt_s
  [
    e encoder.pw :> pw
    e encoder.buf :> buf
    buf  held 1 i32.sub pw i32.mul  pw bytes.slice bytes.as-str :> lastrow
    8 held i32.sub [ :> k  buf  held k i32.add pw i32.mul  lastrow bytes.put ] times
    e encoder.mcu-row
  ]
  when
  e encoder.bw bitwriter.flush
  e encoder.o writer.eoi ;

: encoder.close ( encoder -- )
  :> e
  e encoder.finish
  e encoder.o out.close ;
