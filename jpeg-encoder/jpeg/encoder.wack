test encoder.open : "/file/dev/null" 1 1 2 85 420 "" encoder.open encoder.hs -> trap
test encoder.open : "/file/dev/null" 1 1 1 85 420 "/file/x.icc" encoder.open encoder.hs -> trap
test encoder.open : "/file/dev/null" 1 1 1 85 420 "/file/dev/null" encoder.open encoder.hs -> trap
test encoder.block : 50 fx.img8 fx.enc-one fx.ref8-q50 hex eq -> 1
test encoder.block : 100 fx.img8 fx.enc-one fx.ref8-q100 hex eq -> 1
test encoder.block : 50 "4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d" fx.enc-one fx.ref-flat77-q50 hex eq -> 1
# A luminance dummy: DC category 0 00, EOB 1010, pad 11: 0x2b, as cjpeg
# writes a flat-128 block.
test encoder.dummy : 85 fx.enc dup 0 encoder.dummy dup encoder.bw bitwriter.flush encoder.o fx.taken 328 bytes.at -> 0x2b
# A chrominance dummy: DC category 0 00 (K.4), EOB 00 (K.6), pad 1111: 0x0f.
test encoder.dummy : 8 8 2 2 85 fx.enc3 dup 1 encoder.dummy dup encoder.bw bitwriter.flush encoder.o fx.taken 623 bytes.at -> 0x0f
test encoder.row : 9 3 85 fx.img9x3 fx.feed fx.ref9x3-q85 hex eq -> 1
test encoder.row : 1 1 50 fx.img1x1 fx.feed fx.ref1x1-q50 hex eq -> 1
